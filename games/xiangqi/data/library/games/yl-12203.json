底攻杀，着法灵活有力。现又弃一炮，亦出乎黑方所料，如改走炮五退二，则车3退3，正中黑意。","source_line_id":"0","source_after_ply":25,"anchor_node_id":"0:25","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment33:0","source_tag":"DhtmlXQ_comment33","raw_text":"红胜。","text":"红胜。","source_line_id":"0","source_after_ply":33,"anchor_node_id":"0:33","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["062四川曾东平 先胜 农协赵新笑"],"DhtmlXQ_event":["第二章 顺手炮、列手炮(32局)"],"DhtmlXQ_open":["D26 顺炮直车对横车"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"],"DhtmlXQ_type":["实战全局/开局"]},"source_tag_count":14,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":33,"legal_move_records":33,"annotations":5,"annotation_statuses":{"attached":5}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第二章 顺手炮、列手炮 四川曾东平 先胜 农协赵新笑","catalogue_order":62,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-3.html"}],"book_ids":["yl-book-66"]}}
