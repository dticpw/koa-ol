final_legal_fen":"2b1kab2/4a4/n3c4/pr4p1p/2P6/3R5/P2cC1P1P/1C2B1N2/4A4/3K1AB2 b - - 2 19"}],"annotations":[{"id":"DhtmlXQ_comment8:0","source_tag":"DhtmlXQ_comment8","raw_text":"    双方由进兵对卒底炮转成顺手炮布局，现红平仕角炮是稳健的选择，较为流行的着法是马八进七，黑抢出左横车积极，欲控制红肋炮。","text":"    双方由进兵对卒底炮转成顺手炮布局，现红平仕角炮是稳健的选择，较为流行的着法是马八进七，黑抢出左横车积极，欲控制红肋炮。","source_line_id":"0","source_after_ply":8,"anchor_node_id":"0:8","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":"    红方针对黑阵特点，左马在右车的掩护下，跃起踏中卒，辅炮镇当头，着法简明有力，至此红已获满意的布局效果。","text":"    红方针对黑阵特点，左马在右车的掩护下，跃起踏中卒，辅炮镇当头，着法简明有力，至此红已获满意的布局效果。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment25:0","source_tag":"DhtmlXQ_comment25","raw_text":"    红方飞起左相已暗设左车抢肋的计谋，而黑方右炮过河抢中兵驱炮的算度显然是忽略了红的妙手，应改走炮2进7，虽中路受制，但有机会对攻，胜负尚在难料之数。||    如图形式，红方突然掉转炮口轰黑底车，准备弃炮抢肋，巧妙的制造“铁门闩”杀势，这是关键时刻抢占要道的绝妙之着。","text":"    红方飞起左相已暗设左车抢肋的计谋，而黑方右炮过河抢中兵驱炮的算度显然是忽略了红的妙手，应改走炮2进7，虽中路受制，但有机会对攻，胜负尚在难料之数。\n    如图形式，红方突然掉转炮口轰黑底车，准备弃炮抢肋，巧妙的制造“铁门闩”杀势，这是关键时刻抢占要道的绝妙之着。","source_line_id":"0","source_after_ply":25,"anchor_node_id":"0:25","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment26:0","source_tag":"DhtmlXQ_comment26","raw_text":"黑车只好委屈的避让，如改走炮2平5，红亦胜势，见变例。","text":"黑车只好委屈的避让，如改走炮2平5，红亦胜势，见变例。","source_line_id":"0","source_after_ply":26,"anchor_node_id":"0:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment35:0","source_tag":"DhtmlXQ_comment35","raw_text":"    红胜。||    红进车控制要路，黑几乎已成瘫痪状态，只能坐以待毙，遂推枰认输。||    短评：奇异的大胆设想再加上科学的推算，往往能创造出难以意料的绝妙着法，这类妙着在实战中常能取得上佳的效果。|| ||","text":"    红胜。\n    红进车控制要路，黑几乎已成瘫痪状态，只能坐以待毙，遂推枰认输。\n    短评：奇异的大胆设想再加上科学的推算，往往能创造出难以意料的绝妙着法，这类妙着在实战中常能取得上佳的效果。\n \n","source_line_id":"0","source_after_ply":35,"anchor_node_id":"0:35","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_37:0","source_tag":"DhtmlXQ_comment1_37","raw_text":"红亦胜势。","text":"红亦胜势。","source_line_id":"1","source_after_ply":37,"anchor_node_id":"1:37","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["107河北阎文清 先胜 湖北刘振文"],"DhtmlXQ_event":["第四章 进兵局(8局)"],"DhtmlXQ_open":["E17 仙人指路转左中炮对卒底炮转顺炮"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":15,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":2,"structured_branches":1,"line_statuses":{"legal":2},"source_move_records":47,"legal_move_records":47,"annotations":6,"annotation_statuses":{"attached":6}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第四章 进兵局 河北阎文清 先胜 湖北刘振文","catalogue_order":98,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-5.html"}],"book_ids":["yl-book-66"]}}
