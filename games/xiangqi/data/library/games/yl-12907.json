,"path_plies":44,"final_legal_fen":"4kab2/4a4/4b3n/p3R1p2/8p/2P3P2/P3P3P/N2A4B/4K4/5r3 w - - 0 23"}],"annotations":[{"id":"DhtmlXQ_comment7:0","source_tag":"DhtmlXQ_comment7","raw_text":"红方先跃马屯边。","text":"红方先跃马屯边。","source_line_id":"0","source_after_ply":7,"anchor_node_id":"0:7","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment9:0","source_tag":"DhtmlXQ_comment9","raw_text":"再走正统的五七炮。","text":"再走正统的五七炮。","source_line_id":"0","source_after_ply":9,"anchor_node_id":"0:9","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"单提马对付五七炮，包二进二是一个最佳的方法。","text":"单提马对付五七炮，包二进二是一个最佳的方法。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment11:0","source_tag":"DhtmlXQ_comment11","raw_text":"如果红方车九平八驱包。","text":"如果红方车九平八驱包。","source_line_id":"0","source_after_ply":11,"anchor_node_id":"0:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":"则黑方包二平三，兑红方具有威力的七路炮。","text":"则黑方包二平三，兑红方具有威力的七路炮。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"如此局面容易导致和局，甚至有失先的感觉，因为黑方似乎多走一步卒三进一。","text":"如此局面容易导致和局，甚至有失先的感觉，因为黑方似乎多走一步卒三进一。","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_11:0","source_tag":"DhtmlXQ_comment1_11","raw_text":"红方为了保有先走之利，所以，大部分的情况不愿平车驱包。改以兵七进一，防止黑方兑炮。","text":"红方为了保有先走之利，所以，大部分的情况不愿平车驱包。改以兵七进一，防止黑方兑炮。","source_line_id":"1","source_after_ply":11,"anchor_node_id":"1:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_12:0","source_tag":"DhtmlXQ_comment1_12","raw_text":"黑方冷静的乘士，准备出贴身车。","text":"黑方冷静的乘士，准备出贴身车。","source_line_id":"1","source_after_ply":12,"anchor_node_id":"1:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_13:0","source_tag":"DhtmlXQ_comment1_13","raw_text":"红方出九路车抓包，以得先手之利。","text":"红方出九路车抓包，以得先手之利。","source_line_id":"1","source_after_ply":13,"anchor_node_id":"1:13","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_14:0","source_tag":"DhtmlXQ_comment1_14","raw_text":"黑方包三平七控制红方的三路马，兼使红方的七路炮功能大减。","text":"黑方包三平七控制红方的三路马，兼使红方的七路炮功能大减。","source_line_id":"1","source_after_ply":14,"anchor_node_id":"1:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_15:0","source_tag":"DhtmlXQ_comment1_15","raw_text":"红方进兵逼黑方以包兑马。","text":"红方进兵逼黑方以包兑马。","source_line_id":"1","source_after_ply":15,"anchor_node_id":"1:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_16:0","source_tag":"DhtmlXQ_comment1_16","raw_text":"一般以包兑马是黑方不利，但是，现在局面不一样，因为红方已经多走一步七路炮，所以，现在以包兑马，原来走的七路包等於是白走啦！","text":"一般以包兑马是黑方不利，但是，现在局面不一样，因为红方已经多走一步七路炮，所以，现在以包兑马，原来走的七路包等於是白走啦！","source_line_id":"1","source_after_ply":16,"anchor_node_id":"1:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_18:0","source_tag":"DhtmlXQ_comment1_18","raw_text":"红方的七路炮当然比三路包的威力来的大，现在七路炮移到三路，黑方顺势出贴身车，红方原先挺进的三路兵与七路兵反而成为黑车攻击的目标，故黑方已经反先了。","text":"红方的七路炮当然比三路包的威力来的大，现在七路炮移到三路，黑方顺势出贴身车，红方原先挺进的三路兵与七路兵反而成为黑车攻击的目标，故黑方已经反先了。","source_line_id":"1","source_after_ply":18,"anchor_node_id":"1:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_20:0","source_tag":"DhtmlXQ_comment1_20","raw_text":"红方的三路马已经被兑掉啦！因此红方的五路兵没人看守为其弱点。","text":"红方的三路马已经被兑掉啦！因此红方的五路兵没人看守为其弱点。","source_line_id":"1","source_after_ply":20,"anchor_node_id":"1:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_21:0","source_tag":"DhtmlXQ_comment1_21","raw_text":"红方进车保兵必然。","text":"红方进车保兵必然。","source_line_id":"1","source_after_ply":21,"anchor_node_id":"1:21","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_22:0","source_tag":"DhtmlXQ_comment1_22","raw_text":"黑方顺势平包兑车，而明黑车。","text":"黑方顺势平包兑车，而明黑车。","source_line_id":"1","source_after_ply":22,"anchor_node_id":"1:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_23:0","source_tag":"DhtmlXQ_comment1_23","raw_text":"红方避开兑车不得已。","text":"红方避开兑车不得已。","source_line_id":"1","source_after_ply":23,"anchor_node_id":"1:23","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_24:0","source_tag":"DhtmlXQ_comment1_24","raw_text":"红方被兑掉三路马，不但中路兵没人防守，连三路及七路兵都容易受攻，","text":"红方被兑掉三路马，不但中路兵没人防守，连三路及七路兵都容易受攻，","source_line_id":"1","source_after_ply":24,"anchor_node_id":"1:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_25:0","source_tag":"DhtmlXQ_comment1_25","raw_text":"飞象保兵也是不得已。","text":"飞象保兵也是不得已。","source_line_id":"1","source_after_ply":25,"anchor_node_id":"1:25","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_26:0","source_tag":"DhtmlXQ_comment1_26","raw_text":"黑方再退八路车，一进一退的目的是逼红方的三路象跑到一路来，这样将来比较容易攻击。","text":"黑方再退八路车，一进一退的目的是逼红方的三路象跑到一路来，这样将来比较容易攻击。","source_line_id":"1","source_after_ply":26,"anchor_node_id":"1:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_28:0","source_tag":"DhtmlXQ_comment1_28","raw_text":"通活九路马，单提马的九路马，如果加入进攻行列，单提马的布局就成功啦！","text":"通活九路马，单提马的九路马，如果加入进攻行列，单提马的布局就成功啦！","source_line_id":"1","source_after_ply":28,"anchor_node_id":"1:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_29:0","source_tag":"DhtmlXQ_comment1_29","raw_text":"红方炮打中兵的目的是希望多兵胜。","text":"红方炮打中兵的目的是希望多兵胜。","source_line_id":"1","source_after_ply":29,"anchor_node_id":"1:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_31:0","source_tag":"DhtmlXQ_comment1_31","raw_text":"看起来红方是多兵啦！但这个时候，黑方有攻击的手段啦！","text":"看起来红方是多兵啦！但这个时候，黑方有攻击的手段啦！","source_line_id":"1","source_after_ply":31,"anchor_node_id":"1:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_32:0","source_tag":"DhtmlXQ_comment1_32","raw_text":"黑方进车抓炮，造成强大的攻势，如果，当初红方的相还在三路时，就没有这一步抓炮的棋啦！因为红方只要相三进五，黑方就失先了。如今，红方的相在一路，才有进车抓炮的棋，可见当初黑方八路车一进一退，在逼红方三路相飞到一路来，是有其深远目的的。","text":"黑方进车抓炮，造成强大的攻势，如果，当初红方的相还在三路时，就没有这一步抓炮的棋啦！因为红方只要相三进五，黑方就失先了。如今，红方的相在一路，才有进车抓炮的棋，可见当初黑方八路车一进一退，在逼红方三路相飞到一路来，是有其深远目的的。","source_line_id":"1","source_after_ply":32,"anchor_node_id":"1:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_33:0","source_tag":"DhtmlXQ_comment1_33","raw_text":"移炮到中央，是仅此一著。","text":"移炮到中央，是仅此一著。","source_line_id":"1","source_after_ply":33,"anchor_node_id":"1:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_34:0","source_tag":"DhtmlXQ_comment1_34","raw_text":"黑方逼红炮移到中央，再炮打红仕，是惊人的妙著！||如果炮还没有平到中央，黑包打红仕是不能成立的。因为红方这步棋可以炮三退二防守，黑方攻势就没有这麽凌厉啦！所以黑方先进车抓炮。等红方平炮中路之後，再炮打红仕。","text":"黑方逼红炮移到中央，再炮打红仕，是惊人的妙著！\n如果炮还没有平到中央，黑包打红仕是不能成立的。因为红方这步棋可以炮三退二防守，黑方攻势就没有这麽凌厉啦！所以黑方先进车抓炮。等红方平炮中路之後，再炮打红仕。","source_line_id":"1","source_after_ply":34,"anchor_node_id":"1:34","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_36:0","source_tag":"DhtmlXQ_comment1_36","raw_text":"平车抓仕","text":"平车抓仕","source_line_id":"1","source_after_ply":36,"anchor_node_id":"1:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_39:0","source_tag":"DhtmlXQ_comment1_39","raw_text":"到这里为止，红方都是单行道。","text":"到这里为止，红方都是单行道。","source_line_id":"1","source_after_ply":39,"anchor_node_id":"1:39","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_40:0","source_tag":"DhtmlXQ_comment1_40","raw_text":"以车吃炮，又是惊人之手段！","text":"以车吃炮，又是惊人之手段！","source_line_id":"1","source_after_ply":40,"anchor_node_id":"1:40","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_44:0","source_tag":"DhtmlXQ_comment1_44","raw_text":"局面到此，由於红方九路马会受制於黑车，而黑方九路马出路灵活自由，虽然红方多兵，但黑车控制力强随时可以消灭红兵，且红方士相不全，故局面黑方优势。","text":"局面到此，由於红方九路马会受制於黑车，而黑方九路马出路灵活自由，虽然红方多兵，但黑车控制力强随时可以消灭红兵，且红方士相不全，故局面黑方优势。","source_line_id":"1","source_after_ply":44,"anchor_node_id":"1:44","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["九、单提马对五七炮局"],"DhtmlXQ_event":["第2节 单提马应当头炮 第六章"],"DhtmlXQ_open":["B10 中炮对单提马"],"DhtmlXQ_remark":["吴贵临"],"DhtmlXQ_author":["陈勇"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":39,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":2,"structured_branches":1,"line_statuses":{"legal":2},"source_move_records":48,"legal_move_records":48,"annotations":30,"annotation_statuses":{"attached":30}},"memberships":[{"book_id":"yl-book-65","category_id":"65","title":"第六章 第2节 单提马应当头炮 九、单提马对五七炮局","catalogue_order":161,"directory_url":"https://m.xiangqiqipu.com/Category/List-65-7.html"}],"book_ids":["yl-book-65"]}}
