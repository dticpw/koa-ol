"0:28","0:29","0:30","0:31","0:32","0:33","0:34","0:35","0:36","0:37","0:38","0:39","0:40","0:41","0:42","0:43","0:44","0:45","0:46","0:47","0:48","0:49","0:50","0:51","0:52","0:53","0:54"],"first_failure":null,"last_legal_node_id":"0:54","path_plies":54,"final_legal_fen":"2baka3/9/4b4/p3p3p/3P5/6P2/P4c2P/3ANn3/4N4/1RBA1KR2 w - - 3 28"}],"annotations":[{"id":"DhtmlXQ_comment18:0","source_tag":"DhtmlXQ_comment18","raw_text":"以上是顺炮直车对横车中著名的“天马行空”变例，曾风行一时。现红方补右士被黑方抢占肋道，显得呆滞，不如车九进一较为灵活有力。黑车9平6窥视红方要道和“穴位”，及时。","text":"以上是顺炮直车对横车中著名的“天马行空”变例，曾风行一时。现红方补右士被黑方抢占肋道，显得呆滞，不如车九进一较为灵活有力。黑车9平6窥视红方要道和“穴位”，及时。","source_line_id":"0","source_after_ply":18,"anchor_node_id":"0:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment20:0","source_tag":"DhtmlXQ_comment20","raw_text":"黑车压相腰，含迅速反击之意，也可走车6进5。","text":"黑车压相腰，含迅速反击之意，也可走车6进5。","source_line_id":"0","source_after_ply":20,"anchor_node_id":"0:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment22:0","source_tag":"DhtmlXQ_comment22","raw_text":"红急于摆脱而退炮驱车，实属误着，应炮五进五，以下象3进5，车三退二，较为易走。黑弃马换炮，打乱了红方的防御体系，出乎红的意料之外。","text":"红急于摆脱而退炮驱车，实属误着，应炮五进五，以下象3进5，车三退二，较为易走。黑弃马换炮，打乱了红方的防御体系，出乎红的意料之外。","source_line_id":"0","source_after_ply":22,"anchor_node_id":"0:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment28:0","source_tag":"DhtmlXQ_comment28","raw_text":"黑车左右逢源，红已叫苦不迭，现再起右横车助战，谋求攻击红方空虚的右翼，方向明确。","text":"黑车左右逢源，红已叫苦不迭，现再起右横车助战，谋求攻击红方空虚的右翼，方向明确。","source_line_id":"0","source_after_ply":28,"anchor_node_id":"0:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment35:0","source_tag":"DhtmlXQ_comment35","raw_text":"黑进炮骑河选点上佳，伏炮2平5和炮2平8两处好点，红方四处起火，以兵阻炮不过是杯水车薪。","text":"黑进炮骑河选点上佳，伏炮2平5和炮2平8两处好点，红方四处起火，以兵阻炮不过是杯水车薪。","source_line_id":"0","source_after_ply":35,"anchor_node_id":"0:35","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment40:0","source_tag":"DhtmlXQ_comment40","raw_text":"车藏炮后，暗伏杀着，甚为巧妙。","text":"车藏炮后，暗伏杀着，甚为巧妙。","source_line_id":"0","source_after_ply":40,"anchor_node_id":"0:40","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment42:0","source_tag":"DhtmlXQ_comment42","raw_text":"此时形势，黑方进马巧妙，不仅伏有马7进6的凶着，而且具有诱使红马七退五入瓮的意味，是迅速入局的妙着。黑已布下天罗地网，红在实战中接走马七退五，被黑以弃车杀着速胜。但如改走它着，亦是在劫难逃。","text":"此时形势，黑方进马巧妙，不仅伏有马7进6的凶着，而且具有诱使红马七退五入瓮的意味，是迅速入局的妙着。黑已布下天罗地网，红在实战中接走马七退五，被黑以弃车杀着速胜。但如改走它着，亦是在劫难逃。","source_line_id":"0","source_after_ply":42,"anchor_node_id":"0:42","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment54:0","source_tag":"DhtmlXQ_comment54","raw_text":"黑胜。","text":"黑胜。","source_line_id":"0","source_after_ply":54,"anchor_node_id":"0:54","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["沈阳薛家语 先负 沈阳黄成俊"],"DhtmlXQ_event":["第二章 顺手炮、列手炮(32局)"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":13,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":54,"legal_move_records":54,"annotations":8,"annotation_statuses":{"attached":8}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第二章 顺手炮、列手炮 沈阳薛家语 先负 沈阳黄成俊","catalogue_order":57,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-3.html"}],"book_ids":["yl-book-66"]}}
