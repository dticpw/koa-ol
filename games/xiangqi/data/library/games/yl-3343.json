akab2/3r5/nc4n2/2p1p1R1p/p8/9/P1P1N1P1P/2N1C4/9/R1BAKAB2 b - - 0 9"}],"annotations":[{"id":"DhtmlXQ_comment0:0","source_tag":"DhtmlXQ_comment0","raw_text":"《弈林新编》杨官璘编著","text":"《弈林新编》杨官璘编著","source_line_id":"0","source_after_ply":0,"anchor_node_id":"root","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment8:0","source_tag":"DhtmlXQ_comment8","raw_text":"1。这一着的作用，一般来说活通已方马路，兼制对方马头，但现在红方还没有出边马  ，而黑方已经先走卒1进1，这样，则以后红方的左马可以不进九路，因此黑方的卒l进1，其作用就会减少。总的来说，卒1进1是软弱之着。不如改走车9平4，或马2进3，或卒3进1，都比较适当。","text":"1。这一着的作用，一般来说活通已方马路，兼制对方马头，但现在红方还没有出边马  ，而黑方已经先走卒1进1，这样，则以后红方的左马可以不进九路，因此黑方的卒l进1，其作用就会减少。总的来说，卒1进1是软弱之着。不如改走车9平4，或马2进3，或卒3进1，都比较适当。","source_line_id":"0","source_after_ply":8,"anchor_node_id":"0:8","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment11:0","source_tag":"DhtmlXQ_comment11","raw_text":"2。正着，准备用连环马进攻，红有玫势。","text":"2。正着，准备用连环马进攻，红有玫势。","source_line_id":"0","source_after_ply":11,"anchor_node_id":"0:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"3。如改走炮5进3去兵，则马三进五，炮5进2去炮，炮八平五去炮，红方大占优势。","text":"3。如改走炮5进3去兵，则马三进五，炮5进2去炮，炮八平五去炮，红方大占优势。","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"4。如改走炮5进2去兵，则马七进五，炮5进3去炮，车三进一去马，红方大占优势。","text":"4。如改走炮5进2去兵，则马七进五，炮5进3去炮，车三进一去马，红方大占优势。","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment23:0","source_tag":"DhtmlXQ_comment23","raw_text":"5。威胁黑车，并巩固中路，以免连环马受黑方中炮的牵制，稳健之着。","text":"5。威胁黑车，并巩固中路，以免连环马受黑方中炮的牵制，稳健之着。","source_line_id":"0","source_after_ply":23,"anchor_node_id":"0:23","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment26:0","source_tag":"DhtmlXQ_comment26","raw_text":"6。如改走炮3进3去炮，则车三进一去马，亦红方胜定。","text":"6。如改走炮3进3去炮，则车三进一去马，亦红方胜定。","source_line_id":"0","source_after_ply":26,"anchor_node_id":"0:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment33:0","source_tag":"DhtmlXQ_comment33","raw_text":"红胜。(图二二Ｏ〕    ||末后如图形势，两车相遇，黑车如果逃走，则红方跃马至卧槽即胜。如红方车6退2去车，则马三进四去车，马6进7，炮八平三去马，红方得子得势，亦胜定。","text":"红胜。(图二二Ｏ〕    \n末后如图形势，两车相遇，黑车如果逃走，则红方跃马至卧槽即胜。如红方车6退2去车，则马三进四去车，马6进7，炮八平三去马，红方得子得势，亦胜定。","source_line_id":"0","source_after_ply":33,"anchor_node_id":"0:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_27:0","source_tag":"DhtmlXQ_comment1_27","raw_text":"亦红方胜定。","text":"亦红方胜定。","source_line_id":"1","source_after_ply":27,"anchor_node_id":"1:27","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_19:0","source_tag":"DhtmlXQ_comment2_19","raw_text":"红方大占优势。","text":"红方大占优势。","source_line_id":"2","source_after_ply":19,"anchor_node_id":"2:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_17:0","source_tag":"DhtmlXQ_comment3_17","raw_text":"红方大占优势。","text":"红方大占优势。","source_line_id":"3","source_after_ply":17,"anchor_node_id":"3:17","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_pver":["091016"],"DhtmlXQ_viewurl":["?owner=u&id=69732&f=&isSave="],"DhtmlXQ_adddate":["2008-2-24 22:50:00"],"DhtmlXQ_editdate":["2008-2-24 22:50:00"],"DhtmlXQ_title":["第二局 顺炮直车对横车"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"],"DhtmlXQ_firstnum":["0"],"DhtmlXQ_length":["0"],"DhtmlXQ_type":["全局"],"DhtmlXQ_gametype":["慢棋"],"DhtmlXQ_open":[""],"DhtmlXQ_class":["象棋谱大全-现代棋书专集"],"DhtmlXQ_event":["弈林新编-杨官璘著"],"DhtmlXQ_group":[""],"DhtmlXQ_round":["8.对局评注"],"DhtmlXQ_table":[""],"DhtmlXQ_date":["1952年9月22日"],"DhtmlXQ_place":["上海"],"DhtmlXQ_timerule":[""],"DhtmlXQ_red":["杨官璘"],"DhtmlXQ_redeng":[""],"DhtmlXQ_redrating":[""],"DhtmlXQ_redtime":[""],"DhtmlXQ_black":["林弈仙"],"DhtmlXQ_blackeng":[""],"DhtmlXQ_blackrating":[""],"DhtmlXQ_blacktime":[""],"DhtmlXQ_result":["红胜"],"DhtmlXQ_endtype":[""],"DhtmlXQ_remark":["杨官璘