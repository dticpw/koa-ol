15","0:16","0:17","0:18","0:19","0:20","0:21","0:22","0:23","0:24","0:25","0:26","0:27","0:28","0:29","0:30","0:31","0:32","0:33","0:34","0:35","0:36","0:37","0:38","0:39","0:40","0:41","0:42","0:43","0:44","0:45","0:46"],"first_failure":null,"last_legal_node_id":"0:46","path_plies":46,"final_legal_fen":"3ak2r1/4a4/4b4/4pR2p/2p4c1/5NCR1/2P5P/2n6/2Nr5/1cBAKAB2 w - - 4 24"}],"annotations":[{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"此时黑炮骑河打车，含有试敌应手并破坏对方战略部署的意图，着法比较积极。另如改走炮2进5，则车四退二，卒3进1，炮五退一，卒3平4，车二进二，红先。","text":"此时黑炮骑河打车，含有试敌应手并破坏对方战略部署的意图，着法比较积极。另如改走炮2进5，则车四退二，卒3进1，炮五退一，卒3平4，车二进二，红先。","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment32:0","source_tag":"DhtmlXQ_comment32","raw_text":"红冲中兵过急，可先走仕四进五巩固中路。黑弃7路卒是适时的好棋，可趁机进行反击。","text":"红冲中兵过急，可先走仕四进五巩固中路。黑弃7路卒是适时的好棋，可趁机进行反击。","source_line_id":"0","source_after_ply":32,"anchor_node_id":"0:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment33:0","source_tag":"DhtmlXQ_comment33","raw_text":"如改走兵五进一，则马7进5，兵三进一（车四平五，马1进3，得车），车4平8，马三进二，马5进7，大致均势。","text":"如改走兵五进一，则马7进5，兵三进一（车四平五，马1进3，得车），车4平8，马三进二，马5进7，大致均势。","source_line_id":"0","source_after_ply":33,"anchor_node_id":"0:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment36:0","source_tag":"DhtmlXQ_comment36","raw_text":"红炮三进三疏漏之着，应走车二平三，局势尚无大碍。||此时形势，黑方弃马搏兵，着法精妙，由此反夺主动，展开攻势。","text":"红炮三进三疏漏之着，应走车二平三，局势尚无大碍。\n此时形势，黑方弃马搏兵，着法精妙，由此反夺主动，展开攻势。","source_line_id":"0","source_after_ply":36,"anchor_node_id":"0:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment39:0","source_tag":"DhtmlXQ_comment39","raw_text":"红应改走车四退一，以下车4平6，炮五进五，象3进5，马三进四，车8平7（车8平6，炮三退一），黑方仍占先手，但缺一象，有所顾忌。","text":"红应改走车四退一，以下车4平6，炮五进五，象3进5，马三进四，车8平7（车8平6，炮三退一），黑方仍占先手，但缺一象，有所顾忌。","source_line_id":"0","source_after_ply":39,"anchor_node_id":"0:39","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment41:0","source_tag":"DhtmlXQ_comment41","raw_text":"最后的败着，应走马四进六，以下车4退4，车四平六，炮8平5，仕六进五，车8进5，车六退一，尚属均势。","text":"最后的败着，应走马四进六，以下车4退4，车四平六，炮8平5，仕六进五，车8进5，车六退一，尚属均势。","source_line_id":"0","source_after_ply":41,"anchor_node_id":"0:41","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment46:0","source_tag":"DhtmlXQ_comment46","raw_text":"黑胜。||黑方进马沉炮叫杀，必得车胜定。||短评：此局黑方中局突出妙手，反夺主动。红因一误再误，终成败局。黑马7进6再炮2进1的构思，值得借鉴。","text":"黑胜。\n黑方进马沉炮叫杀，必得车胜定。\n短评：此局黑方中局突出妙手，反夺主动。红因一误再误，终成败局。黑马7进6再炮2进1的构思，值得借鉴。","source_line_id":"0","source_after_ply":46,"anchor_node_id":"0:46","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["四川蒋全胜 先负 广西黄世清"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_open":["C78 五七炮互进三兵对屏风马边卒右马外盘河"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":15,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":46,"legal_move_records":46,"annotations":7,"annotation_statuses":{"attached":7}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第一章 中炮对屏风马类 四川蒋全胜 先负 广西黄世清","catalogue_order":46,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-2.html"}],"book_ids":["yl-book-66"]}}
