:10","0:11","0:12","0:13","0:14","1:15","1:16","2:17","2:18","3:19","3:20","3:21","3:22"],"first_failure":null,"last_legal_node_id":"3:22","path_plies":22,"final_legal_fen":"3rkab1r/4a4/2n1bcR2/p1c1p3p/6p2/1Cp6/P3P1P1P/2N1C1N2/9/R1BAKAB2 w - - 2 12"}],"annotations":[{"id":"DhtmlXQ_comment7:0","source_tag":"DhtmlXQ_comment7","raw_text":"红方这一步棋，是一步关键的棋，这一步棋红方七兵，就布成当头炮七兵局。","text":"红方这一步棋，是一步关键的棋，这一步棋红方七兵，就布成当头炮七兵局。","source_line_id":"0","source_after_ply":7,"anchor_node_id":"0:7","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment8:0","source_tag":"DhtmlXQ_comment8","raw_text":"黑方也以进七卒以为应对，在这边要特别说明的反攻马的七卒挺进很重要，因为七卒挺进之後，反攻马的七路马才能够灵活，这是一个重点，希望各位玩家要记得！","text":"黑方也以进七卒以为应对，在这边要特别说明的反攻马的七卒挺进很重要，因为七卒挺进之後，反攻马的七路马才能够灵活，这是一个重点，希望各位玩家要记得！","source_line_id":"0","source_after_ply":8,"anchor_node_id":"0:8","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"一般马局应当头炮，当红方马八进七的时候，黑方大部分以象三进五应对。因为这个时候飞象最能够以静制动。","text":"一般马局应当头炮，当红方马八进七的时候，黑方大部分以象三进五应对。因为这个时候飞象最能够以静制动。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment11:0","source_tag":"DhtmlXQ_comment11","raw_text":"红方既进七兵，当然就要跃七马。","text":"红方既进七兵，当然就要跃七马。","source_line_id":"0","source_after_ply":11,"anchor_node_id":"0:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":"黑方再乘士，马上可以出贴身车。","text":"黑方再乘士，马上可以出贴身车。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment13:0","source_tag":"DhtmlXQ_comment13","raw_text":"红方再进二路车，以支援盘河马。","text":"红方再进二路车，以支援盘河马。","source_line_id":"0","source_after_ply":13,"anchor_node_id":"0:13","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"黑方出贴身车必然。","text":"黑方出贴身车必然。","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment15:0","source_tag":"DhtmlXQ_comment15","raw_text":"这个时候，红方的盘河马不能随便吃黑方的三路卒或五路卒，要进炮巡河来防守，红方如果不进炮保马，而以马六进七，则黑方的贴身车变成先手利，黑方贴身车的威力很大，或进车抓红方的八路炮，或马七进六跳出反攻马威胁红方二路车，布局到这里黑方很自然的反先啦！","text":"这个时候，红方的盘河马不能随便吃黑方的三路卒或五路卒，要进炮巡河来防守，红方如果不进炮保马，而以马六进七，则黑方的贴身车变成先手利，黑方贴身车的威力很大，或进车抓红方的八路炮，或马七进六跳出反攻马威胁红方二路车，布局到这里黑方很自然的反先啦！","source_line_id":"0","source_after_ply":15,"anchor_node_id":"0:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_15:0","source_tag":"DhtmlXQ_comment1_15","raw_text":"所以红方不能示弱，要进炮保马，将来伺机会炮五平六封车，这样黑方贴身车的功能才会减弱。","text":"所以红方不能示弱，要进炮保马，将来伺机会炮五平六封车，这样黑方贴身车的功能才会减弱。","source_line_id":"1","source_after_ply":15,"anchor_node_id":"1:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_16:0","source_tag":"DhtmlXQ_comment1_16","raw_text":"这一步炮二进一是反攻马布局的灵魂，尤其在应付过河车的攻势，这一步棋常常被使用到，玩家要谨记。","text":"这一步炮二进一是反攻马布局的灵魂，尤其在应付过河车的攻势，这一步棋常常被使用到，玩家要谨记。","source_line_id":"1","source_after_ply":16,"anchor_node_id":"1:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_17:0","source_tag":"DhtmlXQ_comment1_17","raw_text":"如果红方这个时候平炮打车。","text":"如果红方这个时候平炮打车。","source_line_id":"1","source_after_ply":17,"anchor_node_id":"1:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_18:0","source_tag":"DhtmlXQ_comment1_18","raw_text":"黑方不要慌张，只要车四平三，就有反攻的力量。","text":"黑方不要慌张，只要车四平三，就有反攻的力量。","source_line_id":"1","source_after_ply":18,"anchor_node_id":"1:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_19:0","source_tag":"DhtmlXQ_comment1_19","raw_text":"红方再平二路车，抓黑方无根的七路马的时候。","text":"红方再平二路车，抓黑方无根的七路马的时候。","source_line_id":"1","source_after_ply":19,"anchor_node_id":"1:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_20:0","source_tag":"DhtmlXQ_comment1_20","raw_text":"黑方不进车保马，而进三路卒弃马。","text":"黑方不进车保马，而进三路卒弃马。","source_line_id":"1","source_after_ply":20,"anchor_node_id":"1:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_22:0","source_tag":"DhtmlXQ_comment1_22","raw_text":"红方吃马不得已，黑方续进三路卒。","text":"红方吃马不得已，黑方续进三路卒。","source_line_id":"1","source_after_ply":22,"anchor_node_id":"1:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_23:0","source_tag":"DhtmlXQ_comment1_23","raw_text":"红方退八路炮，随时准备平炮明九路车。","text":"红方退八路炮，随时准备平炮明九路车。","source_line_id":"1","source_after_ply":23,"anchor_node_id":"1:23","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_26:0","source_tag":"DhtmlXQ_comment1_26","raw_text":"当红方平炮射卒的时候。黑方马三进二，马守四路卒，包封九路车，黑方三路车又明，布局到这里，黑方布局优势非常的明显。","text":"当红方平炮射卒的时候。黑方马三进二，马守四路卒，包封九路车，黑方三路车又明，布局到这里，黑方布局优势非常的明显。","source_line_id":"1","source_after_ply":26,"anchor_node_id":"1:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_17:0","source_tag":"DhtmlXQ_comment2_17","raw_text":"所以说红方这个时後，平炮打车，功能没有想像中的大，那麽红方怎麽下呢？红方直接平车压黑方的七路马，保留当头炮的攻势。","text":"所以说红方这个时後，平炮打车，功能没有想像中的大，那麽红方怎麽下呢？红方直接平车压黑方的七路马，保留当头炮的攻势。","source_line_id":"2","source_after_ply":17,"anchor_node_id":"2:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_18:0","source_tag":"DhtmlXQ_comment2_18","raw_text":"黑方仍以弃马应对。","text":"黑方仍以弃马应对。","source_line_id":"2","source_after_ply":18,"anchor_node_id":"2:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_19:0","source_tag":"DhtmlXQ_comment2_19","raw_text":"如果这一步棋红方不吃马，而以马六进七会怎样呢？","text":"如果这一步棋红方不吃马，而以马六进七会怎样呢？","source_line_id":"2","source_after_ply":19,"anchor_node_id":"2:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_20:0","source_tag":"DhtmlXQ_comment2_20","raw_text":"变成黑方过河卒是先手利。","text":"变成黑方过河卒是先手利。","source_line_id":"2","source_after_ply":20,"anchor_node_id":"2:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_22:0","source_tag":"DhtmlXQ_comment2_22","raw_text":"红方退八路炮到任何一个位置，都会造成黑方进贴身车的先手利","text":"红方退八路炮到任何一个位置，都会造成黑方进贴身车的先手利","source_line_id":"2","source_after_ply":22,"anchor_node_id":"2:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_24:0","source_tag":"DhtmlXQ_comment2_24","raw_text":"这样黑方轻易的反先啦！","text":"这样黑方轻易的反先啦！","source_line_id":"2","source_after_ply":24,"anchor_node_id":"2:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_19:0","source_tag":"DhtmlXQ_comment3_19","raw_text":"所以红方这一步棋只能够吃马。","text":"所以红方这一步棋只能够吃马。","source_line_id":"3","source_after_ply":19,"anchor_node_id":"3:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_20:0","source_tag":"DhtmlXQ_comment3_20","raw_text":"黑方虽然弃马，但是马上又可以吃一子回来了，而红方三路车的位置相当不好，所以布局到这里，黑方布局成功。","text":"黑方虽然弃马，但是马上又可以吃一子回来了，而红方三路车的位置相当不好，所以布局到这里，黑方布局成功。","source_line_id":"3","source_after_ply":20,"anchor_node_id":"3:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_22:0","source_tag":"DhtmlXQ_comment3_22","raw_text":"黑方布局成功的原因在那里呢？我们再回头看看。红方表面上有过河车的攻势，也有跃马盘河的攻势，也有炮五平六打车的先手利，好像攻势非常猛烈，但是这些攻势都是假的，被黑方第8手的的包二进一完全瓦解啦！黑方进二路包之後，等於是瓦解了红方的全部攻势。二路包在这个位置，等於是遥控著红方过河的二路车。另外跃马盘河的这一苹六路马，因为平包打车有利有弊，平包打车之後红方就没有当头炮了，而黑方虽然需要避车，但是三路车和四路车各有不同的功能，所以平包打车的威力并不是很大。更进一步说红方的八路炮位置相当的不佳，而黑方每一颗子都有他无形反攻的力量，所以说布局失败有他的原因，布局成功有他的道理，请各位玩家自行体会其中的奥妙吧！","text":"黑方布局成功的原因在那里呢？我们再回头看看。红方表面上有过河车的攻势，也有跃马盘河的攻势，也有炮五平六打车的先手利，好像攻势非常猛烈，但是这些攻势都是假的，被黑方第8手的的包二进一完全瓦解啦！黑方进二路包之後，等於是瓦解了红方的全部攻势。二路包在这个位置，等於是遥控著红方过河的二路车。另外跃马盘河的这一苹六路马，因为平包打车有利有弊，平包打车之後红方就没有当头炮了，而黑方虽然需要避车，但是三路车和四路车各有不同的功能，所以平包打车的威力并不是很大。更进一步说红方的八路炮位置相当的不佳，而黑方每一颗子都有他无形反攻的力量，所以说布局失败有他的原因，布局成功有他的道理，请各位玩家自行体会其中的奥妙吧！","source_line_id":"3","source_after_ply":22,"anchor_node_id":"3:22","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["六、反攻马应当头炮进七兵过河车局"],"DhtmlXQ_event":["第2节 反宫马应当头炮篇 第五章"],"DhtmlXQ_open":["B31 中炮对反宫马"],"DhtmlXQ_remark":["吴贵临"],"DhtmlXQ_author":["陈勇"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":37,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":4,"structured_branches":3,"line_statuses":{"legal":4},"source_move_records":39,"legal_move_records":39,"annotations":26,"annotation_statuses":{"attached":26}},"memberships":[{"book_id":"yl-book-65","category_id":"65","title":"第五章 第2节 反宫马应当头炮篇 六、反攻马应当头炮进七兵过河车局","catalogue_order":140,"directory_url":"https://m.xiangqiqipu.com/Category/List-65-6.html"}],"book_ids":["yl-book-65"]}}
