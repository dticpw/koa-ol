6","0:37","0:38","0:39","0:40","0:41","0:42","0:43","0:44","0:45","0:46","0:47","0:48","0:49","0:50","0:51","0:52","0:53","0:54","0:55","0:56","0:57","0:58","0:59","0:60","0:61","0:62","0:63","0:64","0:65"],"first_failure":null,"last_legal_node_id":"0:65","path_plies":65,"final_legal_fen":"2b3c2/3k5/3C1r3/p8/6b1p/c1p6/3R4P/4C3N/9/2BAKAB2 b - - 0 33"}],"annotations":[{"id":"DhtmlXQ_comment4:0","source_tag":"DhtmlXQ_comment4","raw_text":"互走金钩炮纯属即兴之作，意在较量临局审时度势的能力。现在双方都有一侧子力壅塞，能否处理得当将是布局成败的关键。","text":"互走金钩炮纯属即兴之作，意在较量临局审时度势的能力。现在双方都有一侧子力壅塞，能否处理得当将是布局成败的关键。","source_line_id":"0","source_after_ply":4,"anchor_node_id":"0:4","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"这几步双方都在尽快舒展壅塞一侧的子力。","text":"这几步双方都在尽快舒展壅塞一侧的子力。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment11:0","source_tag":"DhtmlXQ_comment11","raw_text":"进车作用不大，改走炮二进四继续舒展右翼子力较好。","text":"进车作用不大，改走炮二进四继续舒展右翼子力较好。","source_line_id":"0","source_after_ply":11,"anchor_node_id":"0:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"黑马穿宫而出，续有兑3卒及补士出车的运子路线，对比之下红方右翼的马炮略显呆滞，已有失先之感。","text":"黑马穿宫而出，续有兑3卒及补士出车的运子路线，对比之下红方右翼的马炮略显呆滞，已有失先之感。","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment17:0","source_tag":"DhtmlXQ_comment17","raw_text":"希望吃掉中卒获得物质上的优势，以求抗衡。","text":"希望吃掉中卒获得物质上的优势，以求抗衡。","source_line_id":"0","source_after_ply":17,"anchor_node_id":"0:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment18:0","source_tag":"DhtmlXQ_comment18","raw_text":"兑卒好棋！","text":"兑卒好棋！","source_line_id":"0","source_after_ply":18,"anchor_node_id":"0:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":"弃兵抢攻，如兵七进一，马4进3，马七进六，马1进3，黑方子力舒展，红方不肯。","text":"弃兵抢攻，如兵七进一，马4进3，马七进六，马1进3，黑方子力舒展，红方不肯。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment28:0","source_tag":"DhtmlXQ_comment28","raw_text":"这一段交锋红方无机可乘，黑方多卒占优。","text":"这一段交锋红方无机可乘，黑方多卒占优。","source_line_id":"0","source_after_ply":28,"anchor_node_id":"0:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment29:0","source_tag":"DhtmlXQ_comment29","raw_text":"红方这一步退炮再平炮真是煞费苦心！","text":"红方这一步退炮再平炮真是煞费苦心！","source_line_id":"0","source_after_ply":29,"anchor_node_id":"0:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment30:0","source_tag":"DhtmlXQ_comment30","raw_text":"打卒当然，否则红兵三进一了。","text":"打卒当然，否则红兵三进一了。","source_line_id":"0","source_after_ply":30,"anchor_node_id":"0:30","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment32:0","source_tag":"DhtmlXQ_comment32","raw_text":"出车正着，如惧怕红进炮压马走马4进3，马五退七，象5进3，车二进五，卒1进1，车二平七，局面缓和。","text":"出车正着，如惧怕红进炮压马走马4进3，马五退七，象5进3，车二进五，卒1进1，车二平七，局面缓和。","source_line_id":"0","source_after_ply":32,"anchor_node_id":"0:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment36:0","source_tag":"DhtmlXQ_comment36","raw_text":"进车过高估计红炮打兵的威力，可卒3进1对攻，黑方优势。","text":"进车过高估计红炮打兵的威力，可卒3进1对攻，黑方优势。","source_line_id":"0","source_after_ply":36,"anchor_node_id":"0:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment37:0","source_tag":"DhtmlXQ_comment37","raw_text":"试探黑方应手。","text":"试探黑方应手。","source_line_id":"0","source_after_ply":37,"anchor_node_id":"0:37","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment38:0","source_tag":"DhtmlXQ_comment38","raw_text":"黑方不肯兑车较量残局。","text":"黑方不肯兑车较量残局。","source_line_id":"0","source_after_ply":38,"anchor_node_id":"0:38","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment41:0","source_tag":"DhtmlXQ_comment41","raw_text":"进炮伺机平边构成天地炮之势威胁黑方。","text":"进炮伺机平边构成天地炮之势威胁黑方。","source_line_id":"0","source_after_ply":41,"anchor_node_id":"0:41","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment52:0","source_tag":"DhtmlXQ_comment52","raw_text":"在红方的屡次侵扰下，黑方终于应对失误，应改走车6平7捉马，红如仍走马三进四，士5退6，车二退三，炮1退1，车二平五，炮1平5，黑方仍占多卒之优。","text":"在红方的屡次侵扰下，黑方终于应对失误，应改走车6平7捉马，红如仍走马三进四，士5退6，车二退三，炮1退1，车二平五，炮1平5，黑方仍占多卒之优。","source_line_id":"0","source_after_ply":52,"anchor_node_id":"0:52","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment56:0","source_tag":"DhtmlXQ_comment56","raw_text":"再次失误败定！平车捉炮空着，应改走将5进1，车二平五，将5平6，还是胜负未定之局。","text":"再次失误败定！平车捉炮空着，应改走将5进1，车二平五，将5平6，还是胜负未定之局。","source_line_id":"0","source_after_ply":56,"anchor_node_id":"0:56","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment58:0","source_tag":"DhtmlXQ_comment58","raw_text":"如车9退2，车五进四，将5平4 ，车五平六，将4平5，马一进三，红方攻势强大，黑方难以抵挡。","text":"如车9退2，车五进四，将5平4 ，车五平六，将4平5，马一进三，红方攻势强大，黑方难以抵挡。","source_line_id":"0","source_after_ply":58,"anchor_node_id":"0:58","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment63:0","source_tag":"DhtmlXQ_comment63","raw_text":"平炮好棋！","text":"平炮好棋！","source_line_id":"0","source_after_ply":63,"anchor_node_id":"0:63","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment65:0","source_tag":"DhtmlXQ_comment65","raw_text":"红胜","text":"红胜","source_line_id":"0","source_after_ply":65,"anchor_node_id":"0:65","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":[" 张锦荣 先胜 周德裕"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":24,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":65,"legal_move_records":65,"annotations":20,"annotation_statuses":{"attached":20}},"membership