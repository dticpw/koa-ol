ment34:0","source_tag":"DhtmlXQ_comment34","raw_text":"此时形势，黑接走平炮打车失误，形成交换后，红势大张。不如改走车2进1暂避一时，以屈求伸。","text":"此时形势，黑接走平炮打车失误，形成交换后，红势大张。不如改走车2进1暂避一时，以屈求伸。","source_line_id":"0","source_after_ply":34,"anchor_node_id":"0:34","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment39:0","source_tag":"DhtmlXQ_comment39","raw_text":"红中车吃卒后再退至兵线，运筹新的攻势，黑以难阻挡。","text":"红中车吃卒后再退至兵线，运筹新的攻势，黑以难阻挡。","source_line_id":"0","source_after_ply":39,"anchor_node_id":"0:39","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment47:0","source_tag":"DhtmlXQ_comment47","raw_text":"红胜。||红进马已成杀势，故黑认输。||短评：","text":"红胜。\n红进马已成杀势，故黑认输。\n短评：","source_line_id":"0","source_after_ply":47,"anchor_node_id":"0:47","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["黑龙江赵国荣 先胜 河北刘殿中"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_open":["C47 中炮过河车互进七兵对屏风马平炮兑车"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":13,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":47,"legal_move_records":47,"annotations":5,"annotation_statuses":{"attached":5}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第一章 中炮对屏风马,黑龙江赵国荣 先胜 河北刘殿中","catalogue_order":23,"directory_url":"https://m.xiangqiqipu.com/Category/list-66.html"}],"book_ids":["yl-book-66"]}}
