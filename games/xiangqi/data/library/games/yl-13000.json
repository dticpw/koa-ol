inal_legal_fen":"r2akab1r/9/1cn1bcn2/p1p1p2Rp/6p2/2P6/P3P1P1P/1CN1C1N2/9/R1BAKAB2 b - - 11 6"}],"annotations":[{"id":"DhtmlXQ_comment9:0","source_tag":"DhtmlXQ_comment9","raw_text":"布局到这里，跟前局完全一模一样，上一局黑方走象三进五，这一局我们来介绍当黑方跳马盘河时，有什麽变化呢？","text":"布局到这里，跟前局完全一模一样，上一局黑方走象三进五，这一局我们来介绍当黑方跳马盘河时，有什麽变化呢？","source_line_id":"0","source_after_ply":9,"anchor_node_id":"0:9","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"跳马盘河就是避免红方平车压马，另外，当然可以弃卒抢先。","text":"跳马盘河就是避免红方平车压马，另外，当然可以弃卒抢先。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment11:0","source_tag":"DhtmlXQ_comment11","raw_text":"红方车二平四是绝对的一著棋。","text":"红方车二平四是绝对的一著棋。","source_line_id":"0","source_after_ply":11,"anchor_node_id":"0:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":"这个时候，黑方很苦的是不能下马六进七。","text":"这个时候，黑方很苦的是不能下马六进七。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment13:0","source_tag":"DhtmlXQ_comment13","raw_text":"因为红方有炮五平七厉害的手段，次一著，当然要进七兵，攻溃黑方的阵容。","text":"因为红方有炮五平七厉害的手段，次一著，当然要进七兵，攻溃黑方的阵容。","source_line_id":"0","source_after_ply":13,"anchor_node_id":"0:13","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"假如黑方采取平包再跳窝心马，好像解开了红方的攻击，但是，此时红方的手段更厉害啦！","text":"假如黑方采取平包再跳窝心马，好像解开了红方的攻击，但是，此时红方的手段更厉害啦！","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment17:0","source_tag":"DhtmlXQ_comment17","raw_text":"红方可以进八路炮打中兵。","text":"红方可以进八路炮打中兵。","source_line_id":"0","source_after_ply":17,"anchor_node_id":"0:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment18:0","source_tag":"DhtmlXQ_comment18","raw_text":"黑方当然不能让红方炮打中兵。","text":"黑方当然不能让红方炮打中兵。","source_line_id":"0","source_after_ply":18,"anchor_node_id":"0:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":"红方可以再进七兵。","text":"红方可以再进七兵。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment21:0","source_tag":"DhtmlXQ_comment21","raw_text":"当黑方吃七路兵的时候，红方平炮叫将，黑方阵容就崩溃啦！","text":"当黑方吃七路兵的时候，红方平炮叫将，黑方阵容就崩溃啦！","source_line_id":"0","source_after_ply":21,"anchor_node_id":"0:21","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_12:0","source_tag":"DhtmlXQ_comment1_12","raw_text":"所以说，黑方不能马六进七，否则红方有一气呵成的攻击手段！那麽，这种布局黑方如果不能马六进七，这种布局基本上是失败的，黑方此时只能下马六进四。||下棋时尽量要避免毫无支援之下单马过河，目前黑方就是陷入这个泥沼，当红方平车抓马，黑方不得不马六进四，马六进四之後呢？黑方陷入单马过河的泥沼啦！","text":"所以说，黑方不能马六进七，否则红方有一气呵成的攻击手段！那麽，这种布局黑方如果不能马六进七，这种布局基本上是失败的，黑方此时只能下马六进四。\n下棋时尽量要避免毫无支援之下单马过河，目前黑方就是陷入这个泥沼，当红方平车抓马，黑方不得不马六进四，马六进四之後呢？黑方陷入单马过河的泥沼啦！","source_line_id":"1","source_after_ply":12,"anchor_node_id":"1:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_13:0","source_tag":"DhtmlXQ_comment1_13","raw_text":"红方退车抓马，逼黑方吃中炮，为什麽红方逼黑马吃中炮，红方就满意了呢？","text":"红方退车抓马，逼黑方吃中炮，为什麽红方逼黑马吃中炮，红方就满意了呢？","source_line_id":"1","source_after_ply":13,"anchor_node_id":"1:13","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_14:0","source_tag":"DhtmlXQ_comment1_14","raw_text":"在布局的时候，首重子力的出动。黑方已经走了四步的马，来兑才走两步的红炮，所以黑方吃亏了两步。","text":"在布局的时候，首重子力的出动。黑方已经走了四步的马，来兑才走两步的红炮，所以黑方吃亏了两步。","source_line_id":"1","source_after_ply":14,"anchor_node_id":"1:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_19:0","source_tag":"DhtmlXQ_comment1_19","raw_text":"双方重新调整阵容。","text":"双方重新调整阵容。","source_line_id":"1","source_after_ply":19,"anchor_node_id":"1:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_20:0","source_tag":"DhtmlXQ_comment1_20","raw_text":"黑方抢先出贴身车。","text":"黑方抢先出贴身车。","source_line_id":"1","source_after_ply":20,"anchor_node_id":"1:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_21:0","source_tag":"DhtmlXQ_comment1_21","raw_text":"黑方出了贴身车之後，一路卒没有人防守，所以红方平边炮。","text":"黑方出了贴身车之後，一路卒没有人防守，所以红方平边炮。","source_line_id":"1","source_after_ply":21,"anchor_node_id":"1:21","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_24:0","source_tag":"DhtmlXQ_comment1_24","raw_text":"布局到这里，我们做一个局势分析，双方子力的差别是马马炮对马包包的差别，目前这个局面，马马炮比较具有攻击手段，马包包防守有馀，攻击不足，所以红方子力略占优势，尤其现在轮红方下，红方有扩大先手之手段。","text":"布局到这里，我们做一个局势分析，双方子力的差别是马马炮对马包包的差别，目前这个局面，马马炮比较具有攻击手段，马包包防守有馀，攻击不足，所以红方子力略占优势，尤其现在轮红方下，红方有扩大先手之手段。","source_line_id":"1","source_after_ply":24,"anchor_node_id":"1:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_25:0","source_tag":"DhtmlXQ_comment1_25","raw_text":"平车兑车是一种扩大先手的手段，兑车之後，黑方的右侧就显得空虚。","text":"平车兑车是一种扩大先手的手段，兑车之後，黑方的右侧就显得空虚。","source_line_id":"1","source_after_ply":25,"anchor_node_id":"1:25","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_26:0","source_tag":"DhtmlXQ_comment1_26","raw_text":"黑方虽然可以不理。","text":"黑方虽然可以不理。","source_line_id":"1","source_after_ply":26,"anchor_node_id":"1:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_28:0","source_tag":"DhtmlXQ_comment1_28","raw_text":"但红方兑车之後，黑士仍然要退一步。","text":"但红方兑车之後，黑士仍然要退一步。","source_line_id":"1","source_after_ply":28,"anchor_node_id":"1:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_29:0","source_tag":"DhtmlXQ_comment1_29","raw_text":"红方跃马盘河，这一苹盘河马威风八面，是造成红方布局优势的主要原因，","text":"红方跃马盘河，这一苹盘河马威风八面，是造成红方布局优势的主要原因，","source_line_id":"1","source_after_ply":29,"anchor_node_id":"1:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_31:0","source_tag":"DhtmlXQ_comment1_31","raw_text":"当黑方平车吃卒红方跳马踩车。","text":"当黑方平车吃卒红方跳马踩车。","source_line_id":"1","source_after_ply":31,"anchor_node_id":"1:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_33:0","source_tag":"DhtmlXQ_comment1_33","raw_text":"再跳马准备卧槽。","text":"再跳马准备卧槽。","source_line_id":"1","source_after_ply":33,"anchor_node_id":"1:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_34:0","source_tag":"DhtmlXQ_comment1_34","raw_text":"因为红方有跳马叫将抽包，所以，黑方只好包一进四非常的无奈。","text":"因为红方有跳马叫将抽包，所以，黑方只好包一进四非常的无奈。","source_line_id":"1","source_after_ply":34,"anchor_node_id":"1:34","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_35:0","source_tag":"DhtmlXQ_comment1_35","raw_text":"黑方为了保包，任凭红马蹂躏。","text":"黑方为了保包，任凭红马蹂躏。","source_line_id":"1","source_after_ply":35,"anchor_node_id":"1:35","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_37:0","source_tag":"DhtmlXQ_comment1_37","raw_text":"红方又进车抓包，抢尽先手之利。","text":"红方又进车抓包，抢尽先手之利。","source_line_id":"1","source_after_ply":37,"anchor_node_id":"1:37","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_40:0","source_tag":"DhtmlXQ_comment1_40","raw_text":"黑方退包打马，仅此一著。","text":"黑方退包打马，仅此一著。","source_line_id":"1","source_after_ply":40,"anchor_node_id":"1:40","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_41:0","source_tag":"DhtmlXQ_comment1_41","raw_text":"红方进车抓马，又是厉害的一著。","text":"红方进车抓马，又是厉害的一著。","source_line_id":"1","source_after_ply":41,"anchor_node_id":"1:41","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_45:0","source_tag":"DhtmlXQ_comment1_45","raw_text":"局面到这里，红方占尽优势，黑方布局失败。","text":"局面到这里，红方占尽优势，黑方布局失败。","source_line_id":"1","source_after_ply":45,"anchor_node_id":"1:45","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_10:0","source_tag":"DhtmlXQ_comment2_10","raw_text":"所以说，在这个局面，黑方不能冒然的跃马盘河，还是象三进五，布局比较平稳。","text":"所以说，在这个局面，黑方不能冒然的跃马盘河，还是象三进五，布局比较平稳。","source_line_id":"2","source_after_ply":10,"anchor_node_id":"2:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_11:0","source_tag":"DhtmlXQ_comment2_11","raw_text":"至於象三进五的变化，请各位玩家参考前局的介绍，本局就介绍到这里，谢谢大家！","text":"至於象三进五的变化，请各位玩家参考前局的介绍，本局就介绍到这里，谢谢大家！","source_line_id":"2","source_after_ply":11,"anchor_node_id":"2:11","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["6.当头炮进七兵攻反攻马左马盘河局"],"DhtmlXQ_event":["第1节 当头炮攻反宫马 第五章"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":38,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":3,"structured_branches":2,"line_statuses":{"legal":3},"source_move_records":57,"legal_move_records":57,"annotations":31,"annotation_statuses":{"attached":31}},"memberships":[{"book_id":"yl-book-65","category_id":"65","title":"第五章 第1节 当头炮攻反宫马 6.当头炮进七兵攻反攻马左马盘河局","catalogue_order":132,"directory_url":"https://m.xiangqiqipu.com/Category/List-65-6.html"}],"book_ids":["yl-book-65"]}}
