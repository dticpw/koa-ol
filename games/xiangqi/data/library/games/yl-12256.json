:33","0:34","0:35","0:36","0:37","0:38","0:39"],"first_failure":null,"last_legal_node_id":"0:39","path_plies":39,"final_legal_fen":"2ba1k1r1/3ra4/4bP3/p6Cp/3nN4/9/P1c5P/B3C1N2/9/3AKABR1 b - - 2 20"}],"annotations":[{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":"以上是较为新颖的五八炮，黑亦可走马3进2。","text":"以上是较为新颖的五八炮，黑亦可走马3进2。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment22:0","source_tag":"DhtmlXQ_comment22","raw_text":"红挺中兵佳着，使黑河口马与过河双炮处于危险地带。黑平车保马必然，如走卒3进1，则车八平六，马4进2，车六退三，红优。","text":"红挺中兵佳着，使黑河口马与过河双炮处于危险地带。黑平车保马必然，如走卒3进1，则车八平六，马4进2，车六退三，红优。","source_line_id":"0","source_after_ply":22,"anchor_node_id":"0:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment31:0","source_tag":"DhtmlXQ_comment31","raw_text":"黑卒3进1急于对攻，疏于防范，恐是对局势的危险程度认识不足，应马7退6尚可一战。||此时形势，红弃车搏马逐鹿中原乃惊人之举，局势优劣立见分晓。","text":"黑卒3进1急于对攻，疏于防范，恐是对局势的危险程度认识不足，应马7退6尚可一战。\n此时形势，红弃车搏马逐鹿中原乃惊人之举，局势优劣立见分晓。","source_line_id":"0","source_after_ply":31,"anchor_node_id":"0:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment32:0","source_tag":"DhtmlXQ_comment32","raw_text":"黑弃炮叫将无奈，如走马4退2吃车，则炮五进五，将5平6，炮二平四，红胜更速。","text":"黑弃炮叫将无奈，如走马4退2吃车，则炮五进五，将5平6，炮二平四，红胜更速。","source_line_id":"0","source_after_ply":32,"anchor_node_id":"0:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment37:0","source_tag":"DhtmlXQ_comment37","raw_text":"红得势不饶人，俊骑趁势跃出，连踏两卒打通中路，直指对方王府，攻势锐不可挡。","text":"红得势不饶人，俊骑趁势跃出，连踏两卒打通中路，直指对方王府，攻势锐不可挡。","source_line_id":"0","source_after_ply":37,"anchor_node_id":"0:37","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment39:0","source_tag":"DhtmlXQ_comment39","raw_text":"红胜。||黑王陷入灭顶之灾，即使弃车亦无法解救。","text":"红胜。\n黑王陷入灭顶之灾，即使弃车亦无法解救。","source_line_id":"0","source_after_ply":39,"anchor_node_id":"0:39","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["陕西任建 先胜 农协李林"],"DhtmlXQ