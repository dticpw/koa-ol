0:8","0:9","0:10","0:11","0:12","0:13","0:14","0:15","0:16","0:17","0:18","0:19","0:20","0:21","0:22","0:23","0:24","0:25","0:26","0:27","0:28","0:29","0:30","0:31","0:32","0:33","0:34","0:35","0:36","0:37","0:38","0:39","0:40","0:41","0:42","0:43","0:44","0:45"],"first_failure":null,"last_legal_node_id":"0:45","path_plies":45,"final_legal_fen":"1r1akab2/4nR3/4b4/p3C3p/2p2cp2/4C1P2/P1P1P3P/N5N2/4Ar3/2BAK1B2 b - - 8 23"}],"annotations":[{"id":"DhtmlXQ_comment8:0","source_tag":"DhtmlXQ_comment8","raw_text":"    红进变马不落常套，别具一格，此着多走马八进七。黑起横车亦有另谋他途的意味，亦可改走马2进3。","text":"    红进变马不落常套，别具一格，此着多走马八进七。黑起横车亦有另谋他途的意味，亦可改走马2进3。","source_line_id":"0","source_after_ply":8,"anchor_node_id":"0:8","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment13:0","source_tag":"DhtmlXQ_comment13","raw_text":"    起左横车是胡特大喜用的着法，意在投入更多的兵力，攻击黑方左翼。此着如果改走车三进一吃马，则炮5进4，马三进五，炮2平7，红方得不偿失。","text":"    起左横车是胡特大喜用的着法，意在投入更多的兵力，攻击黑方左翼。此着如果改走车三进一吃马，则炮5进4，马三进五，炮2平7，红方得不偿失。","source_line_id":"0","source_after_ply":13,"anchor_node_id":"0:13","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment20:0","source_tag":"DhtmlXQ_comment20","raw_text":"    黑炮平肋是失势之着，此时红方围点打援的意图明显，所以黑方应走炮7平1，以下士四进五，车4退2，炮八平七，炮1进1，黑足可应付。","text":"    黑炮平肋是失势之着，此时红方围点打援的意图明显，所以黑方应走炮7平1，以下士四进五，车4退2，炮八平七，炮1进1，黑足可应付。","source_line_id":"0","source_after_ply":20,"anchor_node_id":"0:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"    此刻黑方有些被动，升炮驱车以稍减压力。","text":"    此刻黑方有些被动，升炮驱车以稍减压力。","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment28:0","source_tag":"DhtmlXQ_comment28","raw_text":"    由于黑方应着不慎，被红方通过攻击弱马而扩大了先手。||    如图形势，红平车虎口，绝妙之着，暗藏帅五平四杀棋。实战黑应以炮2进2，结果被红方迅速取胜。应改走炮4进1，保留2路炮的位置，以下车三平四，炮4平6，黑方尚可坚持。","text":"    由于黑方应着不慎，被红方通过攻击弱马而扩大了先手。\n    如图形势，红平车虎口，绝妙之着，暗藏帅五平四杀棋。实战黑应以炮2进2，结果被红方迅速取胜。应改走炮4进1，保留2路炮的位置，以下车三平四，炮4平6，黑方尚可坚持。","source_line_id":"0","source_after_ply":28,"anchor_node_id":"0:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment35:0","source_tag":"DhtmlXQ_comment35","raw_text":"    红方伸车、出帅、炮击中卒，次序极佳，现一车搏双巩固了中炮的威力，胜券在握。","text":"    红方伸车、出帅、炮击中卒，次序极佳，现一车搏双巩固了中炮的威力，胜券在握。","source_line_id":"0","source_after_ply":35,"anchor_node_id":"0:35","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment43:0","source_tag":"DhtmlXQ_comment43","raw_text":"    挺兵驱车活马，妙手，以下胜定。","text":"    挺兵驱车活马，妙手，以下胜定。","source_line_id":"0","source_after_ply":43,"anchor_node_id":"0:43","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment45:0","source_tag":"DhtmlXQ_comment45","raw_text":"以下黑车2进2，红兵三进一，黑方无子可动。   || 红胜。||","text":"以下黑车2进2，红兵三进一，黑方无子可动。   \n 红胜。\n","source_line_id":"0","source_after_ply":45,"anchor_node_id":"0:45","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["071上海胡荣华 先胜 河北李来群"],"DhtmlXQ_event":["第二章 顺手炮、列手炮(32局)"],"DhtmlXQ_open":["D11 顺炮直车对缓开车"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"],"DhtmlXQ_type":["实战全局/开局"]},"source_tag_count":15,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":45,"legal_move_records":45,"annotations":8,"annotation_statuses":{"attached":8}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第二章 顺手炮、列手炮 上海胡荣华 先胜 河北李来群","catalogue_order":70,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-3.html"}],"book_ids":["yl-book-66"]}}
