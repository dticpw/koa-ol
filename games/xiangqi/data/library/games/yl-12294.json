ce_line_id":"0","source_after_ply":22,"anchor_node_id":"0:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"红平车捉卒嫌贪，易遭致黑方的反扑，可走车四平二较为平稳。黑炮8进6是好手段，既可使7路马生根，又可生出许多利用。","text":"红平车捉卒嫌贪，易遭致黑方的反扑，可走车四平二较为平稳。黑炮8进6是好手段，既可使7路马生根，又可生出许多利用。","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment31:0","source_tag":"DhtmlXQ_comment31","raw_text":"红平车右肋，欲车四退四逼兑炮，下伏围歼黑7路马，不过这只是一厢情愿，还是车八退三固守较为稳妥。","text":"红平车右肋，欲车四退四逼兑炮，下伏围歼黑7路马，不过这只是一厢情愿，还是车八退三固守较为稳妥。","source_line_id":"0","source_after_ply":31,"anchor_node_id":"0:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment36:0","source_tag":"DhtmlXQ_comment36","raw_text":"黑进马好棋，已构成两翼夹击之势。","text":"黑进马好棋，已构成两翼夹击之势。","source_line_id":"0","source_after_ply":36,"anchor_node_id":"0:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment40:0","source_tag":"DhtmlXQ_comment40","raw_text":"此时形势，黑马2进3紧凑，丝毫不给红方透松局势的机会。如误走车4平3，则马七退五，黑攻势瓦解。","text":"此时形势，黑马2进3紧凑，丝毫不给红方透松局势的机会。如误走车4平3，则马七退五，黑攻势瓦解。","source_line_id":"0","source_after_ply":40,"anchor_node_id":"0:40","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment42:0","source_tag":"DhtmlXQ_comment42","raw_text":"黑沉车底线，击中红方要害，以下黑以妙杀获胜。此刻双方十个大子全部集结在红方帅府周围，而黑阵空空如也，形成鲜明对照，又一趣局。","text":"黑沉车底线，击中红方要害，以下黑以妙杀获胜。此刻双方十个大子全部集结在红方帅府周围，而黑阵空空如也，形成鲜明对照，又一趣局。","source_line_id":"0","source_after_ply":42,"anchor_node_id":"0:42","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment48:0","source_tag":"DhtmlXQ_comment48","raw_text":"黑胜。","text":"黑胜。","source_line_id":"0","source_after_ply":48,"anchor_node_id":"0:48","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["中国台北吴贵临 先负 吉林陶汉明"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_open":["五七炮对屏风马进７卒"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["09192939495969798