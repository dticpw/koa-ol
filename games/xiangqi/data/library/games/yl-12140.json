ode_id":"5:33","path_plies":33,"final_legal_fen":"2bakab2/9/2n1cR3/p1P1p3p/7n1/6r2/Pr2P3P/B2CC1N2/9/2RAKAB2 b - - 1 17"}],"annotations":[{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"    红进外马封车，阵形显得轻浮，易被黑方利用，不如改走车九平八，黑如车1平2，则有炮八进二驱车手段，红仍占先。黑借骑河车之势，挺3卒相逼，意在趁红阵脚未稳之机抢出右车，时机好。","text":"    红进外马封车，阵形显得轻浮，易被黑方利用，不如改走车九平八，黑如车1平2，则有炮八进二驱车手段，红仍占先。黑借骑河车之势，挺3卒相逼，意在趁红阵脚未稳之机抢出右车，时机好。","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment20:0","source_tag":"DhtmlXQ_comment20","raw_text":"    黑兑7卒，可使骑河车控制红马，利于攻守。","text":"    黑兑7卒，可使骑河车控制红马，利于攻守。","source_line_id":"0","source_after_ply":20,"anchor_node_id":"0:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment30:0","source_tag":"DhtmlXQ_comment30","raw_text":"||    如图形势，红伸肋车捉马试黑应手，以下黑有数种走法，见变。||    实战中，黑方识破红方计谋，毅然马踏边兵，弃子搏杀与红方对攻，争抢速度，是适时的佳着。","text":"\n    如图形势，红伸肋车捉马试黑应手，以下黑有数种走法，见变。\n    实战中，黑方识破红方计谋，毅然马踏边兵，弃子搏杀与红方对攻，争抢速度，是适时的佳着。","source_line_id":"0","source_after_ply":30,"anchor_node_id":"0:30","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment38:0","source_tag":"DhtmlXQ_comment38","raw_text":"    黑方轰士，抢先发难，令红十分为难，更无暇车四平七吃马了。","text":"    黑方轰士，抢先发难，令红十分为难，更无暇车四平七吃马了。","source_line_id":"0","source_after_ply":38,"anchor_node_id":"0:38","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment40:0","source_tag":"DhtmlXQ_comment40","raw_text":"    红如不落相而改走帅五平四，则车2平6，车四退四，车7平6，帅四平五，炮5进6，帅五进一，炮5平1，黑亦获优势。黑方兑炮简明，后方已毫无顾忌，可全力组织进攻。","text":"    红如不落相而改走帅五平四，则车2平6，车四退四，车7平6，帅四平五，炮5进6，帅五进一，炮5平1，黑亦获优势。黑方兑炮简明，后方已毫无顾忌，可全力组织进攻。","source_line_id":"0","source_after_ply":40,"anchor_node_id":"0:40","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment50:0","source_tag":"DhtmlXQ_comment50","raw_text":"    黑进车捉炮得相，双车炮已构成杀势。","text":"    黑进车捉炮得相，双车炮已构成杀势。","source_line_id":"0","source_after_ply":50,"anchor_node_id":"0:50","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment52:0","source_tag":"DhtmlXQ_comment52","raw_text":"    黑胜。||    红方勉强应了一着，看已无法解救，遂认负。||   ||","text":"    黑胜。\n    红方勉强应了一着，看已无法解救，遂认负。\n   \n","source_line_id":"0","source_after_ply":52,"anchor_node_id":"0:52","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_31:0","source_tag":"DhtmlXQ_comment1_31","raw_text":"黑马7进8白走一步。","text":"黑马7进8白走一步。","source_line_id":"1","source_after_ply":31,"anchor_node_id":"1:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_33:0","source_tag":"DhtmlXQ_comment2_33","raw_text":"红优。","text":"红优。","source_line_id":"2","source_after_ply":33,"anchor_node_id":"2:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_31:0","source_tag":"DhtmlXQ_comment3_31","raw_text":"伏马七进五踏象凶着，红优。","text":"伏马七进五踏象凶着，红优。","source_line_id":"3","source_after_ply":31,"anchor_node_id":"3:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment4_31:0","source_tag":"DhtmlXQ_comment4_31","raw_text":"黑将失子。","text":"黑将失子。","source_line_id":"4","source_after_ply":31,"anchor_node_id":"4:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment5_33:0","source_tag":"DhtmlXQ_comment5_33","raw_text":"红优。","text":"红优。","source_line_id":"5","source_after_ply":33,"anchor_node_id":"5:33","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["085江苏言穆江 先负 河北刘殿中"],"DhtmlXQ_event":["第二章 顺手炮、列手炮(32局)"],"DhtmlXQ_open":["D40 中炮对左三步虎转列炮"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":25,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":6,"structured_branches":5,"line_statuses":{"legal":6},"source_move_records":66,"legal_move_records":66,"annot