icting_field":false},{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"(图四十六)","text":"(图四十六)","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment40:0","source_tag":"DhtmlXQ_comment40","raw_text":"黑方大占优势。||||顺手炮布局，无论是直车对横车或横车对直车，都是一种斗争很尖锐的布局(当然，如果稳扎稳打，也可以成平稳局势)。||||上面着法1958年全国棋赛时，斗顺炮弈成的一例。后来在1962年全国棋赛的一次对局中，执先手走至如图形势时，不走兵三进一，而走炮八进二，于是演成车4进4，炮八平七，炮2进5，士五进六，炮2平5，炮七进五，士4进5，相三进五，车1退1，炮七退二，马7退9，车九平八。车4进2，士六进五，红方先手。","text":"黑方大占优势。\n\n顺手炮布局，无论是直车对横车或横车对直车，都是一种斗争很尖锐的布局(当然，如果稳扎稳打，也可以成平稳局势)。\n\n上面着法1958年全国棋赛时，斗顺炮弈成的一例。后来在1962年全国棋赛的一次对局中，执先手走至如图形势时，不走兵三进一，而走炮八进二，于是演成车4进4，炮八平七，炮2进5，士五进六，炮2平5，炮七进五，士4进5，相三进五，车1退1，炮七退二，马7退9，车九平八。车4进2，士六进五，红方先手。","source_line_id":"0","source_after_ply":40,"anchor_node_id":"0:40","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_29:0","source_tag":"DhtmlXQ_comment1_29","raw_text":"红方先手。","text":"红方先手。","source_line_id":"1","source_after_ply":29,"anchor_node_id":"1:29","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_pver":["091016"],"DhtmlXQ_viewurl":["?owner=u&id=69528&f=&isSave="],"DhtmlXQ_adddate":["2008-2-24 22:50:00"],"DhtmlXQ_editdate":["2008-2-24 22:50:00"],"DhtmlXQ_title":["实战布局琐谈 六、顺炮直车对横车"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"],"DhtmlXQ_firstnum":["0"],"DhtmlXQ_length":["0"],"DhtmlXQ_type":["全局"],"DhtmlXQ_gametype":["慢棋"],"DhtmlXQ_open":[""],"DhtmlXQ_class":["象棋谱大全-现代棋书专集"],"DhtmlXQ_event":["弈林新编-杨官璘著"],"DhtmlXQ_group":[""],"DhtmlXQ_round":["2.象棋基本知识"],"DhtmlXQ_table":[""],"DhtmlXQ_date":[""],"DhtmlXQ_place":[""],"DhtmlXQ_timerule":[""],"DhtmlXQ_red":[""],"DhtmlXQ_redeng":[""],"DhtmlXQ_redrating":[""],"DhtmlXQ_redtime":[""],"DhtmlXQ_black":[""],"DhtmlXQ_blackeng":[""],"DhtmlXQ_blackrating":[""],"DhtmlXQ_blacktime":[""],"DhtmlXQ_result":[""],"DhtmlXQ_endtype":[""],"DhtmlXQ_remark":["杨官璘"],"DhtmlXQ_author":["