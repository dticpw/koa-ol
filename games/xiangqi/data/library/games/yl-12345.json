,"0:10","0:11","0:12","0:13","0:14","0:15","0:16","0:17","0:18","0:19","0:20","0:21","0:22","0:23","0:24","0:25","0:26","0:27","0:28","0:29","0:30","0:31","0:32","0:33","0:34","0:35","0:36","0:37","0:38","0:39","0:40","0:41","0:42","0:43"],"first_failure":null,"last_legal_node_id":"0:43","path_plies":43,"final_legal_fen":"3ak4/4a3c/4R1nrc/p1p5p/9/2P6/P3P3P/2N2R2B/9/2BAKA3 b - - 0 22"}],"annotations":[{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"红用五六炮对付黑方的高车保马，较为少见，一般多走马八进七或炮八平七。黑起横车准备策应左翼，亦可直接炮2退1。","text":"红用五六炮对付黑方的高车保马，较为少见，一般多走马八进七或炮八平七。黑起横车准备策应左翼，亦可直接炮2退1。","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment20:0","source_tag":"DhtmlXQ_comment20","raw_text":"黑平右肋车，被红方应以巡河炮后，反使红方产生借力，加大了攻击速度，似有“帮着”嫌疑，故不如直接马7进8较好。","text":"黑平右肋车，被红方应以巡河炮后，反使红方产生借力，加大了攻击速度，似有“帮着”嫌疑，故不如直接马7进8较好。","source_line_id":"0","source_after_ply":20,"anchor_node_id":"0:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"红方乘机进左车拴住黑方3线子力，暗藏炮五进四与车四平五的严厉手段，是意味深长的佳着。黑进7卒疏于防范，被红车杀通卒林与中路，应该走炮7平5尚无大碍。","text":"红方乘机进左车拴住黑方3线子力，暗藏炮五进四与车四平五的严厉手段，是意味深长的佳着。黑进7卒疏于防范，被红车杀通卒林与中路，应该走炮7平5尚无大碍。","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment26:0","source_tag":"DhtmlXQ_comment26","raw_text":"此时形势，红车杀中卒，着法精妙之极，一举打通卒林与中路两条要线，实出黑方预料。实战黑方应以象7进5，准备弃子一搏，另有两种下法亦落下风，试演如下：||（1）马3进5，炮五进四，车4进4，车八平五!以下红方得车胜定。||（2）炮7平5，车五平七，卒7平6，兵七进一，红方先手。","text":"此时形势，红车杀中卒，着法精妙之极，一举打通卒林与中路两条要线，实出黑方预料。实战黑方应以象7进5，准备弃子一搏，另有两种下法亦落下风，试演如下：\n（1）马3进5，炮五进四，车4进4，车八平五!以下红方得车胜定。\n（2）炮7平5，车五平七，卒7平6，兵七进一，红方先手。","source_line_id":"0","source_after_ply":26,"anchor_node_id":"0:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment30:0","source_tag":"DhtmlXQ_comment30","raw_text":"红进炮串打车炮，一着定局，黑以车砍炮实属无奈，如改走炮7进1，则车五进一，士6进5，车七进二，红亦胜势。","text":"红进炮串打车炮，一着定局，黑以车砍炮实属无奈，如改走炮7进1，则车五进一，士6进5，车七进二，红亦胜势。","source_line_id":"0","source_after_ply":30,"anchor_node_id":"0:30","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment35:0","source_tag":"DhtmlXQ_comment35","raw_text":"红方炮轰中象，弃还一子，粉碎了黑方的反击之势。","text":"红方炮轰中象，弃还一子，粉碎了黑方的反击之势。","source_line_id":"0","source_after_ply":35,"anchor_node_id":"0:35","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment43:0","source_tag":"DhtmlXQ_comment43","raw_text":"红胜。||黑因各子被牵，又少双象，遂认输。","text":"红胜。\n黑因各子被牵，又少双象，遂认输。","source_line_id":"0","source_after_ply":43,"anchor_node_id":"0:43","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["农协郑乃东 先胜 陕西张惠民"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_date":["1989年5月10日"],"DhtmlXQ_place":["泾县"],"DhtmlXQ_blackrating":[""],"DhtmlXQ_result":["红胜"],"DhtmlXQ_open":["中炮过河车互进七兵对屏风马平炮兑车"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":17,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":43,"legal_move_records":43,"annotations":7,"annotation_statuses":{"attached":7}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第一章 中炮对屏风马类 农协郑乃东 先胜 陕西张惠民","catalogue_order":26,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-2.html"}],"book_ids":["yl-book-66"]}}
