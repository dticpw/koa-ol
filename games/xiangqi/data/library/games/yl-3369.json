"0:6","0:7","0:8","0:9","0:10","0:11","0:12","0:13","0:14","0:15","0:16","0:17","0:18","0:19","0:20","0:21","0:22","0:23","0:24","0:25","0:26","0:27","0:28","0:29","0:30","0:31","0:32","1:33","1:34"],"first_failure":null,"last_legal_node_id":"1:34","path_plies":34,"final_legal_fen":"3akabr1/9/4b1n2/pR2pn2p/2p4c1/7N1/P1P1P3P/2N1B1C2/4A4/2BAK4 w - - 4 18"}],"annotations":[{"id":"DhtmlXQ_comment0:0","source_tag":"DhtmlXQ_comment0","raw_text":"《弈林新编》杨官璘编著","text":"《弈林新编》杨官璘编著","source_line_id":"0","source_after_ply":0,"anchor_node_id":"root","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"在布局开始，都是用进兵的，又称为\"对兵局\"，现在由第一着至第十着，各走了五着相同着法，而红方有先行之利，红方应该便宜。但由于是上好士相，采取了巩固阵地的策略，所以它的局势，还属于平稳。","text":"在布局开始，都是用进兵的，又称为\"对兵局\"，现在由第一着至第十着，各走了五着相同着法，而红方有先行之利，红方应该便宜。但由于是上好士相，采取了巩固阵地的策略，所以它的局势，还属于平稳。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"2。黑方如乘机开出左车，局势会比较开杨，所以，改走车9平8较佳。","text":"2。黑方如乘机开出左车，局势会比较开杨，所以，改走车9平8较佳。","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment18:0","source_tag":"DhtmlXQ_comment18","raw_text":"3。目的捉马，实际上无济于事，不如改走炮2进2。","text":"3。目的捉马，实际上无济于事，不如改走炮2进2。","source_line_id":"0","source_after_ply":18,"anchor_node_id":"0:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":"4。进车捉炮，正常之着，并且将贴身车转为巡河车位置，红方比较宜。","text":"4。进车捉炮，正常之着，并且将贴身车转为巡河车位置，红方比较宜。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment29:0","source_tag":"DhtmlXQ_comment29","raw_text":"5。可以改走车六平八，保留子力，红方先手。现在兑去一车，则战斗力量削弱，局势比较平稳。","text":"5。可以改走车六平八，保留子力，红方先手。现在兑去一车，则战斗力量削弱，局势比较平稳。","source_line_id":"0","source_after_ply":29,"anchor_node_id":"0:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment33:0","source_tag":"DhtmlXQ_comment33","raw_text":"6。改走炮二平三，则车9平8，局势仍然平稳。","text":"6。改走炮二平三，则车9平8，局势仍然平稳。","source_line_id":"0","source_after_ply":33,"anchor_node_id":"0:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment36:0","source_tag":"DhtmlXQ_comment36","raw_text":"7。可以改走卒9进1，冲边卒来活通车路，较为稳健。","text":"7。可以改走卒9进1，冲边卒来活通车路，较为稳健。","source_line_id":"0","source_after_ply":36,"anchor_node_id":"0:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment47:0","source_tag":"DhtmlXQ_comment47","raw_text":"(图二四六)","text":"(图二四六)","source_line_id":"0","source_after_ply":47,"anchor_node_id":"0:47","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment66:0","source_tag":"DhtmlXQ_comment66","raw_text":"和棋。","text":"和棋。","source_line_id":"0","source_after_ply":66,"anchor_node_id":"0:66","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_34:0","source_tag":"DhtmlXQ_comment1_34","raw_text":"局势仍然平稳。","text":"局势仍然平稳。","source_line_id":"1","source_after_ply":34,"anchor_node_id":"1:34","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_pver":["091016"],"DhtmlXQ_viewurl":["?owner=u&id=69758&f=&isSave="],"DhtmlXQ_adddate":["2008-2-24 22:50:00"],"DhtmlXQ_editdate":["2008-2-24 22:50:00"],"DhtmlXQ_title":["第二十八局 进兵局"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"],"DhtmlXQ_firstnum":["0"],"DhtmlXQ_length":["0"],"DhtmlXQ_type":["全局"],"DhtmlXQ_gametype":["慢棋"],"DhtmlXQ_open":[""],"DhtmlXQ_class":["象棋谱大全-现代棋书专集"],"DhtmlXQ_event":["弈林新编-杨官璘著"],"DhtmlXQ_group":[""],"DhtmlXQ_round":["8.对局评注"],"DhtmlXQ_table":[""],"DhtmlXQ_date":["1937年5月"],"DhtmlXQ_place":["上海市"],"DhtmlXQ_timerule":[""],"DhtmlXQ_red":["邵次明"],"DhtmlXQ_redeng":[""],"DhtmlXQ_redrating":[""],"DhtmlXQ_redtime":[""],"DhtmlXQ_black":["谢侠逊"],"DhtmlXQ_blackeng":[""],"DhtmlXQ_blackrating":[""],"DhtmlXQ_blacktime":["