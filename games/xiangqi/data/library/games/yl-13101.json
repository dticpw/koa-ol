9","3:40","3:41","3:42","3:43","3:44"],"first_failure":null,"last_legal_node_id":"3:44","path_plies":44,"final_legal_fen":"4kab2/4a3n/1cn1b4/pCN1C1R1p/9/9/P1R1P1P1P/3KB4/4Nc3/3r2B2 w - - 4 23"}],"annotations":[{"id":"DhtmlXQ_comment6:0","source_tag":"DhtmlXQ_comment6","raw_text":"到这边为止，都是当头炮跟屏风马的正常布局。","text":"到这边为止，都是当头炮跟屏风马的正常布局。","source_line_id":"0","source_after_ply":6,"anchor_node_id":"0:6","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment7:0","source_tag":"DhtmlXQ_comment7","raw_text":"过去我们都是在介绍当头炮进中兵的布局，从这一局开始我们介绍当头炮进七兵的布局。","text":"过去我们都是在介绍当头炮进中兵的布局，从这一局开始我们介绍当头炮进七兵的布局。","source_line_id":"0","source_after_ply":7,"anchor_node_id":"0:7","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment8:0","source_tag":"DhtmlXQ_comment8","raw_text":"当头炮进七兵进攻，原则上屏风马也要进七卒应对，否则如果当头炮再进三兵，屏风马双马受制，不灵活了。","text":"当头炮进七兵进攻，原则上屏风马也要进七卒应对，否则如果当头炮再进三兵，屏风马双马受制，不灵活了。","source_line_id":"0","source_after_ply":8,"anchor_node_id":"0:8","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment9:0","source_tag":"DhtmlXQ_comment9","raw_text":"当头炮进七兵之後，再进二路车过河。","text":"当头炮进七兵之後，再进二路车过河。","source_line_id":"0","source_after_ply":9,"anchor_node_id":"0:9","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"黑方跃马盘河是最积极的下法。","text":"黑方跃马盘河是最积极的下法。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment11:0","source_tag":"DhtmlXQ_comment11","raw_text":"因为黑方跃马盘河之後，黑方的八路车包将受制於红方的二路车，所以这一步棋红方退二想要继续牵制黑方的八路车包。","text":"因为黑方跃马盘河之後，黑方的八路车包将受制於红方的二路车，所以这一步棋红方退二想要继续牵制黑方的八路车包。","source_line_id":"0","source_after_ply":11,"anchor_node_id":"0:11","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":"同样的，黑方为了解脱红方的牵制，所以黑方这一步棋弃七路卒，逼红方的二路车跑到三路来。","text":"同样的，黑方为了解脱红方的牵制，所以黑方这一步棋弃七路卒，逼红方的二路车跑到三路来。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"黑方平包到士角当然，这是前著弃卒的目的，平包到士角让红方的三路车不能平四驱马。黑方这一苹盘河马怎麽样驱走呢？","text":"黑方平包到士角当然，这是前著弃卒的目的，平包到士角让红方的三路车不能平四驱马。黑方这一苹盘河马怎麽样驱走呢？","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment15:0","source_tag":"DhtmlXQ_comment15","raw_text":"很多玩家会说，要驱走盘河马很简单，车三进一就可以驱走盘河马了。","text":"很多玩家会说，要驱走盘河马很简单，车三进一就可以驱走盘河马了。","source_line_id":"0","source_after_ply":15,"anchor_node_id":"0:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"问题是红方用这一种方式驱走盘河马，不如不驱。","text":"问题是红方用这一种方式驱走盘河马，不如不驱。","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_15:0","source_tag":"DhtmlXQ_comment1_15","raw_text":"红方想要驱走黑方的盘河马，有一种驱马方式，这种方式是常用的手法，玩家应该谨记。进炮跨河，是一种常用的驱走盘河马的方式。","text":"红方想要驱走黑方的盘河马，有一种驱马方式，这种方式是常用的手法，玩家应该谨记。进炮跨河，是一种常用的驱走盘河马的方式。","source_line_id":"1","source_after_ply":15,"anchor_node_id":"1:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_16:0","source_tag":"DhtmlXQ_comment1_16","raw_text":"红方进炮跨河，黑方视若无睹，黑方凭著什麽呢？","text":"红方进炮跨河，黑方视若无睹，黑方凭著什麽呢？","source_line_id":"1","source_after_ply":16,"anchor_node_id":"1:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_17:0","source_tag":"DhtmlXQ_comment1_17","raw_text":"进炮跨河的目的是这一著再进七路兵驱赶盘河马。","text":"进炮跨河的目的是这一著再进七路兵驱赶盘河马。","source_line_id":"1","source_after_ply":17,"anchor_node_id":"1:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_18:0","source_tag":"DhtmlXQ_comment1_18","raw_text":"前著黑方视若无睹而进一路横车，就是凭著有这一步马六进八反踩车的棋。","text":"前著黑方视若无睹而进一路横车，就是凭著有这一步马六进八反踩车的棋。","source_line_id":"1","source_after_ply":18,"anchor_node_id":"1:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment1_20:0","source_tag":"DhtmlXQ_comment1_20","raw_text":"红方三路车进二不得已。黑方顺利得进卒去兵，本来红方想要多一苹过河兵，现在反而让黑方多一苹三路卒。","text":"红方三路车进二不得已。黑方顺利得进卒去兵，本来红方想要多一苹过河兵，现在反而让黑方多一苹三路卒。","source_line_id":"1","source_after_ply":20,"anchor_node_id":"1:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_15:0","source_tag":"DhtmlXQ_comment2_15","raw_text":"所以在这个局面，红方虽有进炮跨河进兵驱马的妙棋，但是在这个场合不能用的。跳八路马是一个行情。","text":"所以在这个局面，红方虽有进炮跨河进兵驱马的妙棋，但是在这个场合不能用的。跳八路马是一个行情。","source_line_id":"2","source_after_ply":15,"anchor_node_id":"2:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_17:0","source_tag":"DhtmlXQ_comment2_17","raw_text":"红方要打开这个局面还是要进炮跨河。","text":"红方要打开这个局面还是要进炮跨河。","source_line_id":"2","source_after_ply":17,"anchor_node_id":"2:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_18:0","source_tag":"DhtmlXQ_comment2_18","raw_text":"黑方仍然不理，进一路横车。","text":"黑方仍然不理，进一路横车。","source_line_id":"2","source_after_ply":18,"anchor_node_id":"2:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_22:0","source_tag":"DhtmlXQ_comment2_22","raw_text":"到这边为止，应该是红黑双方预定的步子。","text":"到这边为止，应该是红黑双方预定的步子。","source_line_id":"2","source_after_ply":22,"anchor_node_id":"2:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_23:0","source_tag":"DhtmlXQ_comment2_23","raw_text":"红方八路炮进一驱赶黑方的八路马。","text":"红方八路炮进一驱赶黑方的八路马。","source_line_id":"2","source_after_ply":23,"anchor_node_id":"2:23","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_25:0","source_tag":"DhtmlXQ_comment2_25","raw_text":"当黑方退马时，红方再跃马盘河。","text":"当黑方退马时，红方再跃马盘河。","source_line_id":"2","source_after_ply":25,"anchor_node_id":"2:25","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_26:0","source_tag":"DhtmlXQ_comment2_26","raw_text":"黑方平车驱马。","text":"黑方平车驱马。","source_line_id":"2","source_after_ply":26,"anchor_node_id":"2:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_27:0","source_tag":"DhtmlXQ_comment2_27","raw_text":"红方马六进七，其目的是塞住黑方三路马马腿，次一著平炮取黑方的中路卒。","text":"红方马六进七，其目的是塞住黑方三路马马腿，次一著平炮取黑方的中路卒。","source_line_id":"2","source_after_ply":27,"anchor_node_id":"2:27","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_28:0","source_tag":"DhtmlXQ_comment2_28","raw_text":"黑方先支士预防红方平炮取中路卒。","text":"黑方先支士预防红方平炮取中路卒。","source_line_id":"2","source_after_ply":28,"anchor_node_id":"2:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_29:0","source_tag":"DhtmlXQ_comment2_29","raw_text":"如红方仍执意平炮取中路卒。","text":"如红方仍执意平炮取中路卒。","source_line_id":"2","source_after_ply":29,"anchor_node_id":"2:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_30:0","source_tag":"DhtmlXQ_comment2_30","raw_text":"黑方先进包打马是抢先的要著。","text":"黑方先进包打马是抢先的要著。","source_line_id":"2","source_after_ply":30,"anchor_node_id":"2:30","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_31:0","source_tag":"DhtmlXQ_comment2_31","raw_text":"当红方退炮窝心解围时。","text":"当红方退炮窝心解围时。","source_line_id":"2","source_after_ply":31,"anchor_node_id":"2:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment2_32:0","source_tag":"DhtmlXQ_comment2_32","raw_text":"黑方进车抓马，红方三路马必死。","text":"黑方进车抓马，红方三路马必死。","source_line_id":"2","source_after_ply":32,"anchor_node_id":"2:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_29:0","source_tag":"DhtmlXQ_comment3_29","raw_text":"所以在这个局面，红方平炮去卒，让黑方的二路包进炮打红方的三路马·红方马上失子，那麽这一步棋红方如果改下进炮去卒，它的变化是怎麽样？进炮去卒的好处是让黑方没办法进二路包打马。","text":"所以在这个局面，红方平炮去卒，让黑方的二路包进炮打红方的三路马·红方马上失子，那麽这一步棋红方如果改下进炮去卒，它的变化是怎麽样？进炮去卒的好处是让黑方没办法进二路包打马。","source_line_id":"3","source_after_ply":29,"anchor_node_id":"3:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_30:0","source_tag":"DhtmlXQ_comment3_30","raw_text":"但黑方得以从容的进三路卒。","text":"但黑方得以从容的进三路卒。","source_line_id":"3","source_after_ply":30,"anchor_node_id":"3:30","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_31:0","source_tag":"DhtmlXQ_comment3_31","raw_text":"红方飞相。","text":"红方飞相。","source_line_id":"3","source_after_ply":31,"anchor_node_id":"3:31","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_32:0","source_tag":"DhtmlXQ_comment3_32","raw_text":"黑方进车抓马。","text":"黑方进车抓马。","source_line_id":"3","source_after_ply":32,"anchor_node_id":"3:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_33:0","source_tag":"DhtmlXQ_comment3_33","raw_text":"红方退马窝心不得已。","text":"红方退马窝心不得已。","source_line_id":"3","source_after_ply":33,"anchor_node_id":"3:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_34:0","source_tag":"DhtmlXQ_comment3_34","raw_text":"黑方再进三路卒牵制红方的窝心马。","text":"黑方再进三路卒牵制红方的窝心马。","source_line_id":"3","source_after_ply":34,"anchor_node_id":"3:34","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_35:0","source_tag":"DhtmlXQ_comment3_35","raw_text":"红方平车抓卒。","text":"红方平车抓卒。","source_line_id":"3","source_after_ply":35,"anchor_node_id":"3:35","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_36:0","source_tag":"DhtmlXQ_comment3_36","raw_text":"黑方毅然弃卒，平八路车到六路来，目的是什麽呢？","text":"黑方毅然弃卒，平八路车到六路来，目的是什麽呢？","source_line_id":"3","source_after_ply":36,"anchor_node_id":"3:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_37:0","source_tag":"DhtmlXQ_comment3_37","raw_text":"红方进车去卒，拔掉了心头之恨。","text":"红方进车去卒，拔掉了心头之恨。","source_line_id":"3","source_after_ply":37,"anchor_node_id":"3:37","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_38:0","source_tag":"DhtmlXQ_comment3_38","raw_text":"但黑方这里有一步妙杀，这一步妙杀非常精彩，请各位玩家欣赏。","text":"但黑方这里有一步妙杀，这一步妙杀非常精彩，请各位玩家欣赏。","source_line_id":"3","source_after_ply":38,"anchor_node_id":"3:38","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_39:0","source_tag":"DhtmlXQ_comment3_39","raw_text":"当黑方进车去士弃车时，简直是一步晴天劈雳。红方平帅去车不得已，也是仅此一著。","text":"当黑方进车去士弃车时，简直是一步晴天劈雳。红方平帅去车不得已，也是仅此一著。","source_line_id":"3","source_after_ply":39,"anchor_node_id":"3:39","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_41:0","source_tag":"DhtmlXQ_comment3_41","raw_text":"黑方进车去士，红方老帅进一。","text":"黑方进车去士，红方老帅进一。","source_line_id":"3","source_after_ply":41,"anchor_node_id":"3:41","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_42:0","source_tag":"DhtmlXQ_comment3_42","raw_text":"黑方进包叫将，红方即寿终正寝。","text":"黑方进包叫将，红方即寿终正寝。","source_line_id":"3","source_after_ply":42,"anchor_node_id":"3:42","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment3_44:0","source_tag":"DhtmlXQ_comment3_44","raw_text":"这样红方被连将杀举白旗投降了。||||所以说黑方第18手的这一步平车到六路是非常厉害的棋，红方既然不能进车去卒，整个盘面就被黑方牵制住了，虽然红方过河那麽多子，但对黑方一点办法都没有。本局就介绍到这里，谢谢！","text":"这样红方被连将杀举白旗投降了。\n\n所以说黑方第18手的这一步平车到六路是非常厉害的棋，红方既然不能进车去卒，整个盘面就被黑方牵制住了，虽然红方过河那麽多子，但对黑方一点办法都没有。本局就介绍到这里，谢谢！","source_line_id":"3","source_after_ply":44,"anchor_node_id":"3:44","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["1.屏风马进七卒左马盘河应当头炮过河车退守河边局"],"DhtmlXQ_event":["第5节 破进七兵篇 第二章"],"DhtmlXQ_open":["C35 中炮过河车互进七兵对屏风马左马盘河"],"DhtmlXQ_remark":["吴贵临"],"DhtmlXQ_author":["陈勇"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":53,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":4,"structured_branches":3,"line_statuses":{"legal":4},"source_move_records":56,"legal_move_records":56,"annotations":42,"annotation_statuses":{"attached":42}},"memberships":[{"book_id":"yl-book-65","category_id":"65","title":"第三章 屏风马破当头炮 第5节 破进七兵篇 1.屏风马进七卒左马盘河应当头炮过河车退守河边局","catalogue_order":97,"directory_url":"https://m.xiangqiqipu.com/Category/List-65-5.html"}],"book_ids":["yl-book-65"]}}
