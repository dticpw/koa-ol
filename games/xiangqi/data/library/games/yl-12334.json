36","0:37","0:38","0:39","0:40","0:41","0:42"],"first_failure":null,"last_legal_node_id":"0:42","path_plies":42,"final_legal_fen":"3k1ab2/4a4/4b4/p1p1R3p/5Pp2/2P6/P3N3P/2Cr2N2/1c2K4/c4AB2 w - - 1 22"}],"annotations":[{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"亦可改走炮二平七，以下相三进一，炮8平9，车二进三，马7退8，兵五进一，车1平4，黑亦可一战。现平3路炮，力求局面复杂，充分反映了黑方的棋艺风格。","text":"亦可改走炮二平七，以下相三进一，炮8平9，车二进三，马7退8，兵五进一，车1平4，黑亦可一战。现平3路炮，力求局面复杂，充分反映了黑方的棋艺风格。","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment20:0","source_tag":"DhtmlXQ_comment20","raw_text":"红升坐车捉炮，弃相争先，有利于中炮进攻，也使局势复杂。也可改走兵三进一，卒7进1，车二退三，炮3平7，马三进五，红亦占优。黑炮打相必然，如车4进6，则马七退五，黑受制。","text":"红升坐车捉炮，弃相争先，有利于中炮进攻，也使局势复杂。也可改走兵三进一，卒7进1，车二退三，炮3平7，马三进五，红亦占优。黑炮打相必然，如车4进6，则马七退五，黑受制。","source_line_id":"0","source_after_ply":20,"anchor_node_id":"0:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"红方左马盘中，显系忽略了黑方的反击手段，被黑利用，造成恶果，可改走马三进五，红还占先手。黑及时跃马好棋，暗藏“金蝉脱壳”的绝妙着法。","text":"红方左马盘中，显系忽略了黑方的反击手段，被黑利用，造成恶果，可改走马三进五，红还占先手。黑及时跃马好棋，暗藏“金蝉脱壳”的绝妙着法。","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment26:0","source_tag":"DhtmlXQ_comment26","raw_text":"红仍未警觉，随手进中兵，黑突然一着平炮，隐藏着凶狠的攻杀，顷刻间黑已确定胜势。","text":"红仍未警觉，随手进中兵，黑突然一着平炮，隐藏着凶狠的攻杀，顷刻间黑已确定胜势。","source_line_id":"0","source_after_ply":26,"anchor_node_id":"0:26","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment28:0","source_tag":"DhtmlXQ_comment28","raw_text":"再献车，穷追不放，是黑方计划中关键的一环，红亦哭笑不得。","text":"再献车，穷追不放，是黑方计划中关键的一环，红亦哭笑不得。","source_line_id":"0","source_after_ply":28,"anchor_node_id":"0:28","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment34:0","source_tag":"DhtmlXQ_comment34","raw_text":"黑车杀出，车双炮攻杀，势不可挡，已是胜券在握。","text":"黑车杀出，车双炮攻杀，势不可挡，已是胜券在握。","source_line_id":"0","source_after_ply":34,"anchor_node_id":"0:34","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment42:0","source_tag":"DhtmlXQ_comment42","raw_text":"退炮后伏炮1退1绝杀，黑胜。","text":"退炮后伏炮1退1绝杀，黑胜。","source_line_id":"0","source_after_ply":42,"anchor_node_id":"0:42","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["机电葛维蒲 先负 天津袁洪梁"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_date":["1994年5月20日"],"DhtmlXQ_blackteam":[""],"DhtmlXQ_blackrating":[""],"DhtmlXQ_result":["黑胜"],"DhtmlXQ_open":["C31 中炮过河车互进七兵对屏风马上士"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":19,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":42,"legal_move_records":42,"annotations":7,"annotation_statuses":{"attached":7}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第一章 中炮对屏风马类 机电葛维蒲 先负 天津袁洪梁","catalogue_order":30,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-2.html"}],"book_ids":["yl-book-66"]}}
