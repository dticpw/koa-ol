19","0:20","0:21","0:22","0:23","0:24","0:25","0:26","0:27","0:28"],"first_failure":null,"last_legal_node_id":"0:28","path_plies":28,"final_legal_fen":"3akab2/9/2n1b3n/p1R3p1p/4p4/2N6/P1P3P1P/4C1C2/1r2Ar3/R1B1KABc1 w - - 3 15"}],"annotations":[{"id":"DhtmlXQ_comment5:0","source_tag":"DhtmlXQ_comment5","raw_text":"红方不车一平二出直车，改车一进一进横车，别有一番攻势。","text":"红方不车一平二出直车，改车一进一进横车，别有一番攻势。","source_line_id":"0","source_after_ply":5,"anchor_node_id":"0:5","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment6:0","source_tag":"DhtmlXQ_comment6","raw_text":"黑方仍以横车应对，本来红黑双方都出横车，先出者有利，为什麽这个时候单提马会选择出横车呢？因为红方已进一路横车，黑方如照例出直车将来会失去平包兑车或进包封车抢先手的手段，故跟著起横车比直车有力量，这个道理希望玩家能够体会则棋力即能大增。","text":"黑方仍以横车应对，本来红黑双方都出横车，先出者有利，为什麽这个时候单提马会选择出横车呢？因为红方已进一路横车，黑方如照例出直车将来会失去平包兑车或进包封车抢先手的手段，故跟著起横车比直车有力量，这个道理希望玩家能够体会则棋力即能大增。","source_line_id":"0","source_after_ply":6,"anchor_node_id":"0:6","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment7:0","source_tag":"DhtmlXQ_comment7","raw_text":"因为由红方走，所以红方的横车先占据有利的位置，在黑方的立场来讲，这是不得已的。红方的横车，当然先占要津，这一路如果没占，次一著，黑方的九路车一定会车九平四，占到这一路要津，这一路是双方横车的要津。","text":"因为由红方走，所以红方的横车先占据有利的位置，在黑方的立场来讲，这是不得已的。红方的横车，当然先占要津，这一路如果没占，次一著，黑方的九路车一定会车九平四，占到这一路要津，这一路是双方横车的要津。","source_line_id":"0","source_after_ply":7,"anchor_node_id":"0:7","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment10:0","source_tag":"DhtmlXQ_comment10","raw_text":"单提马横车对当头炮横车有一步很重要的棋，就是包二进二这一步巡河包，这一步棋有三个作用，首先他如果有机会平包射马，就可以明一路车，否则卒三进一也可以助攻，更重要的，将来红方平八路炮之後出九路车，可以避开红方车九平八的先手利。","text":"单提马横车对当头炮横车有一步很重要的棋，就是包二进二这一步巡河包，这一步棋有三个作用，首先他如果有机会平包射马，就可以明一路车，否则卒三进一也可以助攻，更重要的，将来红方平八路炮之後出九路车，可以避开红方车九平八的先手利。","source_line_id":"0","source_after_ply":10,"anchor_node_id":"0:10","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":"平包射马明一路车，是原来预定的步骤。","text":"平包射马明一路车，是原来预定的步骤。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment14:0","source_tag":"DhtmlXQ_comment14","raw_text":"现在红方的八路炮被抓，当然必须跑炮，红方的三路马又被黑方的七路包所控制，随时会被兑换，在炮的步子来讲，红方已经失先了！","text":"现在红方的八路炮被抓，当然必须跑炮，红方的三路马又被黑方的七路包所控制，随时会被兑换，在炮的步子来讲，红方已经失先了！","source_line_id":"0","source_after_ply":14,"anchor_node_id":"0:14","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment16:0","source_tag":"DhtmlXQ_comment16","raw_text":"黑方有机会从容走车九平六，黑方已经明显领先啦！","text":"黑方有机会从容走车九平六，黑方已经明显领先啦！","source_line_id":"0","source_after_ply":16,"anchor_node_id":"0:16","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment17:0","source_tag":"DhtmlXQ_comment17","raw_text":"红方再进中兵，是唯一的攻势，因为，除了中路突破以外，其他的要津都被黑方控制啦！","text":"红方再进中兵，是唯一的攻势，因为，除了中路突破以外，其他的要津都被黑方控制啦！","source_line_id":"0","source_after_ply":17,"anchor_node_id":"0:17","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":"这一步棋红方要跳马，因为如果红方打中兵，没有攻势，只会再次的失先。","text":"这一步棋红方要跳马，因为如果红方打中兵，没有攻势，只会再次的失先。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment20:0","source_tag":"DhtmlXQ_comment20","raw_text":"黑方当然不能进中卒，因为进中卒，红方马七进六会反先。","text":"黑方当然不能进中卒，因为进中卒，红方马七进六会反先。","source_line_id":"0","source_after_ply":20,"anchor_node_id":"0:20","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"黑包吃马，红方已经入局啦！","text":"黑包吃马，红方已经入局啦！","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment28:0","source_tag":"DhtmlXQ_comment28","raw_text":"到这里为止，红方应该举白旗投降啦！","text":"到这里为止，红方应该举白旗投降啦！","source_line_id":"0","source_after_ply":28,"anchor_node_id":"0:28","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["五、单提马横车应当头炮横车局"],"DhtmlXQ_event":["第2节 单提马应当头炮 第六章"],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_t