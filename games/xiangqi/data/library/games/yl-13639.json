2","0:33","0:34","0:35","0:36","0:37","0:38","0:39"],"first_failure":null,"last_legal_node_id":"0:39","path_plies":39,"final_legal_fen":"2bak1b1r/4aR3/4c4/R7p/9/2P3P2/P7P/1r2B1N2/4A4/2BAK4 b - - 0 20"}],"annotations":[{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":"至此形势，和第三局基本一致。红方车横出、炮过河，攻击手法和王浩然如出一辙！是巧合，还是王浩然上次痛失好局后与同是‘维扬三杰’之一的张锦荣探研过，已经无从考证。","text":"至此形势，和第三局基本一致。红方车横出、炮过河，攻击手法和王浩然如出一辙！是巧合，还是王浩然上次痛失好局后与同是‘维扬三杰’之一的张锦荣探研过，已经无从考证。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment22:0","source_tag":"DhtmlXQ_comment22","raw_text":"上次林弈仙是直接捉炮，现在先打中兵再捉炮，结果又会如何？","text":"上次林弈仙是直接捉炮，现在先打中兵再捉炮，结果又会如何？","source_line_id":"0","source_after_ply":22,"anchor_node_id":"0:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment29:0","source_tag":"DhtmlXQ_comment29","raw_text":"结果红方双车炮占位极好，优势明显。","text":"结果红方双车炮占位极好，优势明显。","source_line_id":"0","source_after_ply":29,"anchor_node_id":"0:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment33:0","source_tag":"DhtmlXQ_comment33","raw_text":"平车叫杀似无必要，可直接车六平三杀卒，以免黑方兑炮。||不知道那时候的棋规如何，要是现在的话红方还有更简单的胜法：炮九进三，黑必走车2退7，炮九退四，车2进4，炮九进四，车2退4，炮九退四，黑方长捉犯规，只好让红镇中炮。红利用铁门闩的杀势可以较快取胜。","text":"平车叫杀似无必要，可直接车六平三杀卒，以免黑方兑炮。\n不知道那时候的棋规如何，要是现在的话红方还有更简单的胜法：炮九进三，黑必走车2退7，炮九退四，车2进4，炮九进四，车2退4，炮九退四，黑方长捉犯规，只好让红镇中炮。红利用铁门闩的杀势可以较快取胜。","source_line_id":"0","source_after_ply":33,"anchor_node_id":"0:33","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment36:0","source_tag":"DhtmlXQ_comment36","raw_text":"进炮兑掉一炮后战线大大延长，但少卒太多，败势依然难以改变。","text":"进炮兑掉一炮后战线大大延长，但少卒太多，败势依然难以改变。","source_line_id":"0","source_after_ply":36,"anchor_node_id":"0:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment39:0","source_tag":"DhtmlXQ_comment39","raw_text":"多兵胜","text":"多兵胜","source_line_id":"0","source_after_ply":39,"anchor_node_id":"0:39","status":"attached","conflicting_field":false}],"issues":[],"metadata":