7进2的巧手，虽于局势小有益处，但已难挽颓着势.","source_line_id":"0","source_after_ply":36,"anchor_node_id":"0:36","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment47:0","source_tag":"DhtmlXQ_comment47","raw_text":"红胜|| 黑虽拥有重兵，但对红下一着马五进四再炮一平五的杀着，却是爱莫能助了，只好认负。","text":"红胜\n 黑虽拥有重兵，但对红下一着马五进四再炮一平五的杀着，却是爱莫能助了，只好认负。","source_line_id":"0","source_after_ply":47,"anchor_node_id":"0:47","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["林业张明忠 先胜 广东邓领宏"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_date":["1989年10月16日"],"DhtmlXQ_open":["C45 中炮过河车互进七兵对屏风马平炮兑车"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":13,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":47,"legal_move_records":47,"annotations":4,"annotation_statuses":{"attached":4}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第一章 中炮对屏风马类 林业张明忠 先胜 广东邓领宏","catalogue_order":19,"directory_url":"https://m.xiangqiqipu.com/Category/list-66.html"}],"book_ids":["yl-book-66"]}}
