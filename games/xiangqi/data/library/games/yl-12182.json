"0:41","0:42","0:43","0:44","0:45","0:46","0:47","0:48","0:49"],"first_failure":null,"last_legal_node_id":"0:49","path_plies":49,"final_legal_fen":"C3kab2/4a1r2/nR2c1n2/pC2p3p/2b6/6P2/P3P3P/6N2/9/2BAKAB2 b - - 0 25"}],"annotations":[{"id":"DhtmlXQ_comment18:0","source_tag":"DhtmlXQ_comment18","raw_text":"黑升车保马，子力结构显得呆滞，莫如马3退1，避红锐气，以保持子力的灵活性为好。","text":"黑升车保马，子力结构显得呆滞，莫如马3退1，避红锐气，以保持子力的灵活性为好。","source_line_id":"0","source_after_ply":18,"anchor_node_id":"0:18","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment22:0","source_tag":"DhtmlXQ_comment22","raw_text":"黑方补士自阻两翼的联系，不战自乱，实不如车8进1相机右调驰援，或者马3退2以便灵活子力，虽均守势，尚无大碍。","text":"黑方补士自阻两翼的联系，不战自乱，实不如车8进1相机右调驰援，或者马3退2以便灵活子力，虽均守势，尚无大碍。","source_line_id":"0","source_after_ply":22,"anchor_node_id":"0:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment24:0","source_tag":"DhtmlXQ_comment24","raw_text":"红升左车准备逼兑黑右车，以使黑方右翼更加虚弱，攻击方法正确，着法紧凑。黑左车巡河并不能阻止红方发动攻势，可走炮5平6，以下红如车九平八，则车2进5，炮五平八，象7进5，在被动中顽强防守才是。","text":"红升左车准备逼兑黑右车，以使黑方右翼更加虚弱，攻击方法正确，着法紧凑。黑左车巡河并不能阻止红方发动攻势，可走炮5平6，以下红如车九平八，则车2进5，炮五平八，象7进5，在被动中顽强防守才是。","source_line_id":"0","source_after_ply":24,"anchor_node_id":"0:24","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment32:0","source_tag":"DhtmlXQ_comment32","raw_text":"黑最终还需退马，白送7卒，已处劣势。现黑边炮平肋驱马入卧槽，无异于引水入墙，应炮5平6勉力支撑，尚不致速败。","text":"黑最终还需退马，白送7卒，已处劣势。现黑边炮平肋驱马入卧槽，无异于引水入墙，应炮5平6勉力支撑，尚不致速败。","source_line_id":"0","source_after_ply":32,"anchor_node_id":"0:32","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment38:0","source_tag":"DhtmlXQ_comment38","raw_text":"如图形势，红方进炮打车好棋，可破坏黑的防守结构，利于扩展攻势。实战中黑方选择士5退4，结果失利，可改走士5进6，以下车六进三，车6平7，炮八退七，红方占优，但战线尚长。","text":"如图形势，红方进炮打车好棋，可破坏黑的防守结构，利于扩展攻势。实战中黑方选择士5退4，结果失利，可改走士5进6，以下车六进三，车6平7，炮八退七，红方占优，但战线尚长。","source_line_id":"0","source_after_ply":38,"anchor_node_id":"0:38","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment48:0","source_tag":"DhtmlXQ_comment48","raw_text":"如改走炮2退2，则车六进二，将5进1，炮八进二，红胜。","text":"如改走炮2退2，则车六进二，将5进1，炮八进二，红胜。","source_line_id":"0","source_after_ply":48,"anchor_node_id":"0:48","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment49:0","source_tag":"DhtmlXQ_comment49","raw_text":"红胜。||三子归边，必胜。","text":"红胜。\n三子归边，必胜。","source_line_id":"0","source_after_ply":49,"anchor_node_id":"0:49","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["069北京洪磊鑫 先胜 浙江胡容儿"],"DhtmlXQ_event":["第二章 顺手炮、列手炮(32局)"],"DhtmlXQ_redteam":[""],"DhtmlXQ_redrating":[""],"DhtmlXQ_black":[" "],"DhtmlXQ_blackteam":[""],"DhtmlXQ_blackrating":[""],"DhtmlXQ_result":["未知"],"DhtmlXQ_open":["D10 顺炮直车对缓开车"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":21,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":49,"legal_move_records":49,"annotations":7,"annotation_statuses":{"attached":7}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第二章 顺手炮、列手炮 北京洪磊鑫 先胜 浙江胡容儿","catalogue_order":68,"directory_url":"https://m.xiangqiqipu.com/Category/List-66-3.html"}],"book_ids":["yl-book-66"]}}
