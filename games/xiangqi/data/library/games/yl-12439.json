0:23","0:24","0:25","0:26","0:27","0:28","0:29","0:30","0:31","0:32","0:33","0:34","0:35","0:36","0:37","0:38","0:39","0:40","0:41","0:42","0:43","0:44","0:45","0:46","0:47","0:48","0:49"],"first_failure":null,"last_legal_node_id":"0:49","path_plies":49,"final_legal_fen":"2r1kab2/1c5C1/2nab4/p1R4Np/4p2n1/9/P1P5P/4C4/4A4/2BAK4 b - - 6 25"}],"annotations":[{"id":"DhtmlXQ_comment12:0","source_tag":"DhtmlXQ_comment12","raw_text":" 红在此形势下高左横车，演变成少见的布局类型。黑方平炮兑车则显得过于拘泥老格式，可改走炮2平1，先亮出1路车，针对性较强，颇具反弹力。","text":" 红在此形势下高左横车，演变成少见的布局类型。黑方平炮兑车则显得过于拘泥老格式，可改走炮2平1，先亮出1路车，针对性较强，颇具反弹力。","source_line_id":"0","source_after_ply":12,"anchor_node_id":"0:12","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment15:0","source_tag":"DhtmlXQ_comment15","raw_text":"红冲中兵由中路出击，攻击方向正确。","text":"红冲中兵由中路出击，攻击方向正确。","source_line_id":"0","source_after_ply":15,"anchor_node_id":"0:15","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment19:0","source_tag":"DhtmlXQ_comment19","raw_text":" 黑方一直套用“平炮兑车”的路数，殊不知由子红方阵势的不同，现被红横车串住车马，也就不足为奇了。红已全面控制了局势，黑方反击力大大降低。","text":" 黑方一直套用“平炮兑车”的路数，殊不知由子红方阵势的不同，现被红横车串住车马，也就不足为奇了。红已全面控制了局势，黑方反击力大大降低。","source_line_id":"0","source_after_ply":19,"anchor_node_id":"0:19","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment22:0","source_tag":"DhtmlXQ_comment22","raw_text":" 冲卒易引起双方的正面交锋，因黑1路车尚未出动，不能参战，对局势的发展不利。不若改走卒7平8，以下如马三进五，则马8退7，虽居后手，但局势稍徽缓和一些。","text":" 冲卒易引起双方的正面交锋，因黑1路车尚未出动，不能参战，对局势的发展不利。不若改走卒7平8，以下如马三进五，则马8退7，虽居后手，但局势稍徽缓和一些。","source_line_id":"0","source_after_ply":22,"anchor_node_id":"0:22","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment29:0","source_tag":"DhtmlXQ_comment29","raw_text":"正面接触的结果，形成了子力的拼兑，现黑车仍处边睡局势已大大落后。红进中兵加紧攻击，果断有力。","text":"正面接触的结果，形成了子力的拼兑，现黑车仍处边睡局势已大大落后。红进中兵加紧攻击，果断有力。","source_line_id":"0","source_after_ply":29,"anchor_node_id":"0:29","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment37:0","source_tag":"DhtmlXQ_comment37","raw_text":"此时形势，红方不取7卒，抢先进车卒林控制要道，||着法凶狠有力。|| “兵之情主速，乘人之不及，由不虞之道，攻其所不戒也。”红方抓住时机猛攻，深得兵家之要。","text":"此时形势，红方不取7卒，抢先进车卒林控制要道，\n着法凶狠有力。\n “兵之情主速，乘人之不及，由不虞之道，攻其所不戒也。”红方抓住时机猛攻，深得兵家之要。","source_line_id":"0","source_after_ply":37,"anchor_node_id":"0:37","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment43:0","source_tag":"DhtmlXQ_comment43","raw_text":" 势成方动炮，此时击卒犹如顺风满帆，势不可挡。以下红方取胜过程十分轻松，好象囊中取物一般。","text":" 势成方动炮，此时击卒犹如顺风满帆，势不可挡。以下红方取胜过程十分轻松，好象囊中取物一般。","source_line_id":"0","source_after_ply":43,"anchor_node_id":"0:43","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment47:0","source_tag":"DhtmlXQ_comment47","raw_text":"进炮，最后一击，着法巧妙。","text":"进炮，最后一击，着法巧妙。","source_line_id":"0","source_after_ply":47,"anchor_node_id":"0:47","status":"attached","conflicting_field":false},{"id":"DhtmlXQ_comment49:0","source_tag":"DhtmlXQ_comment49","raw_text":"红胜。","text":"红胜。","source_line_id":"0","source_after_ply":49,"anchor_node_id":"0:49","status":"attached","conflicting_field":false}],"issues":[],"metadata":{"DhtmlXQ_init":["500,350"],"DhtmlXQ_title":["辽宁卜凤波 先胜 北京喻之青"],"DhtmlXQ_event":["第一章 中炮对屏风马类（56局）"],"DhtmlXQ_open":["C18 中炮过河车七路马对屏风马"],"DhtmlXQ_remark":[""],"DhtmlXQ_author":[""],"DhtmlXQ_binit":["0919293949596979891777062646668600102030405060708012720323436383"]},"source_tag_count":17,"identical_tag_duplicates":0,"binit":"0919293949596979891777062646668600102030405060708012720323436383","side_to_move":"w","side_basis":"color of first source mover at binit square","standard_start":true,"summary":{"lines":1,"structured_branches":0,"line_statuses":{"legal":1},"source_move_records":49,"legal_move_records":49,"annotations":9,"annotation_statuses":{"attached":9}},"memberships":[{"book_id":"yl-book-66","category_id":"66","title":"第一章 中炮对屏风马类 辽宁卜凤波 先胜 北京喻之青","catalogue_order":5,"directory_url":"https://m.xiangqiqipu.com/Category/list-66.html"}],"book_ids":["yl-book-66"]}}
