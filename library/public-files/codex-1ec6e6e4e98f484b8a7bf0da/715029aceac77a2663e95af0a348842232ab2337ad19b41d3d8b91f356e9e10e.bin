<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light">
<title>MA3 — 看得见的协作</title>
<meta name="description" content="从 Linux 与 tmux 出发的 MA3 方案，含现成项目调研与可交互的协作流程演示。">
<style>
:root{--paper:#f1f0e9;--surface:#faf9f5;--ink:#243b32;--muted:#59665e;--line:#d6dbd1;--green:#365d49;--lime:#d7e8a2;--sand:#e7dfce;--night:#20352d;--mono:'DejaVu Sans Mono',monospace;--body:'Noto Sans CJK SC','Microsoft YaHei',sans-serif;--display:'Noto Serif CJK SC',Georgia,serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:105px}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.8 var(--body)}button{font:inherit;cursor:pointer}a{color:inherit;text-underline-offset:5px}button:focus-visible,a:focus-visible,[tabindex]:focus-visible{outline:3px solid #638531;outline-offset:5px}::selection{background:var(--lime)}.wrap{width:min(1280px,calc(100% - 96px));margin:auto}.nav{position:sticky;top:18px;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:24px;width:min(1000px,calc(100% - 40px));margin:18px auto 0;padding:12px 22px;border:1px solid #fff9;border-radius:100px;background:#faf9f5ed;backdrop-filter:blur(18px);box-shadow:0 8px 35px #20352d08}.brand{font:700 19px var(--mono);text-decoration:none;letter-spacing:-1px}.brand span{font-size:10px;margin-left:8px;letter-spacing:1px;color:var(--muted)}.navlinks{display:flex;gap:24px;font-size:12px}.navlinks a{text-decoration:none}.navmeta{font:10px var(--mono);color:var(--muted)}.eyebrow{font:11px var(--mono);letter-spacing:2px;color:var(--muted);display:flex;align-items:center;gap:10px}.dot{width:7px;height:7px;background:var(--green);border-radius:50%;display:inline-block}.hero{display:grid;grid-template-columns:1.06fr 1fr;align-items:center;gap:60px;padding:94px 0 70px}.hero h1{font:600 clamp(42px,4.3vw,65px)/1.4 var(--display);letter-spacing:-2.5px;margin:22px 0}.hero h1 em{font-style:normal;color:#5c7357}.hero p{max-width:470px;color:var(--muted);line-height:2;font-size:15px}.actions{display:flex;align-items:center;gap:24px;margin-top:32px}.cta{background:var(--green);color:white;display:inline-flex;align-items:center;gap:32px;text-decoration:none;padding:8px 8px 8px 23px;border-radius:50px;font-size:13px}.cta b{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#ffffff20;font-size:20px;font-weight:400}.quiet{font-size:12px;color:var(--muted)}.heronote{margin-top:25px;font:10px var(--mono);color:var(--muted)}.bezel{background:#e2e5d9;padding:10px;border-radius:36px;box-shadow:0 22px 60px #263b3210}.terminal{border-radius:27px;overflow:hidden;background:var(--night);color:#e7eee3;min-width:0}.terminalbar{display:flex;align-items:center;justify-content:space-between;padding:15px 19px;background:#ffffff06;border-bottom:1px solid #ffffff12;font:10px var(--mono);color:#b8c6bc}.lights{display:flex;gap:5px}.lights i{height:6px;width:6px;background:#96a990;border-radius:50%}.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#ffffff18}.mini-pane{background:var(--night);padding:22px 18px;min-height:130px;font:11px/1.9 var(--mono)}.mini-pane:first-child{grid-column:span 2;min-height:126px}.minilabel{color:#adc3b0;font:9px var(--mono);letter-spacing:1px;margin-bottom:15px}.mini-pane strong{font-weight:400;color:var(--lime)}.mini-pane p{font:11px/1.9 var(--mono);color:#d6dfd4;margin:6px 0}.mini-footer{padding:15px 18px;color:#c0cbbd;font-size:11px}.mini-footer span{color:var(--lime)}.hero .caption{font-size:11px;color:var(--muted);margin:14px 10px 0}.factstrip{border-block:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);padding:24px 0;gap:24px}.factstrip strong{display:block;font:20px var(--mono);margin-bottom:6px}.factstrip span{font-size:11px;color:var(--muted)}section.content{padding:88px 0 0}.sectionhead{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:28px}.sectionhead h2{font:600 33px/1.5 var(--display);letter-spacing:-1px;margin:12px 0 0}.sectionhead>p{max-width:430px;color:var(--muted);font-size:13px;margin:0}.tag{font:10px var(--mono);display:inline-block;border:1px solid var(--line);border-radius:30px;padding:4px 10px;color:var(--muted);white-space:nowrap}.tag.green{background:var(--lime);color:var(--night);border-color:transparent}.decision{display:grid;grid-template-columns:1.3fr 1fr;gap:12px}.decision-main{background:var(--green);color:#f7f9ef;border-radius:30px;padding:36px}.decision-main .eyebrow{color:#d5dfd1}.decision-main h3{font-size:25px;font-weight:500;margin:15px 0 14px}.decision-main p{font-size:13px;line-height:2;color:#e0e9da}.smallline{margin-top:24px;padding-top:19px;border-top:1px solid #ffffff25;color:#d8e6c6;font-size:12px}.choicebox{background:var(--surface);border-radius:30px;padding:28px}.choices{display:flex;flex-wrap:wrap;gap:6px}.choice,.filter{border:1px solid var(--line);background:transparent;border-radius:30px;padding:7px 13px;font-size:11px;color:var(--muted)}.choice[aria-pressed=true],.filter[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:white}.choicebox h3{font-size:20px;margin:22px 0 10px}.choicebox p{font-size:13px;color:var(--muted);min-height:82px}.detail{border-top:1px solid var(--line);padding-top:14px;font-size:12px}.simbox{background:#e3e6db;padding:10px;border-radius:34px}.siminner{background:var(--surface);border-radius:26px;padding:24px}.simtoolbar{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:24px}.segmented{display:flex;gap:5px;flex-wrap:wrap}.segmented button{padding:9px 17px;border:0;border-radius:30px;background:transparent;color:var(--muted);font-size:12px}.segmented button[aria-pressed=true]{background:var(--sand);color:var(--ink)}.sim-layout{display:grid;grid-template-columns:190px 1fr;gap:20px}.steplist{display:flex;flex-direction:column;gap:7px}.step{display:flex;align-items:center;gap:12px;text-align:left;padding:12px;border:1px solid transparent;border-radius:14px;background:transparent;color:var(--muted);font-size:12px}.step span{font:11px var(--mono);color:#718067}.step[aria-current=step]{background:#e8eddd;border-color:#d0d9bd;color:var(--ink)}.workbench{background:var(--night);border-radius:20px;padding:16px;min-width:0;color:#e8eee5}.benchbar{display:flex;justify-content:space-between;font:10px var(--mono);color:#b4c5b5;gap:10px;margin-bottom:14px}.panes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.pane{border:1px solid #ffffff18;background:#ffffff03;border-radius:12px;padding:15px;min-height:205px;min-width:0}.pane.active{border-color:#b6cb85;background:#ccdb9d09}.pane-top{display:flex;gap:8px;justify-content:space-between;align-items:center;margin-bottom:22px}.pane-name{font:10px var(--mono)}.badge{font-size:9px;color:#ccd6c8;background:#ffffff0c;border-radius:20px;padding:2px 7px;white-space:nowrap}.pane.active .badge{background:#d7e8a2;color:#253a2c}.pane pre{font:11px/1.95 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere;margin:0;color:#d6e2d2}.receipt{margin-top:12px;background:#15291f;border-radius:12px;padding:15px;display:flex;gap:20px;align-items:flex-start}.receipt-label{font:10px var(--mono);color:#bacb9d;padding-top:2px;flex:0 0 58px}.receipt pre{font:10px/1.8 var(--mono);color:#d6e2d2;margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.sim-bottom{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin-top:23px}.sim-explain{max-width:690px}.sim-explain h3{font-size:17px;margin:0 0 6px}.sim-explain p{font-size:12px;color:var(--muted);margin:0;line-height:1.95;min-height:46px}.controls{display:flex;gap:8px;flex-shrink:0}.controls button{border:1px solid var(--line);border-radius:30px;background:var(--surface);font-size:12px;padding:10px 17px;color:var(--ink)}.controls .next{background:var(--green);border-color:var(--green);color:white}.sim-note{color:var(--muted);font-size:11px;margin:15px 10px 0}.architecture{display:grid;grid-template-columns:1fr 1fr;gap:12px}.layer{background:var(--surface);padding:28px;border-radius:26px;min-width:0}.layer b{font:11px var(--mono);color:var(--muted)}.layer h3{font-size:20px;font-weight:500;margin:12px 0}.layer p{font-size:12px;line-height:2;color:var(--muted);margin:0}.layer code{display:block;margin-top:18px;border-top:1px solid var(--line);padding-top:16px;font:11px/1.8 var(--mono);overflow-wrap:anywhere;color:#4e674d}.principle{display:flex;gap:22px;padding:25px 28px;margin-top:12px;background:var(--sand);border-radius:23px;align-items:center}.principle strong{font-size:16px;flex-shrink:0}.principle p{margin:0;font-size:12px;line-height:1.9}.filters{display:flex;gap:8px;margin:25px 0 20px;flex-wrap:wrap}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.project{background:var(--surface);border:1px solid #e3e5dd;border-radius:26px;padding:26px;display:flex;flex-direction:column;min-width:0}.project[hidden]{display:none}.project.featured{border-color:#b5c79f;background:#edf1e2}.project-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.project-num{font:10px var(--mono);color:var(--muted)}.project h3{font-size:22px;letter-spacing:-.7px;margin:21px 0 6px;font-weight:500}.subtitle{font-size:12px;color:var(--muted);margin:0 0 20px;min-height:43px}.project dl{margin:0;flex:1}.project dt{font-size:10px;color:#587045;margin-top:13px;font-weight:600}.project dd{margin:4px 0 0;font-size:12px;line-height:1.95}.project a{font-size:11px;margin-top:25px;align-self:flex-start}.count{font:11px var(--mono);color:var(--muted);margin-left:auto;align-self:center}.table-shell{margin-top:25px;background:var(--surface);border-radius:26px;overflow:hidden;padding:8px 20px}.scrolltable{overflow:auto}table{width:100%;border-collapse:collapse;min-width:690px;text-align:left;font-size:12px}th{font-weight:500;color:var(--muted);font-size:10px;padding:18px 13px}td{padding:18px 13px;border-top:1px solid var(--line)}td:first-child{font-weight:500}.table-note{font-size:11px;color:var(--muted);padding:8px 13px 15px;line-height:1.9}.milestones{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.milestone{padding:26px;background:var(--surface);border-radius:25px}.milestone .n{font:38px var(--display);color:#718067}.milestone h3{font-size:17px;margin:17px 0 13px}.milestone p{font-size:12px;color:var(--muted);line-height:2;margin:0}.acceptance{margin-top:20px;border-top:1px solid var(--line);padding-top:15px;font-size:11px;line-height:1.9}.acceptance strong{display:block;font-size:10px;color:#587045;margin-bottom:5px}.scope{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;margin-top:35px;padding:32px;border:1px solid var(--line);border-radius:26px}.scope h3{font-size:18px;margin:0 0 12px}.scope p{color:var(--muted);font-size:12px;margin:0;line-height:2}.scope pre{font:11px/1.85 var(--mono);color:var(--muted);margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.sources{display:grid;grid-template-columns:1.2fr 1fr;gap:45px;background:#e7e9e0;border-radius:30px;padding:34px}.sources h3{font-size:17px;margin:0 0 13px}.sources p{font-size:12px;color:var(--muted);line-height:2}.source-links{display:flex;flex-direction:column;gap:10px;font-size:12px}.source-links a{overflow-wrap:anywhere}.source-links small{color:var(--muted);font-size:10px}.foot{display:flex;justify-content:space-between;gap:20px;padding:45px 0;font:10px var(--mono);color:var(--muted)}.foot a{font-family:var(--body)}.reveal{animation:enter .7s cubic-bezier(.32,.72,0,1) both}@keyframes enter{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}.skip{position:absolute;left:-10000px}.skip:focus{left:20px;top:20px;z-index:100;background:white;padding:10px}
@media(max-width:1100px){.wrap{width:calc(100% - 56px)}.hero{gap:32px}.panes{grid-template-columns:1fr}.pane{min-height:110px}.pane-top{margin-bottom:10px}.projects{grid-template-columns:repeat(2,1fr)}.milestones{grid-template-columns:repeat(2,1fr)}.sim-layout{grid-template-columns:160px 1fr}.hero h1{font-size:47px}.navmeta{display:none}}
@media(max-width:720px){.wrap{width:calc(100% - 32px)}.nav{top:10px;margin-top:10px;padding:10px 17px;width:calc(100% - 24px)}.brand{font-size:17px}.brand span{display:none}.navlinks{gap:17px;font-size:11px}.navlinks a:last-child{display:none}.hero{grid-template-columns:1fr;padding:58px 0 38px;gap:35px}.hero h1{font-size:43px;letter-spacing:-1.8px;margin-top:18px}.hero p{font-size:14px;max-width:100%}.heronote{font-size:9px}.mini-pane{min-height:105px}.factstrip{grid-template-columns:repeat(2,1fr);gap:24px}.factstrip strong{font-size:17px}.sectionhead{display:block;margin-bottom:23px}.sectionhead h2{font-size:28px}.sectionhead>p{margin-top:15px}.decision,.architecture,.sources,.scope{grid-template-columns:1fr}.decision-main{padding:27px}.choicebox{padding:24px}.choicebox p{min-height:0}.siminner{padding:15px}.simtoolbar{display:block}.simtoolbar .tag{margin-top:12px;font-size:9px}.segmented button{padding:8px 10px;font-size:11px}.sim-layout{grid-template-columns:1fr}.steplist{flex-direction:row;overflow-x:auto;padding-bottom:5px;gap:5px}.step{padding:9px;flex:0 0 auto;gap:7px;font-size:10px}.workbench{padding:13px}.panes{grid-template-columns:1fr}.pane{min-height:105px;padding:13px}.receipt{gap:10px;padding:13px}.receipt-label{flex-basis:43px;font-size:9px}.receipt pre{font-size:9px}.benchbar{font-size:8px;flex-wrap:wrap}.sim-bottom{flex-direction:column;gap:16px}.sim-explain p{min-height:60px}.controls{width:100%}.controls button{flex:1}.sim-note{font-size:10px}.layer{padding:25px}.principle{display:block;padding:23px}.principle p{margin-top:10px}.projects{grid-template-columns:1fr}.project{padding:24px}.subtitle{min-height:0}.project h3{margin-top:16px}.milestones{grid-template-columns:1fr 1fr;gap:9px}.milestone{padding:19px}.milestone h3{font-size:15px}.milestone .n{font-size:31px}.scope{padding:25px;gap:22px}.sources{padding:25px;gap:24px}.table-shell{padding:6px 8px}.count{width:100%;margin-left:0}section.content{padding-top:65px}.foot{flex-direction:column;gap:10px;padding:30px 0}.actions{gap:20px}.cta{gap:23px}.caption{font-size:10px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{animation:none}}
@media print{.nav,.controls,.filters{display:none}.wrap{width:100%}.hero{padding:20px 0}.projects{grid-template-columns:repeat(2,1fr)}section.content{padding-top:30px}.project,.layer,.milestone{break-inside:avoid}body{-webkit-print-color-adjust:exact;print-color-adjust:exact}.scrolltable{overflow:visible}table{min-width:0}}
</style></head>
<body><a class="skip" href="#main">跳到正文</a>
<nav class="nav" aria-label="主要导航"><a class="brand" href="#">MA3<span>FIELD NOTES / 03</span></a><div class="navlinks"><a href="#decision">方案</a><a href="#demo">运行演示</a><a href="#research">项目调研</a><a href="#roadmap">实施路径</a></div><span class="navmeta">LINUX · TMUX · LOCAL</span></nav>
<main id="main" class="wrap">
<header class="hero reveal"><div><div class="eyebrow"><span class="dot"></span>A NEW START, ON LINUX</div><h1>让 Agent 协作，<br><em>也让过程可见。</em></h1><p>从 tmux 出发，重新设计 MA3。每个 Agent 都有真实终端，你可以进入、观察和干预；任务交接则留下可核验的回执。</p><div class="actions"><a class="cta" href="#demo">走一遍工作流 <b aria-hidden="true">↗</b></a><a class="quiet" href="#research">查看现成项目</a></div><div class="heronote">RESEARCH 2026.09.08 / 方案阶段 · 尚未实现 MA3</div></div><div><div class="bezel"><div class="terminal"><div class="terminalbar"><div class="lights" aria-hidden="true"><i></i><i></i><i></i></div><span>ma3 / workspace</span><span>tmux</span></div><div class="mini-grid"><div class="mini-pane"><div class="minilabel">01 / COORDINATOR</div><strong>› 一份任务，清楚的交接。</strong><p>派发 → 回执 → 验收 → 下一步</p></div><div class="mini-pane"><div class="minilabel">02 / CODEX</div><strong>writer</strong><p>独立 worktree<br>提交代码与证据</p></div><div class="mini-pane"><div class="minilabel">03 / CLAUDE</div><strong>reviewer</strong><p>读取指定版本<br>复核 · 提出问题</p></div></div><div class="mini-footer"><span>Ctrl+b d</span> 离开视图，任务继续运行。</div></div></div><p class="caption">布局示意。原生 CLI 窗格给人操作，结构化回执给程序判断。</p></div></header>
<div class="factstrip"><div><strong>tmux 3.2a</strong><span>本机已安装 · 暂不升级</span></div><div><strong>Codex + Claude</strong><span>CLI 入口已定位 · 接入待实测</span></div><div><strong>01 → 02 → 03</strong><span>先交接，再扩展并行与轮转</span></div><div><strong>~/PG_linux/MA3</strong><span>独立 Linux 工作目录</span></div></div>

<section class="content" id="decision"><div class="sectionhead"><div><div class="eyebrow">01 / THE DECISION</div><h2>以 tmux 为底座，<br>只写必要的协调层。</h2></div><p>不迁移 MA2 框架。保留它教会我们的几件事：结果要验证，交接要有版本，失败不能吞掉已有成果。</p></div><div class="decision"><article class="decision-main"><div class="eyebrow">RECOMMENDED / 推荐主线</div><h3>原生 tmux + 轻量 MA3</h3><p>Python 控制器管理任务、窗格和回执。Codex、Claude 运行在可进入的交互窗格中。Worker 用统一命令领取与提交任务，控制器验证后推进流程。</p><div class="smallline">先实现一个闭环：写代码 → 独立审查 → 最多两轮返工。</div></article><article class="choicebox"><div class="choices" aria-label="比较采用路线"><button class="choice" data-route="custom" aria-pressed="true">轻量自建</button><button class="choice" data-route="agentmux" aria-pressed="false">先用 AgentMux</button><button class="choice" data-route="aoe" aria-pressed="false">先用工作台</button></div><div aria-live="polite"><h3 id="route-title"></h3><p id="route-desc"></p><div class="detail" id="route-detail"></div></div></article></div></section>

<section class="content" id="demo"><div class="sectionhead"><div><div class="eyebrow">02 / WALK THROUGH IT</div><h2>一次任务，如何穿过三个窗格。</h2></div><p>切换场景，逐步查看每个角色的工作和交接凭据。文本与 ID 都是示例，不是真实 Agent 执行日志。</p></div><div class="simbox"><div class="siminner"><div class="simtoolbar"><div class="segmented" aria-label="演示场景"><button data-scenario="code" aria-pressed="true">代码与复核</button><button data-scenario="chess" aria-pressed="false">国际象棋轮转</button><button data-scenario="research" aria-pressed="false">并行调研</button></div><span class="tag">INTERACTIVE SCHEMATIC · 方案模拟</span></div><div class="sim-layout"><div class="steplist" id="steps" aria-label="工作流步骤"></div><div class="workbench"><div class="benchbar"><span id="bench-title"></span><span>终端视图 · 示例内容</span></div><div class="panes" id="panes"></div><div class="receipt"><div class="receipt-label">RECEIPT<br>正式回执</div><pre id="receipt"></pre></div></div></div><div class="sim-bottom"><div class="sim-explain" aria-live="polite"><h3 id="step-title"></h3><p id="step-desc"></p></div><div class="controls"><button id="reset">重新开始</button><button id="next" class="next">下一步 →</button></div></div></div></div><div class="sim-note">首版只做代码闭环；下棋和并行调研展示后续扩展方向。演示不调用模型、不执行命令，也不展示隐藏推理。</div></section>

<section class="content" id="architecture"><div class="sectionhead"><div><div class="eyebrow">03 / THE SMALL CORE</div><h2>四个模块，分清各自负责什么。</h2></div><p>Python 适合当前环境，首版用标准库 SQLite、JSON 与 subprocess。终端界面由 CLI 和 tmux 提供，无需先做 Web 控制台。</p></div><div class="architecture">
<article class="layer"><b>01 / SESSION HOST</b><h3>tmux：承载真实 CLI</h3><p>一个 MA3 专属 session。协调、编写、审查各有窗格；保存 pane ID 与会话代次。用绝对路径启动 CLI，避免继承旧 tmux 环境造成 PATH 问题。</p><code>create · attach · inspect · interrupt</code></article>
<article class="layer"><b>02 / TASK CONTROLLER</b><h3>控制器：推进任务状态</h3><p>串行处理领取和提交，在 SQLite 中维护任务、尝试与消息。状态只由控制器迁移。超时先核对结果和进程，再决定重试，避免重复工作。</p><code>queued → offered → accepted → submitted → verified</code></article>
<article class="layer"><b>03 / AGENT CONTRACT</b><h3>统一回执：确认真的交接</h3><p>正文存到任务文件，窗格只接收简短引用。Worker 显式领取，再提交带 attempt、产物路径和 commit 的回执。重复提交幂等，旧回执不推进新任务。</p><code>ma3 claim &lt;task&gt; · ma3 submit &lt;task&gt; --result …</code></article>
<article class="layer"><b>04 / ARTIFACTS & REVIEW</b><h3>版本与证据：让复核站得住</h3><p>写入任务各自拥有 worktree。审查针对固定 commit，不看一个不断变化的目录。测试或规则引擎负责确定性验收；模型负责语义判断。</p><code>task.json · result.json · commit · review.json</code></article></div><div class="principle"><strong>发送成功 ≠ 领取成功 ≠ 验收通过</strong><p>tmux 输入只是唤醒提示。短提示投递后若没有领取回执，标为待介入；绝不无限重复按 Enter。屏幕状态可作辅助提示，不能单独宣告业务完成。</p></div></section>

<section class="content" id="research"><div class="sectionhead"><div><div class="eyebrow">04 / EXISTING PROJECTS</div><h2>有现成项目，值得认真借鉴。</h2></div><p>开放式检索后读取官方 README 与重点文档。这里比较实际机制，不用星数打分；“文档确认”均不代表本机跑通。</p></div><div class="filters" aria-label="筛选项目"><button class="filter" data-filter="all" aria-pressed="true">全部</button><button class="filter" data-filter="workflow" aria-pressed="false">编排与协作</button><button class="filter" data-filter="workspace" aria-pressed="false">会话工作台</button><button class="filter" data-filter="messaging" aria-pressed="false">消息机制</button><span class="count" id="project-count" aria-live="polite">6 PROJECTS / 官方材料核对</span></div><div class="projects" id="projects"></div>
<div class="table-shell"><div class="scrolltable" role="region" aria-label="推荐路线比较，可横向滚动" tabindex="0"><table><thead><tr><th>路线</th><th>真实 CLI 可介入</th><th>推进依据</th><th>本机门槛</th><th>建议角色</th></tr></thead><tbody><tr><td>轻量 MA3</td><td>计划提供</td><td>领取 / 提交回执 + 验收</td><td>现有 tmux；逻辑待实现</td><td>本次主线</td></tr><tr><td>AgentMux</td><td>文档确认</td><td>文件 + 验证后的工具事件</td><td>Python 3.10+；独立环境</td><td>首要对照</td></tr><tr><td>CAO</td><td>文档确认</td><td>Provider 检测 + 编排服务</td><td>tmux ≥3.3</td><td>架构参考</td></tr><tr><td>Agent of Empires</td><td>文档确认</td><td>会话 / 状态管理</td><td>需安装并验证版本</td><td>即用工作台</td></tr></tbody></table></div><p class="table-note">没有做本机产品安装或真实 Agent 对照实验。“可介入”还受 CLI 就绪、审批和忙碌状态影响；正式回执只证明已提交，业务正确性由验收决定。</p></div></section>

<section class="content" id="roadmap"><div class="sectionhead"><div><div class="eyebrow">05 / BUILD IN SMALL STEPS</div><h2>每一步，都有可证伪的验收。</h2></div><p>先把一次协作做可靠，再增加角色数量。首版限制三个 Agent 角色、单机、一个写入任务，不建设通用 DAG 平台。</p></div><div class="milestones">
<article class="milestone"><span class="n">01</span><h3>三个可进入的窗格</h3><p>定位 CLI、创建独立 session，启动协调者、编写者与审查者。项目级规则，不修改全局人格。</p><div class="acceptance"><strong>验收</strong>中文长任务能定向送达；detach/attach 后仍能进入；等待输入时如实标注。</div></article>
<article class="milestone"><span class="n">02</span><h3>一个交接闭环</h3><p>任务领取、提交收据、固定版本复核。首版用 CLI 回执接口，后续再考虑 MCP。</p><div class="acceptance"><strong>验收</strong>重复 submit 不重复推进；过期 attempt 被拒；没有回执不能进入审查。</div></article>
<article class="milestone"><span class="n">03</span><h3>中断与人工接管</h3><p>暂停自动派发后进入目标 pane；人工改动关联当前任务；恢复时核对产物和会话代次。</p><div class="acceptance"><strong>验收</strong>关闭 Worker、重启控制器不丢成果；未知状态不自动重做；不误杀其他会话。</div></article>
<article class="milestone"><span class="n">04</span><h3>扩展并比较</h3><p>增加独立 worktrees 的并行任务，再加入下棋轮转。保留同任务的单 Agent 基线。</p><div class="acceptance"><strong>验收</strong>记录耗时、费用可知范围、遗漏与介入；没有提升就减少角色，不为多而多。</div></article></div>
<div class="scope"><div><h3>第一轮演示任务</h3><p>给一个小型命令行工具补输入校验。Codex 实施，Claude 对指定 commit 复核，控制器运行测试并按问题 ID 返工。演示“可见、可交接、可打断”，不拿复杂业务遮住机制。</p><p style="margin-top:15px">三种恢复分别验收：终端 detach 后继续；控制器重启后重建状态；Agent / 机器重启后新建会话并显式恢复上下文。它们不是同一种能力。</p></div><pre>MA3/                       ← 未来拟议结构
  ma3/                     控制器与 tmux 适配
  roles/                   项目级角色契约
  examples/                可重复验收任务
  runs/&lt;run-id&gt;/
    state.db               单一状态来源
    tasks/ · results/      输入与正式回执
    events.jsonl           审计导出
  worktrees/               写入任务独立

当前只有调研与 HTML；上面尚未实现。</pre></div></section>
<section class="content" id="sources"><div class="sources"><div><div class="eyebrow">06 / EVIDENCE, NOT PROMISES</div><h3 style="margin-top:16px">这份方案的证据边界</h3><p>搜索使用 smart-websearch，成功返回并报告 11 次 web search；随后读取 GitHub 官方仓库的 README、协议、恢复与 provider 文档。未依据搜索摘要直接宣告项目可靠。</p><p>AgentMux 的 “No API costs” 不适用于所有账户；费用取决于你现有 CLI 的计费。其 README 引用的一份完成阶段文档返回 404，材料存在漂移。MA3 不承诺零成本、无损恢复或隐藏推理可见。</p><p>自建选择针对学习目标与可控范围。若“尽快用起来”成为首要目标，可转为 AgentMux 隔离试用或 AoE 工作台。</p><a class="quiet" href="tmux方案与来源.md">阅读文字方案与来源记录 ↗</a></div><div class="source-links"><h3>关键一手来源</h3><a href="https://github.com/markuswondrak/AgentMux/blob/main/docs/file-protocol.md" target="_blank" rel="noopener noreferrer">01 · AgentMux 文件 / 提交协议</a><a href="https://github.com/markuswondrak/AgentMux/blob/main/docs/session-resumption.md" target="_blank" rel="noopener noreferrer">02 · AgentMux 中断恢复</a><a href="https://github.com/awslabs/cli-agent-orchestrator/blob/main/docs/codex-cli.md" target="_blank" rel="noopener noreferrer">03 · CAO 的 Codex 状态检测与限制</a><a href="https://github.com/agent-of-empires/agent-of-empires" target="_blank" rel="noopener noreferrer">04 · Agent of Empires 会话与接口</a><a href="https://github.com/NikiforovAll/tmux-message-bus" target="_blank" rel="noopener noreferrer">05 · SQLite 信箱与 best-effort 唤醒</a><a href="https://github.com/SeemSeam/claude_codex_bridge" target="_blank" rel="noopener noreferrer">06 · CCB 跨 provider 工作区</a><small>调研时间：2026-09-08 · 在线 main 分支材料会继续变化</small></div></div></section>
</main><footer class="wrap foot"><span>MA3 / LINUX FIRST, TMUX NATIVE.</span><a href="调研总结与MA3路线.md">历史复盘（本轮已调整实施方向）</a><span>展示完成 2026.09.09 · 未启动系统实施</span></footer>
<script>
const routes={
custom:['更适合这次的学习目标','把“终端为什么能协作”做成可理解、可测的小系统。首版只有 tmux、Python 标准库、Git 与已安装 CLI，不引入新平台。','代价：需自己验证启动就绪、长文本输入、回执和恢复；不承诺几个脚本就足够可靠。'],
agentmux:['如果优先尽快得到完整流程','AgentMux 已把角色窗格、文件协议、提交事件和审查返工连起来，是这次最贴近的现成方案，值得作为第一对照。','先在独立环境、临时仓库试用；验证 tmux 3.2a、自动信任行为、Git 副作用和源码授权，不直接套到日常项目。'],
aoe:['如果优先管理多个现有会话','Agent of Empires 提供 TUI / Web、worktree 和直接 attach。可以更快获得日常多 Agent 工作台，减少界面工程。','仍需验证收据、任务依赖和返工流程；会话管理能力不自动等于完整业务编排。']};
function setRoute(key){const a=routes[key];['route-title','route-desc','route-detail'].forEach((id,i)=>document.getElementById(id).textContent=a[i]);document.querySelectorAll('[data-route]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.route===key)))}
document.querySelectorAll('[data-route]').forEach(b=>b.addEventListener('click',()=>setRoute(b.dataset.route)));setRoute('custom');
const projects=[
['workflow','最优先对照','AgentMux','tmux + 文件协议 + 确定性阶段编排','角色窗格运行 Claude / Codex；MCP 提交工具验证产物并追加事件，控制器推进实施、审查与返工。文档包含恢复游标。','完整 PM→架构→计划流程比首版更重；存在自动信任处理。读取的 LICENSE 路径返回 404，复用源码前需确认授权。','短文件引用投递、显式 submit、事件重放和窗格身份。先做机制对照，不照搬整个生命周期。','https://github.com/markuswondrak/AgentMux'],
['workflow','需升级 tmux','CAO','AWS Labs · CLI Agent Orchestrator','tmux / provider 分层，HTTP、MCP 与 SQLite；Supervisor 用 handoff 和消息工具调度原生 CLI。','README 要求 tmux ≥3.3，本机为 3.2a。Codex 状态和末条回答从终端文字提取，版本兼容性需实测。','将终端生命周期与 provider 适配分开。默认权限行为、审批 UI 限制需独立核验。','https://github.com/awslabs/cli-agent-orchestrator/blob/main/docs/codex-cli.md'],
['workspace','即用型候选','Agent of Empires','tmux 会话 + TUI / Web + worktree','每个 Agent 独立 tmux session，可回到原生终端。提供状态、差异审查、CLI / HTTP API 与可选容器。','工作台功能不等于我们的验收和轮转已实现。收据、无人值守交接和故障恢复仍需按场景验证。','适合优先用好多路日常会话；若自建界面成为负担，它比继续堆 UI 更值得试。','https://github.com/agent-of-empires/agent-of-empires'],
['workflow','体系较完整','Claude Codex Bridge','CCB · 可见多 CLI 工作区与 ask 协作','按项目配置 Agent / worktree；内置 ask 协作工具、共享记忆与诊断，强调可接管的原生会话。','接管了较多角色、运行时与配置生命周期；README 包含会话迁移修复记录，需锁版本隔离试用。','不同 provider 使用统一消息入口，保留会话 lineage；不将长期身份绑死某个 pane。','https://github.com/SeemSeam/claude_codex_bridge'],
['messaging','实验项目','tmux-message-bus','SQLite WAL 信箱，持久化与唤醒分离','消息写入数据库；Claude hooks 在后续回合领取，唤醒是 best-effort。core 与 Claude 插件分开。','单机实验，不是完整工作流引擎；现有适配重点是 Claude。消息入库不保证接收者立刻开始工作。','先持久化任务，再发轻量提示。丢掉提示不丢任务；不宣称外部副作用 exactly-once。','https://github.com/NikiforovAll/tmux-message-bus'],
['workflow','非首版依赖','NTM','Named Tmux Manager · 调度与持久状态','README 描述命名窗格、worktrees、机器可读接口、Agent Mail、检查点与审计等能力，集成面较广。','LICENSE 是 MIT 加 OpenAI / Anthropic 附加限制，不能按普通 MIT 处理；未下载、运行或复用源码。','列入选型记录，首版不依赖。功能完整程度不能替代可控的依赖范围与明确授权。','https://github.com/Dicklesworthstone/ntm/blob/main/LICENSE']
];
projects.forEach((p,i)=>{const card=document.createElement('article');card.className='project'+(i===0?' featured':'');card.dataset.category=p[0];const top=document.createElement('div');top.className='project-top';const n=document.createElement('span');n.className='project-num';n.textContent=String(i+1).padStart(2,'0')+' / RESEARCH';const tag=document.createElement('span');tag.className='tag'+(i===0?' green':'');tag.textContent=p[1];top.append(n,tag);const h=document.createElement('h3');h.textContent=p[2];const sub=document.createElement('p');sub.className='subtitle';sub.textContent=p[3];const dl=document.createElement('dl');['官方材料中的机制','限制与待验证','对 MA3 的意义'].forEach((t,j)=>{const dt=document.createElement('dt');dt.textContent=t;const dd=document.createElement('dd');dd.textContent=p[j+4];dl.append(dt,dd)});const a=document.createElement('a');a.href=p[7];a.target='_blank';a.rel='noopener noreferrer';a.textContent='一手来源 ↗';card.append(top,h,sub,dl,a);document.getElementById('projects').append(card)});
const flows={
code:{name:'code-review-demo',roles:['coordinator','codex / writer','claude / reviewer'],steps:[
['建立任务','先冻结验收标准','原始要求和验收项保存到任务文件。两位执行 Agent 已有独立窗格，但不会凭聊天猜测任务范围。',0,['规划','空闲','空闲'],['› 添加 CLI 输入校验\n保存 AC-01 / AC-02\n创建 task T-01','等待任务引用\nworktree: writer-01','等待指定版本\n职责：独立复核'],'task_id: T-01\nstate: queued · attempt: 1\nacceptance: [AC-01, AC-02]'],
['派发与领取','只有领取回执，才算任务已接收','先持久化任务，再向目标 pane 投递短文件引用。Worker 执行 claim；投递成功本身不迁移到 accepted。',1,['等回执','已领取','空闲'],['投递 task/T-01.json\n收到 claim(T-01, 1)\n状态：accepted','› 读取任务文件\nma3 claim T-01\n检查输入路径','暂不开始审查\n等待实施产物'],'task_id: T-01 · attempt: 1\nstate: accepted · worker: writer-01\npane_generation: demo-g1'],
['提交实施','提交产物与版本，而非一句“做完了”','Worker 提交结果与 commit。控制器核对 task、attempt、文件，运行测试；通过后才把此版本交给审查者。',1,['检查收据','已提交','待接收'],['校验 result schema\n检查文件与版本\n测试：示例通过','补充校验与测试\ncommit: demo-v1\nma3 submit T-01 …','收到 review/demo-v1\n将从该版本复核'],'task_id: T-01 · state: submitted\nartifact: result.json · commit: demo-v1\nnext: deterministic_checks → review'],
['审查与返工','审查者指出遗漏，而不是复述实现','示例中审查发现纯空白输入遗漏。R-01 与 demo-v1 绑定，创建新尝试，最多两轮返工。',2,['安排返工','待返工','要求修改'],['changes_requested\nR-01 → attempt 2\n保留旧尝试证据','接收 R-01\n处理纯空白输入\n不扩大需求范围','检查 demo-v1\nR-01：空白输入\n提交 review.json'],'reviewed_commit: demo-v1\nverdict: changes_requested · issue: R-01\nnext_attempt: 2 · max_rework_rounds: 2'],
['复验与交付','版本、测试和复核共同支持完成','修复得到新版本；测试与审查通过后进入 verified。代码生成汇总兜底；合并、推送不会因为审查通过就自动发生。',0,['已验收','修复完成','复核通过'],['AC-01 / AC-02 满足\nR-01 已关闭\n生成 final.md','commit: demo-v2\n修复空白输入\n保留两个版本','复核 demo-v2\nR-01：已关闭\nverdict: pass'],'task_id: T-01 · state: verified\ncommit: demo-v2 · review: pass\ndelivery: final.md · merge: not_requested']
]},
chess:{name:'chess-turn-demo',roles:['controller / referee','white / agent A','black / agent B'],steps:[
['建立棋局','棋盘由代码持有','规则引擎保存完整棋谱、局面与轮次。Agent 选择走法，不能自己宣布合法性。下棋属于后续扩展。',0,['准备','等待','等待'],['建立初始局面\nround: 1 / ply: 0\n生成白方任务','收到 FEN + 棋谱\n只提交 SAN 走法','等待白方有效落子\n不能提前推进'],'game_id: chess-demo · ply: 0\nturn: white · authoritative_state: referee'],
['白方提交','走法先进入待裁定状态','白方返回 e4。校验任务轮次和格式，再交给规则引擎；一个落子消息不能被重复应用。',1,['裁定','已提交','等待'],['收到 move M-01\nexpected_ply: 0\n进行合法性检查','› 我选择 e4\n提交 SAN: e4\n等待裁判记录','等待权威新局面\n不读选手猜测的 FEN'],'move_id: M-01 · expected_ply: 0\nby: white · san: e4 · state: submitted'],
['裁判更新','合法才推进，非法则原地重试','确认合法并持久化后才生成黑方任务。非法走法记录拒绝，不改变棋盘、不增加 ply。',0,['已验证','等待','待领取'],['parse SAN → legal\n记录 M-01\n更新棋谱与 FEN','收到 legal 回执\n保持等待','领取 ply 1 任务\n读取裁判生成的局面'],'move_id: M-01 · verdict: legal\nply: 1 · next: black\nhistory: 1. e4'],
['黑方应手','状态可恢复，选手不必永远在线','黑方提交 c5 并通过裁定。选手崩溃可新建会话读取局面与棋谱；策略记忆是否恢复必须明确说明。',2,['裁定','等待','已提交'],['校验 M-02\nc5: legal\n准备下一回合','等待黑方裁定\n收到完整棋谱','› 我选择 c5\n提交 SAN: c5\nmove_id: M-02'],'move_id: M-02 · verdict: legal\nply: 2 · turn: white\nhistory: 1. e4 c5'],
['回放与停止','到预定回合结束，不把停下当成胜负','演示只展示第一回合。真实实验按目标回合数或规则终局停止；输出棋谱与裁定，不虚构棋力评估。',0,['记录完成','空闲','空闲'],['演示回合结束\n保留走法与裁定\n等待下一步调度','e4 已记录\n不自动开始新回合','c5 已记录\n不自动开始新回合'],'demo: one_round · moves: [e4, c5]\noutcome: unfinished_game\nartifacts: moves.json + verdicts.json']
]},
research:{name:'parallel-research-demo',roles:['coordinator','researcher A','researcher B'],steps:[
['拆分范围','把能独立推进的范围分开','明确各路要查什么和停止条件。把模糊问题复制给多个 Agent，不自动构成合理并行。',0,['拆分','等待','等待'],['A：官方机制\nB：故障证据\n共享结果 schema','范围：官方文档\n须带来源与日期','范围：故障记录\n区分个案与规律'],'tasks: [R-A, R-B] · dependency: independent\noutput_schema: claims + sources + uncertainties'],
['并行执行','多个窗格同时推进','各路领取任务，在独立产物目录工作。用户可进入任意窗格，人工介入前先暂停自动派发。',1,['监测','检索中','检索中'],['R-A: accepted\nR-B: accepted\n两路并行','查阅官方文档\n提取可证实能力\n标记版本边界','核对 issue / changelog\n寻找失败证据\n不把个案泛化'],'R-A: accepted · R-B: accepted\nartifact_dirs: researcher-a / researcher-b'],
['独立提交','一边结束，不覆盖另一边','A 已提交，B 尚在工作。A 的成果独立保存；B 失败仍可交付部分结果并说明缺口。',2,['部分完成','已提交','工作中'],['R-A: submitted\n保存来源与结论\n等待 R-B 或截止时间','提交 claims-A.json\n含版本与来源\n未验证项单列','仍在核对冲突\n已写中间证据\n接近截止时间'],'R-A: submitted · R-B: accepted\npartial_delivery_available: true'],
['核验冲突','两路一致也不自动等于正确','回到来源确认冲突和重叠。必要时启用综合 Agent，但不让它替代缺失的原始证据。',0,['核验','已提交','已提交'],['两路描述存在差异\n回查对应版本\n保留未决项','版本 A 的机制\n原文可以定位','版本 B 的修复\n指出版本差异'],'inputs: [claims-A.json, claims-B.json]\nverification: source_check\nconflicts: resolved_or_explicitly_open'],
['汇总交付','产出包括结论，也包括边界','机械层列出来源、失败与产物。需要交叉判断时才启用模型综合；与单 Agent 基线比较才能知道值不值。',0,['交付','空闲','空闲'],['生成 final.md\n记录耗时与费用范围\n保留两路原始结果','成果与来源归档\n不自动清理证据','成果与来源归档\n不自动清理证据'],'delivery: final.md\nprovenance: researcher-a + researcher-b\nquality_gain: requires_baseline_comparison']
]}};
let scenario='code',stepIndex=0;
function render(){const f=flows[scenario],s=f.steps[stepIndex];document.getElementById('bench-title').textContent='ma3 / '+f.name+' / '+(stepIndex+1)+' of '+f.steps.length;const list=document.getElementById('steps');list.replaceChildren();f.steps.forEach((step,i)=>{const b=document.createElement('button');b.className='step';b.setAttribute('aria-current',i===stepIndex?'step':'false');const n=document.createElement('span');n.textContent=String(i+1).padStart(2,'0');b.append(n,document.createTextNode(step[0]));b.addEventListener('click',()=>{stepIndex=i;render();document.querySelectorAll('.step')[i].focus({preventScroll:true})});list.append(b)});const panes=document.getElementById('panes');panes.replaceChildren();f.roles.forEach((r,i)=>{const el=document.createElement('div');el.className='pane'+(i===s[3]?' active':'');const top=document.createElement('div');top.className='pane-top';const name=document.createElement('span');name.className='pane-name';name.textContent=r;const badge=document.createElement('span');badge.className='badge';badge.textContent=s[4][i];top.append(name,badge);const body=document.createElement('pre');body.textContent=s[5][i];el.append(top,body);panes.append(el)});document.getElementById('receipt').textContent=s[6];document.getElementById('step-title').textContent=s[1];document.getElementById('step-desc').textContent=s[2];document.getElementById('next').textContent=stepIndex===f.steps.length-1?'回到第一步 ↺':'下一步 →'}
document.querySelectorAll('[data-scenario]').forEach(b=>b.addEventListener('click',()=>{scenario=b.dataset.scenario;stepIndex=0;document.querySelectorAll('[data-scenario]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));render()}));document.getElementById('next').addEventListener('click',()=>{stepIndex=(stepIndex+1)%flows[scenario].steps.length;render()});document.getElementById('reset').addEventListener('click',()=>{stepIndex=0;render()});
document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));let n=0;document.querySelectorAll('.project').forEach(p=>{p.hidden=b.dataset.filter!=='all'&&p.dataset.category!==b.dataset.filter;if(!p.hidden)n++});document.getElementById('project-count').textContent=n+' PROJECTS / 官方材料核对'}));render();
</script></body></html>
