<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>jarvis-voice-review.md</title><style>/* muQ theme contract v1: semantic roles shared by catalogue, reader, reports. */
