<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AI 生图 · 风格、Skill 与实践</title><style>/* muQ theme contract v1: semantic roles shared by catalogue, reader, reports. */
:root{--paper:#f5f1eb;--white:#fffdf9;--ink:#302936;--muted:#716772;--plum:#665173;--night:#292332;--gold:#dfcba2;--line:#dfd7dc;--muq-reading-width:78ch;--muq-radius:8px;--muq-space:24px;--muq-body-font:"Noto Sans CJK SC","Microsoft YaHei",system-ui,sans-serif;--muq-heading-font:"Noto Serif CJK SC","Songti SC",serif}

.topic-page{max-width:1040px;margin:auto}.topic-page .reader-title{font-family:var(--muq-heading-font);font-size:clamp(30px,4vw,48px);margin:0 0 22px}.topic-page .eyebrow{margin:6px 0 16px}.topic-summary{font-size:19px;line-height:1.95;max-width:49em;margin:0 0 32px}.topic-figure{margin:0 0 48px}.topic-figure img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:6px;background:var(--paper)}.topic-figure figcaption{font-size:13px;color:var(--muted);line-height:1.8;margin-top:12px}.topic-section{border-top:1px solid var(--line);padding-top:30px;margin-top:44px;scroll-margin-top:30px}.topic-section h2{font-size:27px;margin:0 0 18px}.topic-section>p,.topic-items p{font-size:16px;line-height:1.95;margin:12px 0;overflow-wrap:anywhere}.topic-section>.reader-meta{font-size:13px}.topic-actions{display:flex;flex-wrap:wrap;gap:10px 14px;margin:22px 0}.topic-actions a{border:1px solid var(--plum);padding:11px 18px;text-decoration:none;border-radius:4px;font-size:15px;background:var(--white)}.topic-actions a:first-child{background:var(--plum);color:var(--white)}.topic-toc{display:flex;flex-wrap:wrap;gap:12px 22px;background:var(--white);border:1px solid var(--line);padding:22px;margin:30px 0}.topic-toc>span{width:100%;font-size:12px;color:var(--muted)}.topic-toc a{font-size:14px;color:var(--plum);text-decoration:underline;text-underline-offset:4px}.topic-items{list-style:none;margin:0;padding:0}.topic-items li{padding:18px 0;border-bottom:1px solid var(--line)}.topic-items strong{font-size:19px;font-weight:600}.topic-items .related-link{display:inline-block;font-size:14px}.topic-rows{border:1px solid var(--line);border-radius:8px;background:var(--white);overflow:hidden}.topic-rows>.related-link,.topic-file{padding:13px 18px;border-bottom:1px solid var(--line);margin:0}.topic-rows>:last-child{border-bottom:0}.topic-rows .related-link{font-size:15px;text-decoration:none;line-height:1.75}.topic-file{display:flex;align-items:center;justify-content:space-between;gap:18px}.topic-file .related-link{padding:0;min-width:0;overflow-wrap:anywhere}.topic-file small{flex:none}.topic-prompt-group{margin:25px 0}.topic-prompt-group>summary{font-size:17px;line-height:1.8;cursor:pointer}.topic-rows a:hover{text-decoration:underline}.topic-page:focus-visible,.topic-page a:focus-visible{outline:3px solid var(--plum);outline-offset:4px}@media(max-width:600px){.topic-summary{font-size:17px;line-height:1.95}.topic-section{margin-top:32px;padding-top:24px}.topic-section h2{font-size:23px}.topic-section>p,.topic-items p{font-size:15px}.topic-figure{margin-bottom:32px}.topic-actions a{font-size:14px;padding:10px 13px}.topic-file{align-items:flex-start;gap:10px}.topic-file small{font-size:10px}.topic-toc{gap:13px 18px;padding:18px}.topic-rows>.related-link,.topic-file{padding:12px 14px}}

/* Reading layout uses the library palette; enabled per topic. */
.topic-reading{--chapter-ink:var(--plum);--chapter-paper:#ece7ee;max-width:1120px}
.topic-reading-layout{display:grid;grid-template-columns:205px minmax(0,1fr);gap:42px;align-items:start;margin-top:40px}
.topic-reading-aside{position:sticky;top:25px;border-top:2px solid var(--chapter-ink);padding-top:16px}
.topic-reading-aside summary{font-size:13px;cursor:pointer;color:var(--muted)}
.topic-reading .topic-toc{display:flex;flex-direction:column;gap:0;border:0;background:none;padding:0;margin:12px 0}
.topic-reading .topic-toc a{font-size:13px;line-height:1.75;padding:10px 0;border-bottom:1px solid var(--line);text-decoration:none}
.topic-reading .topic-toc a[aria-current]{font-weight:700;color:var(--chapter-ink);border-bottom-color:var(--chapter-ink)}
.topic-reading-prose{min-width:0}.topic-reading-prose>.topic-section{padding:0;border:0;margin:0 0 64px;scroll-margin-top:30px}
.topic-chapter-head{display:flex;align-items:center;gap:22px;padding:24px;background:var(--chapter-paper);border-top:3px solid var(--chapter-ink);border-bottom:1px solid var(--line);margin-bottom:28px}
.topic-chapter-number{font:34px/1 Georgia,serif;color:var(--chapter-ink);padding-right:18px;border-right:1px solid var(--line);flex-shrink:0}
.topic-reading .topic-chapter-head h2{font:700 32px/1.5 var(--muq-heading-font);margin:0;color:var(--chapter-ink);overflow-wrap:anywhere;min-width:0}
.topic-reading .topic-rows>.related-link{display:block}.topic-reading .topic-file{position:relative}.topic-reading .topic-file a::after{content:'';position:absolute;inset:0}.topic-reading .topic-rows> :hover{background:var(--chapter-paper)}
.topic-reading #topic-status{border-left:4px solid var(--chapter-ink);border-top:0;background:var(--white);padding:24px 28px}
@media(max-width:900px){.topic-reading-layout{grid-template-columns:170px minmax(0,1fr);gap:25px}.topic-reading .topic-chapter-head h2{font-size:28px}.topic-chapter-head{padding:20px;gap:16px}}
@media(max-width:700px){.topic-reading-layout{display:block}.topic-reading-aside{position:static;margin-bottom:30px}.topic-reading .topic-toc{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.topic-chapter-head{padding:18px 14px;gap:14px}.topic-reading .topic-chapter-head h2{font-size:24px}.topic-chapter-number{font-size:28px;padding-right:12px}.topic-reading-prose>.topic-section{margin-bottom:48px}.topic-reading #topic-status{padding:20px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--muq-body-font)}main{padding:44px 24px}a{color:var(--plum)}.reader-meta{color:var(--muted);font-size:13px}</style><main class="topic-page topic-reading"><p class="eyebrow">muQ / 持续维护的主题</p><h1 class="reader-title">AI 生图 · 风格、Skill 与实践</h1><p class="topic-summary">持续整理 AI 生图的搜索结论、可读写提示词、Agent Skill 与工作流仓库，以及真实素材实践。当前覆盖漫画线稿、厚涂、半厚涂、清新简约与减少常见 AI 视觉套路。</p><section class="topic-section" id="topic-status"><h2>当前状态与操作入口</h2><p>资料研究、个人 Skill 创建与首轮实测已完成。新 imgen-art-director 已生成帕秋莉 fumo 写实、漫画线稿、厚涂三版；用户认可本次结果与 Skill。长期主题继续积累，尚未做严格受控风格对照或官方直连验证。</p><p class="reader-meta">2026-09-12 按新版 muq-journal 重新整理。实测与用户反馈来自2026-09-11；本轮只整理归档，不新增生成或重跑联网研究。</p><nav class="topic-actions"><a class="related-link" target="_blank" rel="noopener" href="https://github.com/dticpw/agentflow/tree/main/skills/imgen-art-director">个人生图 Skill 源码</a></nav></section><div class="topic-reading-layout"><aside class="topic-reading-aside"><details open><summary>本页目录</summary><nav class="topic-toc" aria-label="主题目录"><a href="#topic-direction">从资料研究到个人工具</a><a href="#topic-research">搜索结论与资源选择</a><a href="#topic-samples">帕秋莉 fumo · 三种风格</a><a href="#topic-early-sample">早期样例 · 半厚涂人物立绘</a><a href="#topic-method">Skill 的作用与使用边界</a><a href="#topic-evidence">实测记录与用户反馈</a><a href="#topic-usage">如何继续使用与积累</a><a href="#topic-webpages">网页</a><a href="#topic-files">文件</a><a href="#topic-history">历史与来源</a></nav></details></aside><div class="topic-reading-prose"><section class="topic-section" id="topic-direction"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">01</span><h2>从资料研究到个人工具</h2></header><p>本主题保存 AI 生图调研、提示词、可用 Skill 与实际图像。研究覆盖漫画线稿、厚涂、半厚涂、清新简约，以及具体视觉问题的诊断。</p><p>最终选择自建 imgen-art-director：以当前意图为先，仅按需读取风格参考；不强制默认画风，不把“去 AI 味”变成万能负面词。旧 imgen-studio 保留作参考，已从发现入口移除。</p><ul class="topic-items"></ul></section><section class="topic-section" id="topic-research"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">02</span><h2>搜索结论与资源选择</h2></header><p>研究区分 Agent Skill、提示词库、风格预设、LoRA 与节点工作流；不同类型不能仅凭同名画风互相替代。检索与直接核对共整理14个来源和9项资源，完整证据与风格配方保留在两份历史报告中。</p><p>BFL 官方 Skill 整理 FLUX 提示与模型限制；YouMind 提供带样例的提示检索；ComfyUI 工作流适合节点与模型组合；RunComfy 是依赖账户与云端费用的候选。只审阅的仓库没有被当成本机已验证工具。</p><p>Fooocus 已进入有限 LTS，其 JSON 适合拆解词语，不作为追新模型平台。风格参数必须按体系适配：FLUX、Midjourney、SD 与 GPT Image 的提示语法和支持能力不混用。</p><ul class="topic-items"></ul></section><section class="topic-section" id="topic-samples"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">03</span><h2>帕秋莉 fumo · 三种风格</h2></header><p>三张均为 AI 生成的二创毛绒玩偶形象，非实物照片或官方商品复刻。写实版之后，用户要求漫画线稿与厚涂各一版。两种绘画版独立生成，未输入同一母图，因此局部造型变化不能当作严格风格 A/B 测试。</p><figure class="topic-figure"><img src="data:image/webp;base64," alt="写实摄影风格：窗边柔光、绒毛、刺绣与接触阴影。"><figcaption>写实摄影风格：窗边柔光、绒毛、刺绣与接触阴影。 <a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-original-v1.png">打开原图</a></figcaption></figure><figure class="topic-figure"><img src="data:image/webp;base64," alt="漫画线稿：变化线重、细密排线与布料结构。"><figcaption>漫画线稿：变化线重、细密排线与布料结构。 <a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-ink-original-v1.png">打开原图</a></figcaption></figure><figure class="topic-figure"><img src="data:image/webp;base64," alt="数字厚涂：暖光、紫色块面与沿体积展开的笔触。"><figcaption>数字厚涂：暖光、紫色块面与沿体积展开的笔触。 <a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-painterly-original-v1.png">打开原图</a></figcaption></figure><ul class="topic-items"></ul></section><section class="topic-section" id="topic-early-sample"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">04</span><h2>早期样例 · 半厚涂人物立绘</h2></header><p>这张帕秋莉人物立绘来自旧 imgen-studio 的通道实测，先于个人 Skill 创建。保留它用于追溯工作流，不把它算作新 Skill 的验证结果。紫发、新月帽饰、魔导书与长袍可辨识；原图完整保留。</p><figure class="topic-figure"><img src="data:image/webp;base64," alt="帕秋莉半厚涂人物立绘 · 旧 Skill 的历史样例"><figcaption>帕秋莉半厚涂人物立绘 · 旧 Skill 的历史样例 <a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-original-v1.png">打开原图</a></figcaption></figure><ul class="topic-items"></ul></section><section class="topic-section" id="topic-method"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">05</span><h2>Skill 的作用与使用边界</h2></header><p>它负责理解用途、核对角色锚点、组织提示、选择相关风格方法、检查实图和保留可复用成果。它不为图像模型增加新能力，参考规范也不能凌驾于当前画面需求。</p><p>漫画线稿关注线重、排线和黑白层次；数字厚涂用色块、体积与边缘塑形，不必模拟堆起的油彩；半厚涂关注线条和色块分工；简约风关注信息密度与留白。</p><p>减少 AI 味要针对实际缺陷：塑料高光、过度细节、模板灯光、身份漂移或均匀假纹理。合适的高光与丰富细节仍可保留，不能把个人审美写成通用禁令。</p><ul class="topic-items"></ul></section><section class="topic-section" id="topic-evidence"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">06</span><h2>实测记录与用户反馈</h2></header><p>新 Skill 的三张 fumo 均经过实际看图。写实版绒毛、刺绣与接触阴影清楚；线稿版排线比预设更密，属于漫画成稿；厚涂版色块与笔触明显，暖光和紫色阴影塑造体积。</p><p>写实版约34秒，线稿版约32秒，厚涂版约39秒。经既有授权的第三方 model-library 与内置 CLI 请求 gpt-image-2、high、1024×1024；三张实际输出均为1254×1254 RGB。请求参数不能证明第三方后端身份。</p><p>用户对写实样图反馈“很好”，看完两种绘画版后表示“这个skill不错”。这是本轮结果与使用体验的认可，不代表已确定最喜欢的画风，也不代表多任务稳定性已经验证。</p><p>此前另有帕秋莉半厚涂人物立绘，来自旧 Skill，原图与提示词保留作历史样例。清新简约目前只有研究方法，没有本轮出图证据。</p><ul class="topic-items"></ul></section><section class="topic-section" id="topic-usage"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">07</span><h2>如何继续使用与积累</h2></header><p>直接说明主体、用途与想要的视觉效果即可，例如“用新生图 Skill 画帕秋莉的清新简约立绘”。有参考图时注明它用于身份、风格、构图还是需要修改的原图。</p><p>要准确比较风格，后续应指定同一母图与保留项；本轮独立生成会带来蝴蝶结、服装和构图变化。当前没有必要为归档额外生图。</p><p>有效源码在共享 agentflow 仓库的 skills/imgen-art-director；馆内 ZIP 是2026-09-11历史快照。用户认可本轮体验，但未指定最偏爱的画风；清新简约仍待按实际任务验证。</p><ul class="topic-items"></ul></section><section class="topic-section" id="topic-webpages"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">08</span><h2>网页</h2></header><div class="topic-rows"><a class="related-link" target="_blank" rel="noopener" href="https://github.com/dticpw/agentflow">个人 Skill 源码仓库（私有）</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/black-forest-labs/skills/blob/master/skills/flux-image-best-practices/SKILL.md">官方 FLUX 提示与 API 指南</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/YouMind-OpenLab/ai-image-prompts-skill/blob/main/SKILL.md">跨模型提示词检索</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/MieMieeeee/comfyui-agent-skill">把已注册的 ComfyUI 工作流交给 Agent</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/prime-skills/runcomfy-agent-skills/blob/main/ai-image-generation/SKILL.md">云端多模型路由候选</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/YouMind-OpenLab/awesome-nano-banana-pro-prompts">带预览的 Gemini 提示词图库</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/lllyasviel/Fooocus/blob/main/sdxl_styles/sdxl_styles_sai.json">成熟 SDXL 项目的可读风格词表</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/Dalabad/stable-diffusion-prompt-templates">较早期的风格对照词表</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/Comfy-Org/workflow_templates">ComfyUI 官方模板</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/Comfy-Org/example_workflows">官方教程配套工作流</a></div></section><section class="topic-section" id="topic-files"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">09</span><h2>文件</h2></header><div class="topic-rows"><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fai-image-studio-archive-20260911-v1.html">上一版生图主题归档（历史）</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fai-image-styles-20260911.html">AI 生图专题 · 搜索结论与风格配方</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fimage-generation-research.html">此前 GPT/OpenAI 生图研究</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fresearch.json">可维护研究数据</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fresearch.md">研究文字版</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-original-v1.png">帕秋莉 · 半厚涂原图</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-prompt-v1.txt">帕秋莉 · 最终提示词</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fimgen-art-director-20260911.zip">个人生图 Skill 源码快照</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-original-v1.png">帕秋莉 fumo 原图</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-prompt-v1.txt">帕秋莉 fumo 提示词</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-ink-original-v1.png">帕秋莉 fumo · 漫画线稿原图</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-ink-prompt-v1.txt">帕秋莉 fumo · 漫画线稿提示词</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-painterly-original-v1.png">帕秋莉 fumo · 厚涂原图</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=ai-image-studio&amp;file=artifacts%2Fpatchouli-fumo-painterly-prompt-v1.txt">帕秋莉 fumo · 厚涂提示词</a></div></section><section class="topic-section" id="topic-history"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">10</span><h2>历史与来源</h2></header><div class="topic-rows"><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=codex-4d581ad1e98ee8f22621fa93">daily · 日常维护与 AI 日报工作流</a></div><p>来源原话在图书馆馆主视角默认展开；本 HTML 阅读副本不复制原始提示词。</p></section></div></div></main><script>const links=[...document.querySelectorAll('.topic-toc a')],sections=links.map(a=>document.querySelector(a.getAttribute('href')));function update(){let n=0;sections.forEach((s,i)=>{if(s.getBoundingClientRect().top<innerHeight*.35)n=i});if(innerHeight+scrollY>=document.documentElement.scrollHeight-4)n=sections.length-1;links.forEach((a,i)=>i===n?a.setAttribute('aria-current','location'):a.removeAttribute('aria-current'))}addEventListener('scroll',update,{passive:true});addEventListener('resize',update);update();</script></html>