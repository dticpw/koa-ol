<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" href="data:,"><title>AI 生图 · 风格、Skill 与提示词专题</title><style>/* muQ theme contract v1: semantic roles shared by catalogue, reader, reports. */
:root{--paper:#f5f1eb;--white:#fffdf9;--ink:#302936;--muted:#716772;--plum:#665173;--night:#292332;--gold:#dfcba2;--line:#dfd7dc;--muq-reading-width:78ch;--muq-radius:8px;--muq-space:24px;--muq-body-font:"Noto Sans CJK SC","Microsoft YaHei",system-ui,sans-serif;--muq-heading-font:"Noto Serif CJK SC","Songti SC",serif}

*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:85px}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.9 var(--muq-body-font)}a{color:var(--plum);text-underline-offset:4px}button,input,select{font:inherit}button{cursor:pointer}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #aa742c;outline-offset:3px}.wrap{max-width:1160px;margin:auto;padding:0 30px}.nav{position:sticky;top:0;z-index:5;background:#f5f1ebf5;border-bottom:1px solid var(--line)}.nav>.wrap{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-top:14px;padding-bottom:14px}.brand{font:italic 27px Georgia,serif;white-space:nowrap}.navlinks{display:flex;flex-wrap:wrap;gap:10px 20px;font-size:13px}.nav a{text-decoration:none}.hero{padding:65px 0 50px;display:grid;grid-template-columns:1.5fr 1fr;gap:45px;align-items:center}.eyebrow{font-size:11px;letter-spacing:.15em;color:var(--plum)}h1{font:500 clamp(34px,4.5vw,57px)/1.4 var(--muq-heading-font);margin:20px 0}h2{font-size:29px;line-height:1.45;margin:0 0 20px}h3{font-size:21px;line-height:1.5;margin:10px 0}p{margin:0 0 16px}.lead{font-size:18px;color:var(--muted)}.callout{background:#eae3ed;border:1px solid #dbd0df;border-radius:18px;padding:26px}.callout p,.callout li{font-size:14px}.callout ul{padding-left:20px}.section{border-top:1px solid var(--line);padding:43px 0}.muted{color:var(--muted);font-size:14px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.card{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:25px;min-width:0}.card p{font-size:14px}.tag{display:inline-block;padding:3px 10px;border-radius:20px;background:#eae3ed;color:#655073;font-size:11px}.meta{font-size:11px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 16px}.card h3 a{text-decoration:none}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0}button{border:1px solid #c5b4cc;background:transparent;color:var(--plum);border-radius:22px;padding:7px 14px;font-size:13px}button[aria-pressed=true],button.copy{background:var(--plum);color:var(--white)}button:hover{filter:brightness(.92)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px}table{width:100%;border-collapse:collapse;min-width:680px;font-size:14px}th,td{padding:16px 18px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}th{background:#eae3ed;font-size:12px}tr:last-child td{border-bottom:0}.style{padding:30px 0;border-top:1px solid var(--line)}.style-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.style h3{font-size:25px}.style .grid{grid-template-columns:1fr 1.3fr}.style ul{padding-left:21px;font-size:14px}.recipe{background:#fffdf9;border:1px solid var(--line);border-radius:14px;padding:22px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:14px/1.8 var(--muq-body-font);margin:16px 0;background:#f0eaf2;padding:18px;border-radius:10px}.controls{display:flex;gap:20px;flex-wrap:wrap;align-items:end;background:#eae3ed;border-radius:14px;padding:20px;margin-top:22px}.controls label{font-size:12px;display:grid;gap:5px}.controls input,.controls select{max-width:100%;background:var(--white);border:1px solid #c8b8cd;padding:9px;border-radius:5px;color:var(--ink)}.controls label:first-child{flex:1;min-width:200px}.negative{border-left:3px solid #b5a0bd;padding-left:14px;font-size:13px}.pitfall{color:var(--muted);font-size:13px;border-top:1px solid var(--line);padding-top:14px}.anti{display:grid;grid-template-columns:170px 1fr;gap:22px;padding:24px 0;border-top:1px solid var(--line)}.anti strong{font-size:18px}.anti p{margin:0;font-size:15px}.process{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin:25px 0}.process>div{border-top:2px solid #b5a0bd;padding-top:16px}.process b{font-size:17px}.process p{font-size:14px;color:var(--muted);margin-top:9px}.sources{padding-left:22px}.sources li{padding:15px 0;border-bottom:1px solid var(--line);font-size:14px}.sources p{font-size:13px;color:var(--muted);margin:4px 0}.footer{padding:30px 0 50px;font-size:12px;color:var(--muted)}details{margin-top:20px}summary{cursor:pointer;color:var(--plum)}[hidden]{display:none!important}#notice{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#302936;color:white;padding:9px 20px;border-radius:25px;z-index:8;font-size:13px}#notice:empty{display:none}.skip{position:absolute;top:-80px;left:10px}.skip:focus{top:8px;z-index:10;background:white;padding:12px}.no-script{font-size:12px;color:var(--muted)}@media(max-width:750px){.hero,.grid,.style .grid{grid-template-columns:1fr}.hero{padding:35px 0;gap:22px}.wrap{padding:0 20px}.navlinks{gap:5px 13px;font-size:12px}.brand{font-size:23px}.section{padding:30px 0}.process{grid-template-columns:1fr 1fr}.anti{grid-template-columns:1fr;gap:8px}.card{padding:21px}.style-head{flex-wrap:wrap;gap:8px}h2{font-size:25px}.nav>.wrap{align-items:start}.controls{gap:12px}.controls input{width:100%}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}@media print{.nav,.filters,.controls,button,#notice{display:none}.card[hidden]{display:block!important}.wrap{max-width:none}.hero{padding:15px 0}.card,.recipe{break-inside:avoid}.section{padding:25px 0}body{font-size:11pt}h1{font-size:28pt}}</style></head><body><a class="skip" href="#conclusions">跳到正文</a><nav class="nav" aria-label="专题目录"><div class="wrap"><span class="brand">imGen / muQ</span><div class="navlinks"><a href="#conclusions">搜索结论</a><a href="#resources">Skill 与仓库</a><a href="#styles">四类风格</a><a href="#anti">减少 AI 味</a><a href="#practice">实践记录</a><a href="#sources">来源</a></div></div></nav><main class="wrap"><header class="hero"><div><p class="eyebrow">AI IMAGE STUDIO / 2026.09.11</p><h1>找到画风，<br>也找到可重复的方法。</h1><p class="lead">AI 生图专题：从 GPT 扩展到 FLUX、Midjourney、Gemini 与 SDXL / ComfyUI，收录搜索结论、Skill、风格提示词和实践记录。</p></div><aside class="callout"><h3>这一版收录什么？</h3><ul><li>9 项分类资源，附仓库、维护与使用边界。</li><li>漫画线稿、厚涂、半厚涂、清新简约 4 组配方。</li><li>把“去 AI 味”拆成可检查的视觉选择。</li><li>14 处直接核对的来源与已知限制。</li></ul><p class="muted">本次完成文档与仓库调研，未安装第三方 Skill，也未进行新模型出图评测。提示词是试验起点。</p></aside></header>
<section class="section" id="conclusions"><p class="eyebrow">01 / 搜索结论</p><h2>先分清你需要的是哪一层。</h2><div class="table-wrap"><table><thead><tr><th>类型</th><th>解决什么</th><th>本次优先入口</th></tr></thead><tbody><tr><td>Agent Skill</td><td>指导 Agent 查提示词、组织调用或执行已有流程；本身不是模型，也不保证画风。</td><td>BFL 官方、YouMind 检索；需要执行时再评估 ComfyUI / RunComfy。</td></tr><tr><td>提示词库 / 风格预设</td><td>提供语言、构图和配色参考；要拆解媒介、线条、明暗与背景，而非整段堆砌。</td><td>YouMind 图库、Fooocus 风格 JSON。</td></tr><tr><td>LoRA / 风格参考</td><td>提供额外视觉约束。LoRA 是模型适配权重，必须匹配底模；风格参考图不等于人物身份锁定。</td><td>Midjourney Style Reference；SDXL/其他底模按各模型卡和 LoRA 说明选择。</td></tr><tr><td>节点工作流</td><td>组织加载、采样、图像条件、编辑与导出。结构控制比只改 prompt 更适合固定线稿与姿势。</td><td>ComfyUI 官方模板与示例。</td></tr></tbody></table></div><div class="callout" style="margin-top:24px"><b>针对你目前的用法</b><p>先用提示词库与风格参考探索审美，再维护自己的母版与风格配方。需要批量、固定构图或线稿控制时才加入 ComfyUI。第三方执行 Skill 先审阅再安装，本次只收录链接。</p><p class="muted">“比较出名”用官方身份与 GitHub 关注规模辅助判断，不当作效果排名。检索中的一个 Midjourney 图库仅 1 星，未列入主推荐；官方 BFL Skill 规模较小但来源明确。</p></div></section>
<section class="section" id="resources"><p class="eyebrow">02 / Skill 与仓库链接</p><h2>先看用途，再看安装入口。</h2><p class="muted">关注数与最近推送来自 2026-09-11 的 GitHub API 快照。推送时间不等于核心代码更新，仓库许可也不自动覆盖模型、示例图和第三方服务。</p><div class="filters" role="group" aria-label="资源类型筛选"><button data-filter="全部" aria-pressed="true">全部</button><button data-filter="Skill" aria-pressed="false">Agent Skill</button><button data-filter="提示词库" aria-pressed="false">提示词库</button><button data-filter="风格预设" aria-pressed="false">风格预设</button><button data-filter="工作流" aria-pressed="false">工作流</button></div><p id="count" class="muted" role="status">9 项资源</p><div class="grid"><article class="card resource" data-kind="Skill"><span class="tag">Skill</span><h3><a href="https://github.com/black-forest-labs/skills/blob/master/skills/flux-image-best-practices/SKILL.md" target="_blank" rel="noopener">官方 FLUX 提示与 API 指南 ↗</a></h3><p>优先阅读 flux-image-best-practices；它整理的是提示结构和模型限制，不是某种画风滤镜。</p><p class="pitfall">适合 FLUX。实际生成需要对应 API 或另配本地流程；仓库 MIT 不等于所有模型权重都可免费商用。</p><div class="meta"><span>★ 115 · 核对日快照</span><span>最近推送 2026-09-09</span><span>许可 MIT</span></div><p class="muted"><a href="https://github.com/black-forest-labs/skills" target="_blank" rel="noopener">black-forest-labs/skills</a></p></article><article class="card resource" data-kind="Skill"><span class="tag">Skill</span><h3><a href="https://github.com/YouMind-OpenLab/ai-image-prompts-skill/blob/main/SKILL.md" target="_blank" rel="noopener">跨模型提示词检索 ↗</a></h3><p>按用途检索分类数据，返回带样例的提示词。适合找构图、商业插画与漫画分镜灵感。</p><p class="pitfall">仓库宣称适配多模型，并不等于相同提示词能复现相同风格；它主要检索与改写，不自带生成模型。</p><div class="meta"><span>★ 1,019 · 核对日快照</span><span>最近推送 2026-09-11</span><span>许可 MIT</span></div><p class="muted"><a href="https://github.com/YouMind-OpenLab/ai-image-prompts-skill" target="_blank" rel="noopener">YouMind-OpenLab/ai-image-prompts-skill</a></p></article><article class="card resource" data-kind="Skill"><span class="tag">Skill</span><h3><a href="https://github.com/MieMieeeee/comfyui-agent-skill" target="_blank" rel="noopener">把已注册的 ComfyUI 工作流交给 Agent ↗</a></h3><p>本地执行型 Skill：通过 CLI 调用注册工作流，输出结构化结果。</p><p class="pitfall">要求已有本地或可信自托管 ComfyUI 与模型；不提供后端，不是单纯写提示词的工具。</p><div class="meta"><span>★ 113 · 核对日快照</span><span>最近推送 2026-08-02</span><span>许可 Apache-2.0</span></div><p class="muted"><a href="https://github.com/MieMieeeee/comfyui-agent-skill" target="_blank" rel="noopener">MieMieeeee/comfyui-agent-skill</a></p></article><article class="card resource" data-kind="Skill"><span class="tag">Skill</span><h3><a href="https://github.com/prime-skills/runcomfy-agent-skills/blob/main/ai-image-generation/SKILL.md" target="_blank" rel="noopener">云端多模型路由候选 ↗</a></h3><p>提供 ai-image-generation 等 Skill，由 RunComfy CLI 调用服务。原链接已跳转到 prime-skills。</p><p class="pitfall">生成依赖 RunComfy 账户与云端费用；只审阅文档，未审计全部代码，也未实测效果。</p><div class="meta"><span>★ 43 · 核对日快照</span><span>最近推送 2026-05-15</span><span>许可 MIT</span></div><p class="muted"><a href="https://github.com/prime-skills/runcomfy-agent-skills" target="_blank" rel="noopener">prime-skills/runcomfy-agent-skills</a></p></article><article class="card resource" data-kind="提示词库"><span class="tag">提示词库</span><h3><a href="https://github.com/YouMind-OpenLab/awesome-nano-banana-pro-prompts" target="_blank" rel="noopener">带预览的 Gemini 提示词图库 ↗</a></h3><p>适合先看画面，再拆解主体、镜头、风格、留白与约束。图库规模是作者自述，页面样例不是本次复现。</p><p class="pitfall">以 Gemini 图像生态为主；图片来源与授权逐项看，GitHub API 未给出明确 SPDX 许可证标识。</p><div class="meta"><span>★ 13,406 · 核对日快照</span><span>最近推送 2026-09-11</span><span>许可 NOASSERTION</span></div><p class="muted"><a href="https://github.com/YouMind-OpenLab/awesome-nano-banana-pro-prompts" target="_blank" rel="noopener">YouMind-OpenLab/awesome-nano-banana-pro-prompts</a></p></article><article class="card resource" data-kind="风格预设"><span class="tag">风格预设</span><h3><a href="https://github.com/lllyasviel/Fooocus/blob/main/sdxl_styles/sdxl_styles_sai.json" target="_blank" rel="noopener">成熟 SDXL 项目的可读风格词表 ↗</a></h3><p>重点参考 sdxl_styles 下的 JSON：可直接看到某种风格如何拼接正、负面提示。</p><p class="pitfall">项目已进入仅修 bug 的有限 LTS，不是追新模型首选。预设词有冲突和过度修饰，需拆开用。</p><div class="meta"><span>★ 52,984 · 核对日快照</span><span>最近推送 2025-12-01</span><span>许可 GPL-3.0</span></div><p class="muted"><a href="https://github.com/lllyasviel/Fooocus" target="_blank" rel="noopener">lllyasviel/Fooocus</a></p></article><article class="card resource" data-kind="提示词库"><span class="tag">提示词库</span><h3><a href="https://github.com/Dalabad/stable-diffusion-prompt-templates" target="_blank" rel="noopener">较早期的风格对照词表 ↗</a></h3><p>可用来学习 comic、line art、digital painting 等术语的组织方式。</p><p class="pitfall">最后推送较早；含 artist 名和 8k 等旧式词，不推荐整段照搬到现代模型。</p><div class="meta"><span>★ 697 · 核对日快照</span><span>最近推送 2024-08-21</span><span>许可 MIT</span></div><p class="muted"><a href="https://github.com/Dalabad/stable-diffusion-prompt-templates" target="_blank" rel="noopener">Dalabad/stable-diffusion-prompt-templates</a></p></article><article class="card resource" data-kind="工作流"><span class="tag">工作流</span><h3><a href="https://github.com/Comfy-Org/workflow_templates" target="_blank" rel="noopener">ComfyUI 官方模板 ↗</a></h3><p>需要可重复流程、图像编辑、模型加载时，优先从官方模板开始。</p><p class="pitfall">不同模板所需节点、权重和显存不同；部分模板使用云 API，并非全部纯本地。仓库中的维护 Skill 不等于生图 Skill。</p><div class="meta"><span>★ 892 · 核对日快照</span><span>最近推送 2026-09-11</span><span>许可 MIT</span></div><p class="muted"><a href="https://github.com/Comfy-Org/workflow_templates" target="_blank" rel="noopener">Comfy-Org/workflow_templates</a></p></article><article class="card resource" data-kind="工作流"><span class="tag">工作流</span><h3><a href="https://github.com/Comfy-Org/example_workflows" target="_blank" rel="noopener">官方教程配套工作流 ↗</a></h3><p>适合从教程进入具体示例，核对输入图、节点与依赖。</p><p class="pitfall">不是提示词大全，不应假定任意 JSON 都可直接在当前机器执行。</p><div class="meta"><span>★ 25 · 核对日快照</span><span>最近推送 2026-08-21</span><span>许可 未声明</span></div><p class="muted"><a href="https://github.com/Comfy-Org/example_workflows" target="_blank" rel="noopener">Comfy-Org/example_workflows</a></p></article></div></section>
<section class="section" id="styles"><p class="eyebrow">03 / 风格提示词</p><h2>用可见特征描述风格。</h2><p>四组范例均不依赖画师姓名。它们不是从某一图库照搬的“神词”，而是结合已核对指南整理的可修改配方。先固定主体，比较不同媒介和边缘处理。</p><div class="controls"><label>可选：替换主体与动作<input id="subject" placeholder="例如：一位红发馆员抱着书站在窗边" aria-label="主体与动作"></label><label>提示词用途<select id="engine"><option value="natural">FLUX / Gemini：自然语言</option><option value="mj">Midjourney：风格控制起点</option><option value="sd">SDXL：正负面分别使用</option></select></label><button id="apply">更新四组配方</button></div><noscript><p class="no-script">当前为静态阅读：四组完整范例仍可阅读和手动复制；交互版可使用筛选与改写。</p></noscript><article class="style" id="style-0"><div class="style-head"><div><span class="tag">墨线 / 结构 / 黑白</span><h3>01 · 漫画线稿</h3></div><button class="copy" data-copy="prompt-0">复制正向提示词</button></div><div class="grid"><div><p>靠线宽、轮廓与黑白面积塑造形体。先决定是清爽线稿，还是有排线和网点的漫画成稿；它们不是同一种密度。</p><ul><li>有轻重的墨线，外轮廓较强、内部结构线克制</li><li>脸与手线条完整，局部排线表达体积</li><li>背景留白，大块纯黑只放在构图需要的位置</li></ul><p class="pitfall">不要直接复制 Fooocus 的 sai-line art：它的负面词包含 anime，会与“漫画角色”目标打架。line art 与 anime 不是天然互斥。</p><p class="muted">依据：S6；下方范例为本次编写，未出图验证。</p></div><div class="recipe"><p class="muted">自然语言范例 · 可按顶部选项改写</p><pre id="prompt-0">A red-haired librarian holding a closed book, three-quarter view, waist-up. Black-and-white manga ink drawing on clean white paper. Confident tapered contour lines with varied line weight, precise facial features and hands, sparse cross-hatching only in the deepest shadows, a few deliberate solid-black shapes. Clear readable silhouette, restrained interior detail, spacious uncluttered background.</pre><div class="negative"><b>仅供支持负面词的 SDXL 工作流尝试</b><p>photograph, 3d render, full color, soft airbrush shading, dense background, text, watermark</p></div></div></div></article><article class="style" id="style-1"><div class="style-head"><div><span class="tag">体块 / 笔触 / 边缘</span><h3>02 · 厚涂</h3></div><button class="copy" data-copy="prompt-1">复制正向提示词</button></div><div class="grid"><div><p>中文“厚涂”常指以色块塑造体积的数字绘画，不一定要模拟凸起的油彩。只有明确想要堆积颜料时，再加 impasto / palette-knife。</p><ul><li>用大色块而非黑色轮廓线塑造体积</li><li>硬边集中在焦点，软边与消失边用于转折</li><li>笔触方向跟随形体，避免整张均匀铺纹理</li></ul><p class="pitfall">painterly 是绘画性；impasto 才偏厚重颜料肌理。随意加入 oil painting、photo、cel shading 容易互相拉扯。</p><p class="muted">依据：S6 / S7 / S10；下方范例为本次编写，未出图验证。</p></div><div class="recipe"><p class="muted">自然语言范例 · 可按顶部选项改写</p><pre id="prompt-1">A red-haired librarian holding a closed book, three-quarter view, waist-up. Painterly digital illustration built from broad opaque color masses. Visible purposeful brush strokes following the form, sculpted light and shadow, a restrained plum, warm ivory and muted vermilion palette. Sharp accents around the eyes and book, softer and lost edges in the hair and clothing. Matte surfaces, simplified background, one broad side light.</pre><div class="negative"><b>仅供支持负面词的 SDXL 工作流尝试</b><p>3d render, glossy plastic, airbrushed skin, uniform sharp outlines, excessive microdetail, text, watermark</p></div></div></div></article><article class="style" id="style-2"><div class="style-head"><div><span class="tag">保留线感 / 局部塑形</span><h3>03 · 半厚涂</h3></div><button class="copy" data-copy="prompt-2">复制正向提示词</button></div><div class="grid"><div><p>半厚涂没有统一的模型参数。更稳妥的说法是：保留哪些线条、哪些区域用绘画性塑形，以及阴影分几层。</p><ul><li>面部和轮廓有干净线条，内部线减弱</li><li>两到三层主要明暗，再以少量柔和过渡连接</li><li>头发与衣料有局部笔触，皮肤不过度磨皮</li></ul><p class="pitfall">单写 semi-realistic 会把脸推向写实，未必得到半厚涂；要描述“线稿与色块如何分工”。</p><p class="muted">依据：S6 / S10 / S11；下方范例为本次编写，未出图验证。</p></div><div class="recipe"><p class="muted">自然语言范例 · 可按顶部选项改写</p><pre id="prompt-2">A red-haired librarian holding a closed book, three-quarter view, waist-up. Semi-painterly anime illustration. Retain delicate clean linework around the eyes, face and silhouette, with understated interior lines. Model the hair and fabric using two or three broad value groups and subtle painterly transitions. Soft matte skin, selective brush texture, crisp focal details and restrained highlights. Muted plum and warm ivory colors, plain warm paper background.</pre><div class="negative"><b>仅供支持负面词的 SDXL 工作流尝试</b><p>photograph, 3d render, heavy impasto, oily highlights, excessive airbrush, uniform hard outlines, text, watermark</p></div></div></div></article><article class="style" id="style-3"><div class="style-head"><div><span class="tag">少色 / 留白 / 清晰形状</span><h3>04 · 清新简约</h3></div><button class="copy" data-copy="prompt-3">复制正向提示词</button></div><div class="grid"><div><p>清新不等于曝光拉满，简约也不是删掉所有层次。限制调色板、形状数量和视觉重心，通常比“minimalist masterpiece”更可控。</p><ul><li>三到四色：鼠尾草绿、奶油色、浅珊瑚等</li><li>扁平或轻水粉色块，少量纸感</li><li>主次形状清楚，保留大面积呼吸空间</li></ul><p class="pitfall">flat、gouache、paper cut 可以择一主导；把 3D、油画厚肌理和扁平矢量同时堆上去，容易丢失清爽感。</p><p class="muted">依据：S10 / S11；下方范例为本次编写，未出图验证。</p></div><div class="recipe"><p class="muted">自然语言范例 · 可按顶部选项改写</p><pre id="prompt-3">A small reading corner with a librarian and one potted plant. Fresh minimalist editorial illustration. Simple rounded shapes, a limited palette of sage green, warm cream and soft coral, flat matte gouache-like color blocks with very subtle paper texture. Gentle daylight expressed with one simple shadow shape, abundant negative space, a slightly off-center balanced composition, calm everyday mood.</pre><div class="negative"><b>仅供支持负面词的 SDXL 工作流尝试</b><p>3d render, neon colors, dramatic rim light, glossy reflections, clutter, dense texture, text, watermark</p></div></div></div></article><div class="callout"><h3>参数不要跨体系搬运。</h3><p><b>FLUX.2：</b>官方明确不支持负面提示词。用“matte surface / clear silhouette”描述目标，而非追加 SD 的负面串。[S10]</p><p><b>Gemini：</b>说明用途、参考图关系和具体改动；官方建议正向描述目标场景。不要把 SD 的权重括号当作通用语法。[S11]</p><p><b>Midjourney：</b>可先用 Raw 与较低 Stylize 做对照，再用 --sref 加风格参考；Style Reference 主要传递媒介、色彩、纹理与光照，不复制角色身份。适用版本以官方页为准。[S12–S14]</p><p><b>SDXL / Illustrious 等衍生模型：</b>标签、负面词、LoRA 和权重取决于具体模型卡与工作流。共享架构不代表推荐词、触发词、采样设置完全相同；不能混用其他架构的 LoRA。</p></div></section>
<section class="section" id="anti"><p class="eyebrow">04 / 减少常见 AI 视觉套路</p><h2>“AI 味”不是一个单独的开关。</h2><p class="muted">这里说的是审美上的默认套路，不是让图片规避检测或伪称人工创作。以下为依据提示指南整理的视觉判断；没有通用负面词能保证解决所有问题。</p>
<div class="anti"><strong>塑料与磨皮</strong><p>把“perfect skin / glossy / ultra smooth”换成符合媒介的表面：哑光色块、局部纸纹、受控高光。别用强噪点掩盖结构错误；笔触应跟随形体。</p></div>
<div class="anti"><strong>哪里都很精细</strong><p>只让脸、手和关键道具成为焦点，背景降低细节密度，边缘有硬、软、消失的区分。删除与目标无关的 8k、masterpiece、hyper-detailed 等堆叠，比较实际变化。</p></div>
<div class="anti"><strong>默认大片灯光</strong><p>不是每张画都需要轮廓光、体积光、金色逆光和散景。指定一个明确光源与有限反差；线稿风格用排线与黑白形状表达光，不强行塞摄影镜头词。</p></div>
<div class="anti"><strong>模板化构图</strong><p>先明确画幅、视线方向、主体占比和留白，再选择一个小幅不对称。不是故意画歪，而是让姿态、裁切和重心服务画面的意思。</p></div>
<div class="anti"><strong>统一脸与漂移</strong><p>角色母版、风格参考、姿势参考分别标明用途。变体回到母版生成；如果线稿或构图必须固定，考虑结构条件工作流。新增瑕疵不能代替身份一致性。</p></div>
<div class="anti"><strong>伪随机手作感</strong><p>刻意保留有限笔触、色块边缘与纸张质感，比随处添加划痕、畸形和颗粒更有方向。想要厚涂就检查体块，想要清爽就控制形状与调色板。</p></div>
<div class="callout"><b>建议的小型 A/B 测试</b><p>固定模型版本、主体、比例与参考图；支持种子时固定种子，但不把它当跨模型一致性保证。A 用当前提示，B 只改一个风格因素。比较线条、体块、材质、构图和身份；记录参数与失败样例。选定方向后再提高质量，不用单张“抽中”证明方法有效。</p></div></section>
<section class="section" id="practice"><p class="eyebrow">05 / 实践记录与后续</p><h2>把结论变成可积累的素材。</h2><div class="process"><div><b>01 · 历史研究</b><p>09-10 GPT/OpenAI 生图调研已完成修订；相关 HTML 同条目保存，作为此前的基础资料。</p></div><div><b>02 · 馆员抠图</b><p>09-11 发现发丝封闭缝隙残留浅底。已清理 18 处并补修细缝，验证了深浅底检查的必要性。</p></div><div><b>03 · 本轮扩展</b><p>跨体系仓库与官方指南核对完成；形成四类风格配方。没有新增生成图片，不能称为风格实测图库。</p></div><div><b>04 · 待实测</b><p>下一轮可以用同一主体做四种画风小样，再比较原始提示、风格参考和局部编辑，记录真实效果与成本。</p></div></div><p class="muted">专题长期按“搜索结论 / Skill 与仓库 / 风格提示词 / 实践记录”追加；原始文件保留，新版本另存。普通专题目前按馆主可见入库。</p></section>
<section class="section" id="sources"><p class="eyebrow">06 / 来源与证据边界</p><h2>能回到原文，才方便继续研究。</h2><p class="muted">以下关键页面或仓库正文已直接读取。Midjourney 文档的普通 HTTP 抓取返回 403，改用现有浏览器成功核对。未运行仓库代码，未验证服务账户权限或出图质量。</p><ol class="sources"><li id="S1"><a href="https://github.com/black-forest-labs/skills" target="_blank" rel="noopener">[S1] BFL 官方 Agent Skills ↗</a><p>GitHub API、README 与图像 Skill 正文已核对；使用 master 分支。</p></li><li id="S2"><a href="https://github.com/YouMind-OpenLab/ai-image-prompts-skill" target="_blank" rel="noopener">[S2] YouMind 提示词检索 Skill ↗</a><p>已确认根目录 SKILL.md 与分类检索工作方式；跨模型效果为作者主张，未复现。</p></li><li id="S3"><a href="https://github.com/MieMieeeee/comfyui-agent-skill" target="_blank" rel="noopener">[S3] ComfyUI Agent Skill ↗</a><p>已读 SKILL.md，明确需要已有服务，仅执行注册工作流。</p></li><li id="S4"><a href="https://github.com/prime-skills/runcomfy-agent-skills" target="_blank" rel="noopener">[S4] RunComfy Skills ↗</a><p>GitHub 跳转与 ai-image-generation/SKILL.md 已核对；生成走服务 API。</p></li><li id="S5"><a href="https://github.com/YouMind-OpenLab/awesome-nano-banana-pro-prompts" target="_blank" rel="noopener">[S5] YouMind 图像提示词图库 ↗</a><p>仓库、README、关注数与许可元数据已核对。</p></li><li id="S6"><a href="https://github.com/lllyasviel/Fooocus/blob/main/sdxl_styles/sdxl_styles_sai.json" target="_blank" rel="noopener">[S6] Fooocus 风格 JSON ↗</a><p>实际读取 line art、comic book、digital art 等正负面模板；README 明确有限 LTS。</p></li><li id="S7"><a href="https://github.com/Dalabad/stable-diffusion-prompt-templates" target="_blank" rel="noopener">[S7] Stable Diffusion Prompt Templates ↗</a><p>读取旧式风格词表，作为术语材料而非即用最佳配方。</p></li><li id="S8"><a href="https://github.com/Comfy-Org/workflow_templates" target="_blank" rel="noopener">[S8] ComfyUI 官方模板 ↗</a><p>GitHub 仓库和目录已核对；模板类型与模型依赖各异。</p></li><li id="S9"><a href="https://github.com/Comfy-Org/example_workflows" target="_blank" rel="noopener">[S9] ComfyUI 示例工作流 ↗</a><p>官方组织仓库，示例 JSON 属工作流而非通用 Skill。</p></li><li id="S10"><a href="https://docs.bfl.ai/guides/prompting_guide_flux2" target="_blank" rel="noopener">[S10] FLUX.2 Prompting Guide ↗</a><p>直接读取官方网页：主体+动作+风格+语境，重要项前置；不支持负面提示词。</p></li><li id="S11"><a href="https://ai.google.dev/gemini-api/docs/image-generation" target="_blank" rel="noopener">[S11] Gemini 图像生成指南 ↗</a><p>直接读取官方网页：具体描述、编辑迭代、正向表达预期场景；不把 SD 参数当通用参数。</p></li><li id="S12"><a href="https://docs.midjourney.com/hc/en-us/articles/32180011136653-Style-Reference" target="_blank" rel="noopener">[S12] Midjourney Style Reference ↗</a><p>浏览器实际读取：匹配颜色、媒介、纹理、灯光，不是复制人物身份；支持 --sref 与 --sw。</p></li><li id="S13"><a href="https://docs.midjourney.com/hc/en-us/articles/32634113811853-Raw-Mode" target="_blank" rel="noopener">[S13] Midjourney Raw ↗</a><p>浏览器实际读取：减少自动美化与默认创作倾向；不是保证无 AI 痕迹。</p></li><li id="S14"><a href="https://docs.midjourney.com/hc/en-us/articles/32196176868109-Stylize" target="_blank" rel="noopener">[S14] Midjourney Stylize ↗</a><p>浏览器实际读取：默认 100，文档给出 0–1000；低值更贴近提示，高值赋予更多艺术自由。</p></li></ol></section><footer class="footer">AI 生图 · muQ 专题 / 核对日期 2026-09-11 · HTML 内嵌样式，无外部字体、图片或脚本依赖。范例是研究起点，非效果保证。</footer></main><div id="notice" role="status" aria-live="polite"></div><script>const styles=[{"name": "漫画线稿", "tag": "墨线 / 结构 / 黑白", "desc": "靠线宽、轮廓与黑白面积塑造形体。先决定是清爽线稿，还是有排线和网点的漫画成稿；它们不是同一种密度。", "features": ["有轻重的墨线，外轮廓较强、内部结构线克制", "脸与手线条完整，局部排线表达体积", "背景留白，大块纯黑只放在构图需要的位置"], "prompt": "A red-haired librarian holding a closed book, three-quarter view, waist-up. Black-and-white manga ink drawing on clean white paper. Confident tapered contour lines with varied line weight, precise facial features and hands, sparse cross-hatching only in the deepest shadows, a few deliberate solid-black shapes. Clear readable silhouette, restrained interior detail, spacious uncluttered background.", "negative": "photograph, 3d render, full color, soft airbrush shading, dense background, text, watermark", "pitfall": "不要直接复制 Fooocus 的 sai-line art：它的负面词包含 anime，会与“漫画角色”目标打架。line art 与 anime 不是天然互斥。", "citation": "S6"}, {"name": "厚涂", "tag": "体块 / 笔触 / 边缘", "desc": "中文“厚涂”常指以色块塑造体积的数字绘画，不一定要模拟凸起的油彩。只有明确想要堆积颜料时，再加 impasto / palette-knife。", "features": ["用大色块而非黑色轮廓线塑造体积", "硬边集中在焦点，软边与消失边用于转折", "笔触方向跟随形体，避免整张均匀铺纹理"], "prompt": "A red-haired librarian holding a closed book, three-quarter view, waist-up. Painterly digital illustration built from broad opaque color masses. Visible purposeful brush strokes following the form, sculpted light and shadow, a restrained plum, warm ivory and muted vermilion palette. Sharp accents around the eyes and book, softer and lost edges in the hair and clothing. Matte surfaces, simplified background, one broad side light.", "negative": "3d render, glossy plastic, airbrushed skin, uniform sharp outlines, excessive microdetail, text, watermark", "pitfall": "painterly 是绘画性；impasto 才偏厚重颜料肌理。随意加入 oil painting、photo、cel shading 容易互相拉扯。", "citation": "S6 / S7 / S10"}, {"name": "半厚涂", "tag": "保留线感 / 局部塑形", "desc": "半厚涂没有统一的模型参数。更稳妥的说法是：保留哪些线条、哪些区域用绘画性塑形，以及阴影分几层。", "features": ["面部和轮廓有干净线条，内部线减弱", "两到三层主要明暗，再以少量柔和过渡连接", "头发与衣料有局部笔触，皮肤不过度磨皮"], "prompt": "A red-haired librarian holding a closed book, three-quarter view, waist-up. Semi-painterly anime illustration. Retain delicate clean linework around the eyes, face and silhouette, with understated interior lines. Model the hair and fabric using two or three broad value groups and subtle painterly transitions. Soft matte skin, selective brush texture, crisp focal details and restrained highlights. Muted plum and warm ivory colors, plain warm paper background.", "negative": "photograph, 3d render, heavy impasto, oily highlights, excessive airbrush, uniform hard outlines, text, watermark", "pitfall": "单写 semi-realistic 会把脸推向写实，未必得到半厚涂；要描述“线稿与色块如何分工”。", "citation": "S6 / S10 / S11"}, {"name": "清新简约", "tag": "少色 / 留白 / 清晰形状", "desc": "清新不等于曝光拉满，简约也不是删掉所有层次。限制调色板、形状数量和视觉重心，通常比“minimalist masterpiece”更可控。", "features": ["三到四色：鼠尾草绿、奶油色、浅珊瑚等", "扁平或轻水粉色块，少量纸感", "主次形状清楚，保留大面积呼吸空间"], "prompt": "A small reading corner with a librarian and one potted plant. Fresh minimalist editorial illustration. Simple rounded shapes, a limited palette of sage green, warm cream and soft coral, flat matte gouache-like color blocks with very subtle paper texture. Gentle daylight expressed with one simple shadow shape, abundant negative space, a slightly off-center balanced composition, calm everyday mood.", "negative": "3d render, neon colors, dramatic rim light, glossy reflections, clutter, dense texture, text, watermark", "pitfall": "flat、gouache、paper cut 可以择一主导；把 3D、油画厚肌理和扁平矢量同时堆上去，容易丢失清爽感。", "citation": "S10 / S11"}];let timer;function say(t){document.querySelector('#notice').textContent=t;clearTimeout(timer);timer=setTimeout(()=>document.querySelector('#notice').textContent='',2800)}document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{let n=0;document.querySelectorAll('.resource').forEach(c=>{c.hidden=b.dataset.filter!=='全部'&&c.dataset.kind!==b.dataset.filter;if(!c.hidden)n++});document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.querySelector('#count').textContent=n+' 项资源'}));document.querySelector('#apply').addEventListener('click',()=>{const subject=document.querySelector('#subject').value.trim(),engine=document.querySelector('#engine').value;styles.forEach((s,i)=>{let t=s.prompt;if(subject)t=subject+'. '+t.slice(t.indexOf('. ')+2);if(engine==='mj')t+=' --raw --stylize 50';document.querySelector('#prompt-'+i).textContent=t});say('已更新；范例仍需在所选模型中实测')});document.querySelectorAll('[data-copy]').forEach(b=>b.addEventListener('click',async()=>{let t=document.getElementById(b.dataset.copy).textContent;try{await navigator.clipboard.writeText(t);say('正向提示词已复制')}catch(e){const a=document.createElement('textarea');a.value=t;document.body.append(a);a.select();const ok=document.execCommand('copy');a.remove();say(ok?'正向提示词已复制':'请选中正文手动复制')}}));</script></body></html>