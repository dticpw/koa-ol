  "styles": [
    {
      "name": "漫画线稿",
      "tag": "墨线 / 结构 / 黑白",
      "desc": "靠线宽、轮廓与黑白面积塑造形体。先决定是清爽线稿，还是有排线和网点的漫画成稿；它们不是同一种密度。",
      "features": [
        "有轻重的墨线，外轮廓较强、内部结构线克制",
        "脸与手线条完整，局部排线表达体积",
        "背景留白，大块纯黑只放在构图需要的位置"
      ],
      "prompt": "A red-haired librarian holding a closed book, three-quarter view, waist-up. Black-and-white manga ink drawing on clean white paper. Confident tapered contour lines with varied line weight, precise facial features and hands, sparse cross-hatching only in the deepest shadows, a few deliberate solid-black shapes. Clear readable silhouette, restrained interior detail, spacious uncluttered background.",
      "negative": "photograph, 3d render, full color, soft airbrush shading, dense background, text, watermark",
      "pitfall": "不要直接复制 Fooocus 的 sai-line art：它的负面词包含 anime，会与“漫画角色”目标打架。line art 与 anime 不是天然互斥。",
      "citation": "S6"
    },
    {
      "name": "厚涂",
      "tag": "体块 / 笔触 / 边缘",
      "desc": "中文“厚涂”常指以色块塑造体积的数字绘画，不一定要模拟凸起的油彩。只有明确想要堆积颜料时，再加 impasto / palette-knife。",
      "features": [
        "用大色块而非黑色轮廓线塑造体积",
        "硬边集中在焦点，软边与消失边用于转折",
        "笔触方向跟随形体，避免整张均匀铺纹理"
      ],
      "prompt": "A red-haired librarian holding a closed book, three-quarter view, waist-up. Painterly digital illustration built from broad opaque color masses. Visible purposeful brush strokes following the form, sculpted light and shadow, a restrained plum, warm ivory and muted vermilion palette. Sharp accents around the eyes and book, softer and lost edges in the hair and clothing. Matte surfaces, simplified background, one broad side light.",
      "negative": "3d render, glossy plastic, airbrushed skin, uniform sharp outlines, excessive microdetail, text, watermark",
      "pitfall": "painterly 是绘画性；impasto 才偏厚重颜料肌理。随意加入 oil painting、photo、cel shading 容易互相拉扯。",
      "citation": "S6 / S7 / S10"
    },
    {
      "name": "半厚涂",
      "tag": "保留线感 / 局部塑形",
      "desc": "半厚涂没有统一的模型参数。更稳妥的说法是：保留哪些线条、哪些区域用绘画性塑形，以及阴影分几层。",
      "features": [
        "面部和轮廓有干净线条，内部线减弱",
        "两到三层主要明暗，再以少量柔和过渡连接",
        "头发与衣料有局部笔触，皮肤不过度磨皮"
      ],
      "prompt": "A red-haired librarian holding a closed book, three-quarter view, waist-up. Semi-painterly anime illustration. Retain delicate clean linework around the eyes, face and silhouette, with understated interior lines. Model the hair and fabric using two or three broad value groups and subtle painterly transitions. Soft matte skin, selective brush texture, crisp focal details and restrained highlights. Muted plum and warm ivory colors, plain warm paper background.",
      "negative": "photograph, 3d render, heavy impasto, oily highlights, excessive airbrush, uniform hard outlines, text, watermark",
      "pitfall": "单写 semi-realistic 会把脸推向写实，未必得到半厚涂；要描述“线稿与色块如何分工”。",
      "citation": "S6 / S10 / S11"
    },
    {
      "name": "清新简约",
      "tag": "少色 / 留白 / 清晰形状",
      "desc": "清新不等于曝光拉满，简约也不是删掉所有层次。限制调色板、形状数量和视觉重心，通常比“minimalist masterpiece”更可控。",
      "features": [
        "三到四色：鼠尾草绿、奶油色、浅珊瑚等",
        "扁平或轻水粉色块，少量纸感",
        "主次形状清楚，保留大面积呼吸空间"
      ],
      "prompt": "A small reading corner with a librarian and one potted plant. Fresh minimalist editorial illustration. Simple rounded shapes, a limited palette of sage green, warm cream and soft coral, flat matte gouache-like color blocks with very subtle paper texture. Gentle daylight expressed with one simple shadow shape, abundant negative space, a slightly off-center balanced composition, calm everyday mood.",
      "negative": "3d render, neon colors, dramatic rim light, glossy reflections, clutter, dense texture, text, watermark",
      "pitfall": "flat、gouache、paper cut 可以择一主导；把 3D、油画厚肌理和扁平矢量同时堆上去，容易丢失清爽感。",
      "citation": "S10 / S11"
    }
  ],
