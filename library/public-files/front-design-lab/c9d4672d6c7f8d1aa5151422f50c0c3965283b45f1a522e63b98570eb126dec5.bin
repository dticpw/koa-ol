<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>front-design lab</title><style>/* muQ theme contract v1: semantic roles shared by catalogue, reader, reports. */
:root{--paper:#f5f1eb;--white:#fffdf9;--ink:#302936;--muted:#716772;--plum:#665173;--night:#292332;--gold:#dfcba2;--line:#dfd7dc;--muq-reading-width:78ch;--muq-radius:8px;--muq-space:24px;--muq-body-font:"Noto Sans CJK SC","Microsoft YaHei",system-ui,sans-serif;--muq-heading-font:"Noto Serif CJK SC","Songti SC",serif}

.topic-page{max-width:1040px;margin:auto}.topic-page .reader-title{font-family:var(--muq-heading-font);font-size:clamp(30px,4vw,48px);margin:0 0 22px}.topic-page .eyebrow{margin:6px 0 16px}.topic-summary{font-size:19px;line-height:1.95;max-width:49em;margin:0 0 32px}.topic-figure{margin:0 0 48px}.topic-figure img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:6px;background:var(--paper)}.topic-figure figcaption{font-size:13px;color:var(--muted);line-height:1.8;margin-top:12px}.topic-section{border-top:1px solid var(--line);padding-top:30px;margin-top:44px;scroll-margin-top:30px}.topic-section h2{font-size:27px;margin:0 0 18px}.topic-section>p,.topic-items p{font-size:16px;line-height:1.95;margin:12px 0;overflow-wrap:anywhere}.topic-section>.reader-meta{font-size:13px}.topic-actions{display:flex;flex-wrap:wrap;gap:10px 14px;margin:22px 0}.topic-actions a{border:1px solid var(--plum);padding:11px 18px;text-decoration:none;border-radius:4px;font-size:15px;background:var(--white)}.topic-actions a:first-child{background:var(--plum);color:var(--white)}.topic-toc{display:flex;flex-wrap:wrap;gap:12px 22px;background:var(--white);border:1px solid var(--line);padding:22px;margin:30px 0}.topic-toc>span{width:100%;font-size:12px;color:var(--muted)}.topic-toc a{font-size:14px;color:var(--plum);text-decoration:underline;text-underline-offset:4px}.topic-items{list-style:none;margin:0;padding:0}.topic-items li{padding:18px 0;border-bottom:1px solid var(--line)}.topic-items strong{font-size:19px;font-weight:600}.topic-items .related-link{display:inline-block;font-size:14px}.topic-rows{border:1px solid var(--line);border-radius:8px;background:var(--white);overflow:hidden}.topic-rows>.related-link,.topic-file{padding:13px 18px;border-bottom:1px solid var(--line);margin:0}.topic-rows>:last-child{border-bottom:0}.topic-rows .related-link{font-size:15px;text-decoration:none;line-height:1.75}.topic-file{display:flex;align-items:center;justify-content:space-between;gap:18px}.topic-file .related-link{padding:0;min-width:0;overflow-wrap:anywhere}.topic-file small{flex:none}.topic-prompt-group{margin:25px 0}.topic-prompt-group>summary{font-size:17px;line-height:1.8;cursor:pointer}.topic-rows a:hover{text-decoration:underline}.topic-page:focus-visible,.topic-page a:focus-visible{outline:3px solid var(--plum);outline-offset:4px}@media(max-width:600px){.topic-summary{font-size:17px;line-height:1.95}.topic-section{margin-top:32px;padding-top:24px}.topic-section h2{font-size:23px}.topic-section>p,.topic-items p{font-size:15px}.topic-figure{margin-bottom:32px}.topic-actions a{font-size:14px;padding:10px 13px}.topic-file{align-items:flex-start;gap:10px}.topic-file small{font-size:10px}.topic-toc{gap:13px 18px;padding:18px}.topic-rows>.related-link,.topic-file{padding:12px 14px}}

/* Reading layout uses the library palette; enabled per topic. */
.topic-reading{--chapter-ink:var(--plum);--chapter-paper:#ece7ee;max-width:1120px}
.topic-reading-layout{display:grid;grid-template-columns:205px minmax(0,1fr);gap:42px;align-items:start;margin-top:40px}
.topic-reading-aside{position:sticky;top:25px;border-top:2px solid var(--chapter-ink);padding-top:16px}
.topic-reading-aside summary{font-size:13px;cursor:pointer;color:var(--muted)}
.topic-reading .topic-toc{display:flex;flex-direction:column;gap:0;border:0;background:none;padding:0;margin:12px 0}
.topic-reading .topic-toc a{font-size:13px;line-height:1.75;padding:10px 0;border-bottom:1px solid var(--line);text-decoration:none}
.topic-reading .topic-toc a[aria-current]{font-weight:700;color:var(--chapter-ink);border-bottom-color:var(--chapter-ink)}
.topic-reading-prose{min-width:0}.topic-reading-prose>.topic-section{padding:0;border:0;margin:0 0 64px;scroll-margin-top:30px}
.topic-chapter-head{display:flex;align-items:center;gap:22px;padding:24px;background:var(--chapter-paper);border-top:3px solid var(--chapter-ink);border-bottom:1px solid var(--line);margin-bottom:28px}
.topic-chapter-number{font:34px/1 Georgia,serif;color:var(--chapter-ink);padding-right:18px;border-right:1px solid var(--line);flex-shrink:0}
.topic-reading .topic-chapter-head h2{font:700 32px/1.5 var(--muq-heading-font);margin:0;color:var(--chapter-ink);overflow-wrap:anywhere;min-width:0}
.topic-reading .topic-rows>.related-link{display:block}.topic-reading .topic-file{position:relative}.topic-reading .topic-file a::after{content:'';position:absolute;inset:0}.topic-reading .topic-rows> :hover{background:var(--chapter-paper)}
.topic-reading #topic-status{border-left:4px solid var(--chapter-ink);border-top:0;background:var(--white);padding:24px 28px}
@media(max-width:900px){.topic-reading-layout{grid-template-columns:170px minmax(0,1fr);gap:25px}.topic-reading .topic-chapter-head h2{font-size:28px}.topic-chapter-head{padding:20px;gap:16px}}
@media(max-width:700px){.topic-reading-layout{display:block}.topic-reading-aside{position:static;margin-bottom:30px}.topic-reading .topic-toc{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.topic-chapter-head{padding:18px 14px;gap:14px}.topic-reading .topic-chapter-head h2{font-size:24px}.topic-chapter-number{font-size:28px;padding-right:12px}.topic-reading-prose>.topic-section{margin-bottom:48px}.topic-reading #topic-status{padding:20px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--muq-body-font)}main{padding:44px 24px}a{color:var(--plum)}.reader-meta{color:var(--muted);font-size:13px}</style><main class="topic-page topic-reading"><p class="eyebrow">muQ / 持续维护的主题</p><h1 class="reader-title">front-design lab</h1><p class="topic-summary">从实际前端设计中提炼创意、动效与素材协作方法，最终形成 Open Design 单一入口、阅读交付与表现设计两模式。</p><section class="topic-section" id="topic-status"><h2>当前状态与操作入口</h2><p>Open Design 已形成统一入口、阅读交付与表现设计两种模式。当前源码已在本机落盘，仍有未提交修改；持续用真实任务验证模式选择、创意质量与素材协作。</p><p class="reader-meta">2026-09-12 核对共享 Skill 源码；历史合并验收记录保留。</p><nav class="topic-actions"><a class="related-link" target="_blank" rel="noopener" href="https://github.com/dticpw/agentflow/tree/main/skills/open-design-ui">Open Design 私有源码仓库</a></nav></section><div class="topic-reading-layout"><aside class="topic-reading-aside"><details open><summary>本页目录</summary><nav class="topic-toc" aria-label="主题目录"><a href="#topic-decision">当前方案</a><a href="#topic-ideas">设计联想与取舍</a><a href="#topic-methods">吸收的方法</a><a href="#topic-assets">素材制作与职责</a><a href="#topic-references">骰子夜参考观察</a><a href="#topic-evolution">演变与验证</a><a href="#topic-archive-scope">维护边界与来源</a><a href="#topic-webpages">网页</a><a href="#topic-files">文件</a><a href="#topic-history">历史与来源</a></nav></details></aside><div class="topic-reading-prose"><section class="topic-section" id="topic-decision"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">01</span><h2>当前方案</h2></header><ul class="topic-items"><li><strong>统一入口</strong><p>Open Design 是唯一前端设计入口，原 frontend-design-lab 已吸收并撤下。前端设计实验仍以本主题追踪，但它不再是独立 Skill。</p></li><li><strong>阅读交付</strong><p>用于 muQ 条目、报告和说明。优先内容完整、成熟模板、图文层级与长时间阅读，不是低质量档位。</p></li><li><strong>表现设计</strong><p>用于个人主页、品牌页和重点展示。主动构思对象、素材和交互，按需要制作动态小样，不强制生图或三维。</p></li><li><strong>选择方式</strong><p>未指定时按用途自动判断，用户指定优先；允许整页阅读交付、局部演示采用表现设计。</p></li></ul></section><section class="topic-section" id="topic-ideas"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">02</span><h2>设计联想与取舍</h2></header><ul class="topic-items"><li><strong>从场景里找对象，从对象里找动作，从动作里找交互</strong><p>先判断对象应该怎样动，再选实现技术。用户可以只给感受与约束，由 Agent 主动提出少量有区别的方向。</p></li><li><strong>创意必须经过筛选</strong><p>判断主题关联、信息或情绪价值、重复使用舒适度和实现成本。静态构图足够时就停在那里，不把所有联想堆进页面。</p></li><li><strong>让页面直接表达用途</strong><p>通过真实入口、主视觉与背景表达含义，减少无信息量的欢迎语。必要的说明与无障碍标签保留。</p></li></ul></section><section class="topic-section" id="topic-methods"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">03</span><h2>吸收的方法</h2></header><ul class="topic-items"><li><strong>参考拆解</strong><p>观察入场、稳定、滚动、悬停与点击，结合实际代码区分观察事实和实现推断。</p></li><li><strong>共享页面氛围</strong><p>当前阅读区控制整页底色，文字、按钮、装饰与模型背景一起协调；整页渐变和从一点向外扩散是不同机制。</p></li><li><strong>动效编排</strong><p>写清对象、触发、起点、变化、稳定状态和中断。入场与浮动分层，手动操作从当前状态接管，动画能离屏暂停并正常恢复。</p></li><li><strong>角色与媒介</strong><p>按内容选择 DOM、SVG、视频或三维；角色按动作需要分层，保持原稿一致、关节不露缝、响应式装配不散架。</p></li><li><strong>内部参考</strong><p>保留跨页连续性、阅读排版、共享氛围、动效、角色管线与来源，按任务读取，而不是每次加载全部技术细节。</p></li></ul></section><section class="topic-section" id="topic-assets"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">04</span><h2>素材制作与职责</h2></header><ul class="topic-items"><li><strong>前端负责素材简报</strong><p>确定用途、位置、尺寸、构图、色调、留白、透明背景与分层要求。</p></li><li><strong>MA3 负责派工</strong><p>遵循 ma3-control 核对真实可用执行器与回执；执行 Agent 模型和实际生图模型分别确认。</p></li><li><strong>生图与三维各有入口</strong><p>imgen-art-director / imagegen 负责素材生成和检查，threejs-diorama 负责模型；muq-journal 负责归档与可见范围。</p></li><li><strong>回到页面验收</strong><p>收到素材后在真实布局、展示尺寸和深浅底色中检查，不能把出图等同于接入完成。</p></li></ul></section><section class="topic-section" id="topic-references"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">05</span><h2>骰子夜参考观察</h2></header><ul class="topic-items"><li><strong>对象与动作呼应</strong><p>实际试过贴纸拖抛、掷骰子和规则筛选；贴纸松手后继续运动，骰子给出结果，筛选改变列表。</p></li><li><strong>不同对象采用不同表现</strong><p>贴纸落入，涂鸦沿路径画出，骰子旋转后停稳。按路径长度分配描线时间，保持相对连贯的笔触速度。</p></li><li><strong>借鉴边界</strong><p>页面明确是虚构产品，营销指标与评价不作事实使用；首屏贴纸循环缺少离屏停止，不能整份代码照搬。</p></li></ul></section><section class="topic-section" id="topic-evolution"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">06</span><h2>演变与验证</h2></header><ul class="topic-items"><li><strong>先分工，后合并</strong><p>最初将两个 Skill 分成全站交付与专项动效；用户随后认为单入口更易使用，最终采用 Open Design 内部双模式。</p></li><li><strong>已完成检查</strong><p>格式、相对引用、UI 元数据、LF 和发现路径通过；四份全局引用经过独立审查与落盘复核。当前客户端列表已显示新版 Open Design，旧入口不再出现。</p></li><li><strong>后续验证</strong><p>继续在实际归档和页面设计任务中观察自动选模式与创意质量。本主题保存方法与 Skill 成果，主页建设仍是独立主题。</p></li></ul></section><section class="topic-section" id="topic-archive-scope"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">07</span><h2>维护边界与来源</h2></header><p>本主题持续整理前端设计 Skill 的方法、决策与成果；个人主页建造是独立主题。主页动效只作为方法形成的案例，不将其项目进度并入这里。</p><p>原话来自同一真实会话，按完整日志快照保留 ID、时间、内容块与顺序。因此原话区包含主页等跨主题消息，正文仅提取前端设计 Skill 相关结论。历史日记保持原版本，本主题保存此次采集快照，不创建第二场会话身份。</p><p>当前源码以共享 Skill 目录为准，私有仓库承接长期版本管理。2026-09-11 ZIP 仅代表合并时的历史快照，不代表最新源码或已推送状态。</p><ul class="topic-items"></ul></section><section class="topic-section" id="topic-webpages"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">08</span><h2>网页</h2></header><div class="topic-rows"><a class="related-link" target="_blank" rel="noopener" href="https://kb.hth-ai.com/e/frontend-lab/dice-night/index.html">骰子夜 · 动态交互参考</a><a class="related-link" target="_blank" rel="noopener" href="https://github.com/nexu-io/open-design/tree/main/skills/frontend-design">Open Design 上游工作流</a></div></section><section class="topic-section" id="topic-files"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">09</span><h2>文件</h2></header><div class="topic-rows"><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=front-design-lab&amp;file=artifacts%2Fopen-design-reading-guide-20260912.md">Open Design · 使用与维护指南</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=front-design-lab&amp;file=artifacts%2Fmerge-20260911-review-before.md">Skill 合并 · 写入前独立审查</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=front-design-lab&amp;file=artifacts%2Fmerge-20260911-review-after.md">Skill 合并 · 落盘后独立复核</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=front-design-lab&amp;file=artifacts%2Fmerge-20260911-verification.json">Skill 合并 · 验证记录</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=front-design-lab&amp;file=artifacts%2Fopen-design-ui-20260911.zip">历史 · 2026-09-11 Skill 源码与审查快照</a><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=front-design-lab&amp;file=artifacts%2Ffront-design-lab.html">历史 · 首次归档阅读页</a></div></section><section class="topic-section" id="topic-history"><header class="topic-chapter-head"><span class="topic-chapter-number" aria-hidden="true">10</span><h2>历史与来源</h2></header><div class="topic-rows"><a class="related-link" target="_blank" rel="noopener" href="https://koa-ol.com/library/entry.html?id=codex-7868c500a1d7ef0ddd541fa5">最初讨论所在的混合会话 · 历史归档</a></div><p>来源原话在图书馆馆主视角默认展开；本 HTML 阅读副本不复制原始提示词。</p></section></div></div></main><script>const links=[...document.querySelectorAll('.topic-toc a')],sections=links.map(a=>document.querySelector(a.getAttribute('href')));function update(){let n=0;sections.forEach((s,i)=>{if(s.getBoundingClientRect().top<innerHeight*.35)n=i});if(innerHeight+scrollY>=document.documentElement.scrollHeight-4)n=sections.length-1;links.forEach((a,i)=>i===n?a.setAttribute('aria-current','location'):a.removeAttribute('aria-current'))}addEventListener('scroll',update,{passive:true});addEventListener('resize',update);update();</script></html>